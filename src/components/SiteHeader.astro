---
import Mark from './Mark.astro';
const path = Astro.url.pathname;
const featuresPath = '/features/';
const pricingPath = '/pricing/';
const contactPath = '/contact/';
const blogPath = '/blog/';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="RestaBee home"><img src="/images/restabee-mark.webp" width="36" height="36" alt=""/><span>restabee<span class="brand-period">.</span></span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>POS overview</a>
      <a href={featuresPath} aria-current={path === featuresPath ? 'page' : undefined}>Features</a>
      <a href={pricingPath} aria-current={path === pricingPath ? 'page' : undefined}>Pricing</a>
      <a href={contactPath} aria-current={path === contactPath ? 'page' : undefined}>Contact</a>
      <a href={blogPath} aria-current={path.startsWith(blogPath) ? 'page' : undefined}>Blog</a>
    </nav>
    <div class="header-actions"><a class="login" href="https://app.restabee.com">Log in</a><a class="button button-dark header-demo" href="/#demo">Book a demo <Mark /></a></div>
    <details class="mobile-menu">
      <summary aria-label="Navigation menu"><Mark name="menu" /></summary>
      <nav aria-label="Mobile navigation">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>POS overview</a>
        <a href={featuresPath} aria-current={path === featuresPath ? 'page' : undefined}>Features</a>
        <a href={pricingPath} aria-current={path === pricingPath ? 'page' : undefined}>Pricing</a>
        <a href={contactPath} aria-current={path === contactPath ? 'page' : undefined}>Contact</a>
        <a href={blogPath} aria-current={path.startsWith(blogPath) ? 'page' : undefined}>Blog</a>
        <a href="/#demo">Book a demo</a>
        <a href="https://app.restabee.com">Log in</a>
      </nav>
    </details>
  </div>
</header>
