ght reveal"><div class="contact-form"><div class="form-title">Book your demo</div><p class="form-sub">Tell us your restaurant name, city and outlet count.</p><a class="btn-primary" href="mailto:hello@restabee.com?subject=RestaBee%20demo%20request">Email to book a demo</a><p class="restored-contact-link"><a href="tel:+919044415050">Call +91 90444 15050</a></p><p class="form-sub">hello@restabee.com</p></div></div></div></div></section><!-- ── FAQ ── -->
