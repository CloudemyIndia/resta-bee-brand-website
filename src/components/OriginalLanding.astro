<script>
  const toggle = document.querySelector<HTMLButtonElement>('#navToggle');
  const navigation = document.querySelector<HTMLElement>('#navbar');
  const closeMenu = () => {
    navigation?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
  };
  toggle?.addEventListener('click', () => {
    const open = navigation?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll<HTMLAnchorElement>('#navLinks a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle.focus();
    }
  });
</script>
