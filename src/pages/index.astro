---
import SiteLayout from '../layouts/SiteLayout.astro';
import Mark from '../components/Mark.astro';
const workflow = [
  {name:'Take the order', label:'Order captured', heading:'“Less spicy.” Keep that detail.', copy:'Choose the items, add extras and note what the guest asked for. Save the order before sending it to the kitchen.', ticket:'Order details', state:'Captured', note:'Less spicy · extra chutney', foot:'Ready to send to the kitchen', status:'Order captured. Kitchen preparation has not started.'},
  {name:'Send to kitchen', label:'Kitchen preparation', heading:'The right note. The right station.', copy:'Send items to their preparation stations. The kitchen sees the item choices and instructions together on its ticket.', ticket:'Kitchen ticket', state:'Preparing', note:'Less spicy · extra chutney', foot:'Hot kitchen · preparation in progress', status:'Kitchen ticket sent. Items are preparing.'},
  {name:'Serve the table', label:'Ready for service', heading:'Know what is ready to go.', copy:'Track full or partial quantities as the kitchen marks them ready. Coordinate pickup and serving with the floor team.', ticket:'Service pickup', state:'Ready', note:'Less spicy · extra chutney', foot:'Ready for pickup · serving is a separate step', status:'Items are ready for pickup. They are not yet marked served.'},
  {name:'Close the bill', label:'Recorded collection', heading:'Keep the payment details, too.', copy:'Preview the bill, arrange eligible draft checks and record cash, UPI or card collections. Split payments have their own record.', ticket:'Collection record', state:'Recorded', note:'Cash ₹300 · UPI ₹540', foot:'₹840 recorded · balance ₹0', status:'Collection recorded. Payment recording does not verify bank settlement.'},
];
const faqs = [
  ['Is RestaBee suitable for my restaurant?', 'RestaBee covers staff-entered dine-in, takeaway and delivery orders, kitchen tickets and billing. A demo is the place to check your table setup, service types and intended devices against the way your team works.'],
  ['Can guests split a bill or pay in different ways?', 'Yes. Eligible unissued items can be arranged into separate draft bills. You can also record several payment methods against one bill. Splitting a bill and splitting a payment are separate actions.'],
  ['Can I manage menus across several outlets?', 'Prepare a central menu, review and publish changes, then apply the publication to selected outlets. Outlets can also keep independent menus. Team access is scoped to the outlets they handle.'],
  ['Does it support GST billing and UPI?', 'You can configure tax profiles, preview bill tax lines and record UPI, cash or card collections. Payment recording does not automatically verify bank settlement. GST filing and payment-gateway integrations are outside this offer.'],
  ['What about devices, printers and delivery platforms?', 'Confirm your devices and bill or kitchen-ticket printers during the demo. Printing needs compatible hardware and local setup. Delivery orders are entered by staff; automatic delivery-platform imports are not included.'],
  ['What is included in the subscription?', 'Every subscription includes released standard POS features. The displayed price is the complete payable subscription amount, with no GST added separately. Hardware, third-party services and custom work are quoted separately. Planned modules are not yet released.'],
];
const plans = [{months:3,price:'2,499'},{months:6,price:'4,299'},{months:12,price:'6,999'}];
---
<SiteLayout title="Restaurant POS Software India | Billing & KOT | RestaBee" description="Restaurant POS made for the rush. Manage orders, kitchen tickets, tables, billing and outlet menus with RestaBee. See pricing and book a demo.">
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="RestaBee home"><img src="/images/restabee-mark.webp" width="36" height="36" alt="" /><span>restabee<span class="brand-period">.</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation"><a href="#product">Why RestaBee</a><a href="#workflow">How it works</a><a href="#outlets">Multi-outlet</a><a href="#pricing">Pricing</a></nav>
      <div class="header-actions"><a class="login" href="https://app.restabee.com">Log in</a><a class="button button-dark header-demo" href="#demo">Book a demo <Mark /></a></div>
      <details class="mobile-menu"><summary aria-label="Open navigation"><Mark name="menu" /></summary><nav aria-label="Mobile navigation"><a href="#product">Why RestaBee</a><a href="#workflow">How it works</a><a href="#outlets">Multi-outlet</a><a href="#pricing">Pricing</a><a href="https://app.restabee.com">Log in</a><a href="#demo">Book a demo</a></nav></details>
    </div>
  </header>
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-intro">
        <h1 id="hero-title">Restaurant POS.<br/> <span>Made for the rush.</span></h1>
        <div class="hero-pitch"><p>Take orders, send kitchen tickets and settle bills in one workspace. Give your team more room to serve.</p><div class="hero-actions"><a class="button button-orange" href="#demo">Book a demo <Mark /></a><a class="text-link" href="#workflow">See it in action <Mark name="down" /></a></div></div>
      </div>
      <div class="service-stage" id="workflow" aria-label="Explore a sample restaurant order">
        <figure class="kitchen-photo">
          <img src="/images/kitchen-1440.webp" srcset="/images/kitchen-640.webp 640w, /images/kitchen-768.webp 768w, /images/kitchen-960.webp 960w, /images/kitchen-1440.webp 1440w" sizes="(max-width: 700px) calc(100vw - 40px), (min-width: 1440px) 763px, 54vw" width="1440" height="960" alt="A chef finishes a plate of paneer tikka at a restaurant kitchen pass. Illustrative scene." fetchpriority="high" />
          <div class="photo-caption"><span class="photo-caption-line"></span><p>A small detail.<br/> A better handoff.</p><span class="photo-credit">Illustrative restaurant scene</span></div>
          <div class="photo-order"><span class="pulse-dot"></span>Table 08 <span>·</span> Paneer tikka</div>
        </figure>
        <div class="ticket-stage" data-stage="0">
          <div class="ticket-stage-top"><span>Follow one order</span><span class="sample-label">Interactive example</span></div>
          <div class="order-ticket">
            <div class="ticket-brand"><img src="/images/restabee-mark.webp" alt="" width="24" height="24"/><span>RestaBee</span><span class="ticket-kind" data-ticket-kind>{workflow[0].ticket}</span></div>
            <div class="ticket-table"><div><span>Dine-in</span><strong>Table 08</strong></div><span class="ticket-status" data-ticket-status>{workflow[0].state}</span></div>
            <div class="ticket-items"><div><span>2 × Paneer tikka</span><b>₹560</b></div><div><span>1 × Veg biryani</span><b>₹240</b></div></div>
            <div class="ticket-note"><span data-note-label>Kitchen instruction</span><strong data-ticket-note>{workflow[0].note}</strong></div>
            <dl class="ticket-amount"><div><dt>Items</dt><dd>₹800</dd></div><div><dt>Sample tax · 5%</dt><dd>₹40</dd></div><div class="ticket-total"><dt>Bill total</dt><dd>₹840</dd></div></dl>
            <div class="ticket-foot"><Mark name="check" /><span data-ticket-foot>{workflow[0].foot}</span></div>
          </div>
          <p class="ticket-disclaimer">Illustrative workflow and sample values.<br/> Tax depends on your configured profile.</p>
        </div>
        <div class="workflow-controls" role="group" aria-label="Order workflow stages">{workflow.map((step,i)=><button type="button" data-step={i} aria-pressed={i===0} aria-controls="workflow-story"><span class="step-index">0{i+1}</span><span>{step.name}</span><Mark /></button>)}</div>
      </div>
      <div class="workflow-story" id="workflow-story" aria-live="polite" aria-atomic="true"><p class="workflow-label" data-workflow-label>{workflow[0].label}</p><h2 data-workflow-title>{workflow[0].heading}</h2><p data-workflow-copy>{workflow[0].copy}</p><span class="sr-only" data-readout>{workflow[0].status}</span></div>
      <noscript><ol class="static-workflow">{workflow.map(step=><li><strong>{step.name}.</strong> {step.copy}</li>)}</ol></noscript>
    </section>

    <section class="service-fit container" aria-label="Service types"><p>For the way<br/> <strong>you serve.</strong></p><ul><li>Dine-in restaurants</li><li>Cafés & counters</li><li>Takeaway</li><li>Staff-entered delivery</li></ul></section>

    <section class="operations" id="product" aria-labelledby="product-title">
      <div class="container">
        <div class="operations-intro"><h2 id="product-title">The floor is busy.<br/> <span>The details stay clear.</span></h2><p>A table move, an extra topping, a bill split three ways. RestaBee keeps the work organised through the parts of service that need attention.</p></div>
        <div class="operations-grid">
          <article class="floor-feature">
            <div class="feature-copy"><h3>Know where every<br/> table stands.</h3><p>See occupied tables, seat waiting parties and assign service staff. Keep table moves and bill requests with the party.</p></div>
            <figure class="floor-illustration" aria-label="Illustrative table plan"><div class="floor-top"><span>Main dining</span><span>Sample floor</span></div><div class="floor-tables"><div class="dining-table"><span>02</span><small>Available</small></div><div class="dining-table seated"><span>04</span><small>Seated</small></div><div class="dining-table service"><span>08</span><small>In service</small></div><div class="dining-table"><span>10</span><small>Available</small></div><div class="dining-table bill"><span>12</span><small>Bill requested</small></div><div class="dining-table seated"><span>14</span><small>Seated</small></div></div><figcaption>Illustrative table states</figcaption></figure>
          </article>
          <article class="kitchen-feature"><div class="feature-copy"><h3>Instructions that<br/> reach the kitchen.</h3><p>Send each item to its preparation station. Track quantities as they move from preparing to ready for pickup.</p></div><div class="kitchen-slip" aria-label="Sample kitchen instruction"><div><span>HOT KITCHEN</span><b>08</b></div><p>2 × Paneer tikka</p><strong>Less spicy.<br/> Extra chutney.</strong><div class="slip-bottom"><span>Table 08</span><span>Preparing</span></div></div><p class="example-caption">Illustrative kitchen ticket</p></article>
          <article class="billing-feature"><div class="feature-copy"><h3>Split the bill.<br/> Keep the record straight.</h3><p>Arrange eligible draft checks before issuing a bill. Record cash, UPI and card collections, including mixed payments.</p><a class="text-link light-link" href="#demo">Book a demo <Mark /></a></div><div class="collection-example"><div class="collection-heading"><span>Sample collection</span><span>Table 08</span></div><div class="collection-total"><span>Bill total</span><strong>₹840<span>.00</span></strong></div><div class="collection-method"><span>Cash recorded</span><b>₹300</b><Mark name="check" /></div><div class="collection-method"><span>UPI recorded</span><b>₹540</b><Mark name="check" /></div><div class="collection-balance"><span>Balance</span><b>₹0</b></div><p>Payment recording does not verify bank settlement.</p></div></article>
        </div>
        <div class="owner-tools"><h3>And when service<br/> winds down.</h3><div><h4>Cash shifts & dues</h4><p>Review opening cash, drawer movements, closing counts and customer balances.</p></div><div><h4>Reports & team access</h4><p>Review sales and collections by permitted outlet and date. Give each person access to their work.</p></div></div>
      </div>
    </section>

    <section class="outlets container" id="outlets" aria-labelledby="outlets-title">
      <div class="outlets-copy"><h2 id="outlets-title">Your next outlet.<br/> <span>Your menu, ready.</span></h2><p>Build changes in one place. Review and publish them, then choose which outlets receive the update.</p><p>Keep a menu independent when an outlet needs its own way of doing things.</p><a class="text-link" href="#demo">Book a demo <Mark /></a></div>
      <figure class="publication-demo"><div class="publication-sheet"><div class="publication-title"><img src="/images/restabee-mark.webp" alt="" width="28" height="28"/><strong>Central menu</strong><span>Publication</span></div><div class="menu-change"><span>Paneer tikka</span><strong>₹280</strong><small>Price reviewed</small></div><ol class="publish-steps"><li><Mark name="check"/>Prepare</li><li><Mark name="check"/>Review</li><li><Mark name="check"/>Publish</li></ol></div><div class="publication-connector" aria-hidden="true"></div><div class="outlet-list"><div><span class="outlet-letter">M</span><p><b>Market Road</b><small>Selected for update</small></p><Mark name="check" /></div><div><span class="outlet-letter">L</span><p><b>Lake View</b><small>Selected for update</small></p><Mark name="check" /></div><div class="independent"><span class="outlet-letter">S</span><p><b>Station Café</b><small>Independent menu</small></p><span>Local</span></div></div><figcaption>Illustrative publication and sample outlets</figcaption></figure>
    </section>

    <section class="pricing-section" id="pricing" aria-labelledby="pricing-title"><div class="container">
      <div class="pricing-heading"><h2 id="pricing-title">Full POS access.<br/> Straightforward pricing.</h2><p>Released standard POS features in every subscription.<br/> Choose how long you need them.</p></div>
      <div class="pricing-layout">
        <article class="single-plan"><div class="plan-heading"><h3>One outlet</h3><span>Your restaurant, covered.</span></div><div class="term-switch" role="group" aria-label="Single outlet subscription term">{plans.map(plan=><button type="button" data-term={plan.months} aria-pressed={plan.months===12} aria-controls="single-price">{plan.months} months</button>)}</div><div class="price" id="single-price" aria-live="polite" aria-atomic="true"><strong data-price>₹6,999</strong><span>total for <span data-period>12 months</span></span></div><ul class="plan-includes"><li><Mark name="check"/>Orders, KOT & table service</li><li><Mark name="check"/>Billing, collections & cash shifts</li><li><Mark name="check"/>Menu management, reports & team access</li></ul><a class="button button-dark" href="#demo" data-plan-link="Single outlet, 12 months, ₹6,999">Book a demo <Mark /></a><noscript><p class="static-prices">3 months: ₹2,499 · 6 months: ₹4,299 · 12 months: ₹6,999</p></noscript></article>
        <article class="multi-plan"><div class="plan-heading"><h3>More than one</h3><span>Room for your next location.</span></div><div class="multi-price"><strong>₹5,999</strong><span>per outlet / year</span></div><p class="multi-plan-copy">All released standard POS features, with central menu publication and outlet-scoped access.</p><div class="multi-example"><span>Two outlets, one year</span><strong>₹11,998</strong></div><p class="minimum-term">Annual billing. Minimum two outlets.</p><a class="button button-outline" href="#demo" data-plan-link="Multi-outlet, annual, ₹5,999 per outlet">Book a demo <Mark /></a></article>
      </div>
      <p class="pricing-note">Prices are complete payable subscription amounts, with no GST added separately. Hardware, third-party services and custom work are quoted separately. Planned modules are not yet released.</p>
    </div></section>

    <section class="demo-check container" aria-labelledby="demo-check-title"><figure><img src="/images/cafe-960.webp" srcset="/images/cafe-640.webp 640w, /images/cafe-960.webp 960w" sizes="(max-width: 700px) 100vw, 44vw" width="960" height="640" loading="lazy" decoding="async" alt="A café owner places a coffee on a table. Illustrative restaurant scene."/><figcaption>Illustrative restaurant scene</figcaption></figure><div><h2 id="demo-check-title">Make the demo<br/> about your restaurant.</h2><p>You know where service gets complicated. Bring those moments to the conversation.</p><ul class="demo-agenda"><li><div><h3>Walk through an order</h3><p>Item choices, kitchen instructions and the bill.</p></div></li><li><div><h3>Check your setup</h3><p>Tables, stations, intended devices and printers.</p></div></li><li><div><h3>Understand the subscription</h3><p>Your outlet count, term and anything quoted separately.</p></div></li></ul><a class="text-link" href="#demo">Book a demo <Mark /></a></div></section>

    <section class="faq container" aria-labelledby="faq-title"><div class="faq-intro"><h2 id="faq-title">Before you<br/> make the call.</h2><a class="text-link" href="tel:+919044415050">Talk to us <Mark name="phone" /></a></div><div class="questions">{faqs.map(([q,a])=><details><summary>{q}<Mark name="plus" /></summary><p>{a}</p></details>)}</div></section>

    <section class="demo-section" id="demo" aria-labelledby="demo-title"><div class="container demo-layout"><div class="demo-copy"><h2 id="demo-title">Your restaurant<br/> has a rhythm.<br/> <span>Let's find the fit.</span></h2><p>Tell us a little about your place. We can start with the parts of service that matter to you.</p><div class="contact-links"><a href="tel:+919044415050"><Mark name="phone"/>+91 90444 15050</a><a href="mailto:hello@restabee.com"><Mark name="mail"/>hello@restabee.com</a></div></div>
      <div class="enquiry-panel"><h3>Book a demo</h3><p class="form-intro">A few details to start the conversation.</p><form id="demo-form"><div class="form-field"><label for="restaurant">Restaurant name</label><input id="restaurant" name="restaurant" autocomplete="organization" maxlength="100" placeholder="Your restaurant or café" required /></div><div class="form-row"><div class="form-field"><label for="contact">Your email</label><input id="contact" name="contact" type="email" autocomplete="email" maxlength="160" placeholder="you@example.com" required /></div><div class="form-field"><label for="outlet-count">Outlets</label><select id="outlet-count" name="outlets"><option value="1">1 outlet</option><option value="2 to 5">2 to 5 outlets</option><option value="6+">6 or more outlets</option><option value="Opening soon">Opening soon</option></select></div></div><div class="form-field"><label for="demo-interest">What would you like to see? <span>Optional</span></label><textarea id="demo-interest" name="interest" maxlength="600" rows="2" placeholder="Kitchen tickets, split bills, managing menus…"></textarea></div><button class="button button-orange form-submit" type="submit">Prepare demo request <Mark /></button><p class="form-help" id="form-help">Creates an email draft for you to review and send.</p></form><noscript><p class="no-script-contact">Email <a href="mailto:hello@restabee.com?subject=RestaBee%20demo%20request">hello@restabee.com</a> with your restaurant name and outlet count to arrange a demo.</p></noscript><div class="draft-result" id="draft-result" hidden aria-live="polite"><h4>Your request is ready to send.</h4><p>Choose “Open email draft” and send it from your email app. Your enquiry has not been sent yet.</p><a class="button button-dark" id="send-draft" href="mailto:hello@restabee.com">Open email draft <Mark /></a><button class="copy-request" id="copy-request" type="button">Copy request instead</button><p class="copy-status" id="copy-status" role="status"></p><textarea id="draft-text" class="draft-text" readonly aria-label="Your demo request" hidden></textarea></div></div>
    </div></section>
  </main>
  <footer class="site-footer"><div class="container"><div class="footer-top"><a class="brand" href="/" aria-label="RestaBee home"><img src="/images/restabee-mark.webp" alt="" width="32" height="32" loading="lazy"/><span>restabee<span class="brand-period">.</span></span></a><p>For the people behind every order.</p><a class="text-link" href="#main">Back to top <span class="up-arrow"><Mark /></span></a></div><div class="footer-wordmark" aria-hidden="true">restabee<span>.</span></div><div class="footer-bottom"><span>© {new Date().getFullYear()} RestaBee</span><nav aria-label="Footer navigation"><a href="#product">Product</a><a href="#pricing">Pricing</a><a href="#demo">Contact</a><a href="https://app.restabee.com">Open POS app</a></nav><span>Restaurant POS software, India</span></div></div></footer>
  <script type="application/json" id="workflow-data" set:html={JSON.stringify(workflow)} />
  <script>
    type Step = {label:string;heading:string;copy:string;ticket:string;state:string;note:string;foot:string;status:string};
    const steps:Step[]=JSON.parse(document.querySelector('#workflow-data')?.textContent || '[]');
    const stageButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const setText=(selector:string,value:string)=>{const element=document.querySelector(selector);if(element)element.textContent=value;};
    const selectStage=(index:number)=>{
      const step=steps[index];if(!step)return;
      stageButtons.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===index)));
      const stage=document.querySelector<HTMLElement>('.ticket-stage');if(stage)stage.dataset.stage=String(index);
      const updates:Record<string,string>={'[data-workflow-label]':step.label,'[data-workflow-title]':step.heading,'[data-workflow-copy]':step.copy,'[data-ticket-kind]':step.ticket,'[data-ticket-status]':step.state,'[data-ticket-note]':step.note,'[data-ticket-foot]':step.foot,'[data-readout]':step.status,'[data-note-label]':index===3?'Recorded payment methods':'Kitchen instruction'};
      Object.entries(updates).forEach(([selector,value])=>setText(selector,value));
    };
    function buttonGroup(buttons:HTMLButtonElement[],change:(index:number)=>void){buttons.forEach((button,index)=>{button.addEventListener('click',()=>change(index));button.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight'||event.key==='ArrowDown')next=(index+1)%buttons.length;else if(event.key==='ArrowLeft'||event.key==='ArrowUp')next=(index-1+buttons.length)%buttons.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=buttons.length-1;else return;event.preventDefault();change(next);buttons[next]?.focus();});});}
    buttonGroup(stageButtons,selectStage);
    const terms=[...document.querySelectorAll<HTMLButtonElement>('[data-term]')];
    const priceByTerm:Record<string,string>={'3':'2,499','6':'4,299','12':'6,999'};
    buttonGroup(terms,index=>{const months=terms[index].dataset.term!;terms.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===index)));setText('[data-price]',`₹${priceByTerm[months]}`);setText('[data-period]',`${months} months`);const link=document.querySelector<HTMLElement>('.single-plan [data-plan-link]');if(link)link.dataset.planLink=`Single outlet, ${months} months, ₹${priceByTerm[months]}`;});
    let selectedPlan='Not selected';
    document.querySelectorAll<HTMLAnchorElement>('[data-plan-link]').forEach(link=>link.addEventListener('click',()=>{selectedPlan=link.dataset.planLink||'Not selected';const outlets=document.querySelector<HTMLSelectElement>('#outlet-count');if(outlets)outlets.value=selectedPlan.startsWith('Multi')?'2 to 5':'1';const previousDraft=document.querySelector<HTMLElement>('#draft-result');if(previousDraft)previousDraft.hidden=true;}));
    const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus();}});
    let draft='';
    const form=document.querySelector<HTMLFormElement>('#demo-form');
    const result=document.querySelector<HTMLElement>('#draft-result');
    form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const restaurant=String(data.get('restaurant')||'').trim();const email=String(data.get('contact')||'').trim();if(!restaurant){const input=form.querySelector<HTMLInputElement>('#restaurant');input?.setCustomValidity('Enter your restaurant name.');input?.reportValidity();return;}
      draft=`Hello RestaBee,\n\nI'd like to arrange a demo.\n\nRestaurant: ${restaurant}\nEmail: ${email}\nOutlets: ${data.get('outlets')}\nSubscription of interest: ${selectedPlan}\nI'd like to see: ${String(data.get('interest')||'').trim()||'The order-to-bill workflow'}\n\nPlease contact me to arrange a suitable time.`;
      const send=document.querySelector<HTMLAnchorElement>('#send-draft');if(send)send.href=`mailto:hello@restabee.com?subject=${encodeURIComponent(`RestaBee demo: ${restaurant}`)}&body=${encodeURIComponent(draft)}`;
      const text=document.querySelector<HTMLTextAreaElement>('#draft-text');if(text){text.value=draft;text.hidden=true;}setText('#copy-status','');if(result)result.hidden=false;send?.focus();
    });
    form?.addEventListener('input',()=>{form.querySelector<HTMLInputElement>('#restaurant')?.setCustomValidity('');if(result)result.hidden=true;});
    form?.addEventListener('change',()=>{if(result)result.hidden=true;});
    document.querySelector('#copy-request')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(draft);setText('#copy-status','Copied. Paste the request into an email to hello@restabee.com.');}catch{const text=document.querySelector<HTMLTextAreaElement>('#draft-text');if(text){text.hidden=false;text.focus();text.select();}setText('#copy-status','Select and copy the request below, then email hello@restabee.com.');}});
  </script>
</SiteLayout>
