  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': 'https://restabee.com/#organization',
        name: 'RestaBee',
        url: 'https://restabee.com/',
        logo: { '@type': 'ImageObject', url: 'https://restabee.com/images/restabee-mark.webp' },
      },
      {
        '@type': 'WebSite',
        '@id': 'https://restabee.com/#website',
        name: 'RestaBee',
        url: 'https://restabee.com/',
        publisher: { '@id': 'https://restabee.com/#organization' },
        inLanguage: 'en-IN',
      },
      {
        '@type': 'WebPage',
        '@id': 'https://restabee.com/#webpage',
        url: 'https://restabee.com/',
        name: pageTitle,
        description: pageDescription,
        isPartOf: { '@id': 'https://restabee.com/#website' },
        about: { '@id': 'https://restabee.com/#organization' },
        inLanguage: 'en-IN',
      },
    ],
  })}></script>
  <script>
    const setText=(selector:string,value:string)=>{const element=document.querySelector(selector);if(element)element.textContent=value;};
    function buttonGroup(buttons:HTMLButtonElement[],change:(index:number)=>void){buttons.forEach((button,index)=>{button.addEventListener('click',()=>change(index));button.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight'||event.key==='ArrowDown')next=(index+1)%buttons.length;else if(event.key==='ArrowLeft'||event.key==='ArrowUp')next=(index-1+buttons.length)%buttons.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=buttons.length-1;else return;event.preventDefault();change(next);buttons[next]?.focus();});});}
    const terms=[...document.querySelectorAll<HTMLButtonElement>('[data-term]')];
    const priceByTerm:Record<string,string>={'3':'2,499','6':'4,299','12':'6,999'};
    const equivalentByTerm:Record<string,string>={'3':'₹833','6':'₹717','12':'₹583'};
    buttonGroup(terms,index=>{const months=terms[index].dataset.term!;terms.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===index)));setText('[data-price]',`₹${priceByTerm[months]}`);setText('[data-total-period]',`total payable for ${months} months`);setText('[data-monthly-equivalent]',`${equivalentByTerm[months]} per month equivalent`);const link=document.querySelector<HTMLElement>('.single-plan [data-plan-link]');if(link)link.dataset.planLink=`Single outlet, ${months} months, ₹${priceByTerm[months]}`;});
    document.querySelectorAll<HTMLAnchorElement>('[data-plan-link]').forEach(link=>link.addEventListener('click',()=>{const outlets=document.querySelector<HTMLSelectElement>('#outlet-count');if(outlets)outlets.value=(link.dataset.planLink||'').startsWith('Multi')?'2 to 5':'1';const result=document.querySelector<HTMLElement>('#lead-result');if(result)result.hidden=true;}));
    const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus();}});
    const form=document.querySelector<HTMLFormElement>('#demo-form');
    const result=document.querySelector<HTMLElement>('#lead-result');
    const formMessage=(title:string,message:string,canEmail=false)=>{setText('#lead-result-title',title);setText('#lead-result-message',message);const fallback=document.querySelector<HTMLAnchorElement>('#lead-email-fallback');if(fallback)fallback.hidden=!canEmail;if(result)result.hidden=false;result?.focus();};
    form?.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity()||form.dataset.submitting==='true')return;const data=new FormData(form);const payload={name:String(data.get('name')||'').trim(),restaurant:String(data.get('restaurant')||'').trim(),city:String(data.get('city')||'').trim(),phone:String(data.get('phone')||'').trim(),email:String(data.get('email')||'').trim(),outlets:String(data.get('outlets')||''),interest:String(data.get('interest')||'').trim()};const button=form.querySelector<HTMLButtonElement>('.form-submit');const label=button?.querySelector('span');form.dataset.submitting='true';form.setAttribute('aria-busy','true');if(button){button.disabled=true;if(label)label.textContent='Sending…';}if(result)result.hidden=true;
      const controller=new AbortController();const timeout=window.setTimeout(()=>controller.abort(),15000);
      try{const response=await fetch(`${form.dataset.apiBase}/api/public/leads`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload),signal:controller.signal});const body=await response.json() as {success?:boolean;message?:string;reason?:string;errors?:Record<string,string|string[]>};if(body.success===true){formMessage('Request sent',body.message||'Thank you. Our team will contact you to arrange a demo.');form.reset();}else if(body.reason==='INVALID_REQUEST'){let firstInvalid:HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement|null=null;for(const[field,raw]of Object.entries(body.errors||{})){const control=form.elements.namedItem(field);const message=Array.isArray(raw)?raw.join(' '):raw;if(typeof message==='string'&&(control instanceof HTMLInputElement||control instanceof HTMLSelectElement||control instanceof HTMLTextAreaElement)){control.setCustomValidity(message);firstInvalid??=control;}}formMessage('Check your details',body.message||'Please review the highlighted fields and try again.');if(firstInvalid){firstInvalid.focus();form.reportValidity();}}else{const message=body.reason==='LIMIT_EXCEEDED'?body.message||'Too many demo requests. Please try again later.':body.reason==='WORKFLOW_NOT_READY'?body.message||'Demo requests are temporarily unavailable. Please contact us by email.':body.message||'We could not send your request just now. Please try again or contact us by email.';formMessage('Request not sent',message,true);}
      }catch{formMessage('Request not sent','We could not connect to RestaBee. Please try again or contact us by email.',true);}finally{window.clearTimeout(timeout);delete form.dataset.submitting;form.removeAttribute('aria-busy');if(button){button.disabled=false;if(label)label.textContent='Send demo request';}}
    });
    const clearFieldError=(event:Event)=>{const target=event.target;if(target instanceof HTMLInputElement||target instanceof HTMLSelectElement||target instanceof HTMLTextAreaElement)target.setCustomValidity('');if(result)result.hidden=true;};
    form?.addEventListener('input',clearFieldError);
    form?.addEventListener('change',clearFieldError);
  </script>
</SiteLayout>
