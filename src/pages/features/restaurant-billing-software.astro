---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Mark from '../../components/Mark.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getEntry } from 'astro:content';
const pageEntry = await getEntry('pages', 'restaurant-billing-software');
if (!pageEntry) throw new Error('CMS content entry "restaurant-billing-software" is missing.');
const { seo, copy, billingLists, faqs: questions } = pageEntry.data;
const imageAlt = pageEntry.data.imageAlt!;
const title = seo.title;
const description = seo.description;
const headingParts = (value: string) => value.split('|');
const schema = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: title,
  url: seo.canonical,
  description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Android, iOS, macOS, Windows' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
    { '@type': 'ListItem', position: 2, name: 'Restaurant billing software', item: seo.canonical },
  ] },
};
---
<SiteLayout title={title} description={description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="billing-page">
    <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.heroKicker}</span></nav>
    <section class="billing-hero container" aria-labelledby="billing-title">
      <div class="billing-hero-copy"><p class="billing-kicker"><span></span>{copy.heroKicker}</p><h1 id="billing-title">{headingParts(copy.heroTitle)[0]} <em>{headingParts(copy.heroTitle)[1]}</em></h1><p class="billing-lede">{copy.heroDescription}</p><div class="billing-actions"><a class="button button-orange" href="/#demo">{copy.heroCta} <Mark /></a><a class="text-link" href="/#pricing">{copy.pricingCta} <Mark name="down" /></a></div><p class="billing-proofline">Dine-in · Takeaway · Staff-entered delivery</p></div>
      <figure class="bill-preview" aria-labelledby="bill-caption">
        <figcaption id="bill-caption"><span>Bill preview</span><span>Sample bill</span></figcaption>
        <div class="bill-paper"><div class="bill-brand"><img src="/images/restabee-mark.webp" width="24" height="24" alt=""/><strong>RestaBee</strong><span>Table T3</span></div><div class="bill-rule"></div><div class="bill-meta"><span>Order summary</span><span>Sample restaurant data</span></div><div class="bill-row"><span>2 × Paneer Tikka <small>₹200 each</small></span><b>₹400</b></div><div class="bill-row"><span>1 × Veg Biryani</span><b>₹240</b></div><div class="bill-rule dashed"></div><div class="bill-total-row"><span>Subtotal</span><b>₹640</b></div><div class="bill-total-row"><span>Tax from configured profile</span><b>₹32</b></div><div class="bill-rule"></div><div class="bill-grand"><span>Total due</span><strong>₹672</strong></div><p class="bill-caption">Sample amounts. Tax follows the restaurant’s configured profile.</p></div>
        <div class="bill-preview-foot"><span class="bill-status-dot"></span>Review the bill before recording collection</div>
      </figure>
    </section>

    <section class="billing-flow" aria-labelledby="billing-flow-title"><div class="container"><div class="billing-section-heading"><p class="billing-kicker">The billing workflow</p><h2 id="billing-flow-title">{headingParts(copy.workflowTitle)[0]}<br/><em>{headingParts(copy.workflowTitle)[1]}</em></h2><p>{copy.workflowDescription}</p></div><div class="billing-steps">{billingLists?.steps.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}</div></div></section>

    <section class="billing-order-section container" aria-labelledby="billing-order-title">
      <div class="billing-order-copy"><p class="billing-kicker">The order before the bill</p><h2 id="billing-order-title">{headingParts(copy.orderTitle)[0]} <em>{headingParts(copy.orderTitle)[1]}</em></h2><p>{copy.orderDescription}</p><a class="text-link" href="/">{copy.orderCta} <Mark /></a></div>
      <figure class="billing-order-screen"><figcaption><span>{copy.screenshotLabel}</span><span>{copy.screenshotDataLabel}</span></figcaption><div class="billing-screen-frame"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-mobile.webp" width="800" height="1656"/><source media="(max-width: 1100px)" srcset="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656"/><img src="/pos-images/restabee-restaurant-pos-menu-desktop.webp" width="2910" height="1656" alt={imageAlt.orderEntry} loading="lazy" decoding="async"/></picture></div><p class="billing-screen-caption">{copy.screenCaption}</p></figure>
    </section>

    <section class="billing-services" aria-labelledby="billing-services-title"><div class="container"><div class="billing-section-heading"><p class="billing-kicker">One POS billing workflow</p><h2 id="billing-services-title">{headingParts(copy.servicesTitle)[0]}<br/><em>{headingParts(copy.servicesTitle)[1]}</em></h2><p>{copy.servicesDescription}</p></div><div class="billing-service-grid">{billingLists?.serviceTypes.map((item) => <article><span>{item.number}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></section>

    <section class="billing-detail container" aria-labelledby="billing-detail-title"><div class="billing-detail-head"><p class="billing-kicker">Restaurant bill management</p><h2 id="billing-detail-title">{headingParts(copy.detailTitle)[0]}<br/><em>{headingParts(copy.detailTitle)[1]}</em></h2></div><div class="billing-detail-grid">{billingLists?.details.map((item) => <article><span class="detail-index">{item.letter}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div></section>

    <section class="billing-corrections" aria-labelledby="billing-corrections-title"><div class="container billing-corrections-layout"><div><p class="billing-kicker">After the bill is issued</p><h2 id="billing-corrections-title">{headingParts(copy.correctionTitle)[0]}<br/><em>{headingParts(copy.correctionTitle)[1]}</em></h2></div><div><p>{copy.correctionDescription}</p><a class="text-link" href="/#demo">{copy.reviewLink} <Mark /></a></div></div></section>

    <section class="billing-boundary"><div class="container boundary-inner"><div><p class="billing-kicker">Billing scope</p><h2>{headingParts(copy.billingScopeTitle)[0]}<br/><em>{headingParts(copy.billingScopeTitle)[1]}</em></h2></div><div><p>{copy.billingScopeDescription}</p><p>{copy.printerNote}</p><a class="text-link" href="/#pricing">{copy.pricingLink} <Mark /></a></div></div></section>

    <section class="billing-faq container" aria-labelledby="billing-faq-title"><div class="billing-faq-intro"><p class="billing-kicker">Questions about restaurant billing</p><h2 id="billing-faq-title">{headingParts(copy.faqTitle)[0]}<br/><em>{headingParts(copy.faqTitle)[1]}</em></h2></div><div class="billing-faq-list">{questions.map(({question, answer})=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>

    <section class="billing-cta"><div class="container billing-cta-inner"><div><p class="billing-kicker">RestaBee restaurant POS</p><h2>{headingParts(copy.ctaTitle)[0]}<br/><em>{headingParts(copy.ctaTitle)[1]}</em></h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta} <Mark /></a></div></section>
  </main>
  <SiteFooter />
</SiteLayout>
<style>
  .billing-page{overflow:hidden}.billing-hero{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center;padding-block:88px 92px}.billing-kicker{display:flex;align-items:center;gap:10px;color:var(--orange-ink);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.billing-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}.billing-hero h1{font-size:clamp(55px,6.1vw,82px);max-width:690px;margin-top:24px}.billing-hero h1 em,.billing-section-heading h2 em,.billing-detail-head h2 em,.boundary-inner h2 em,.billing-faq h2 em,.billing-cta h2 em{font-style:normal;color:var(--orange-ink)}.billing-lede{font-size:18px;line-height:1.75;color:#51564c;max-width:540px;margin-top:25px}.billing-actions{display:flex;align-items:center;gap:25px;flex-wrap:wrap;margin-top:30px}.billing-actions .button{gap:28px}.billing-proofline{font-size:12px;color:var(--muted);margin-top:29px}.bill-preview{background:#e8e5d9;border:1px solid #d8d8cc;border-radius:16px;padding:23px 28px 19px;box-shadow:0 22px 48px -38px #2d332b80}.bill-preview figcaption{display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:11px;margin-bottom:15px}.bill-preview figcaption span:first-child{font-weight:700;color:var(--ink)}.bill-paper{max-width:470px;margin-inline:auto;background:#fffefa;padding:25px 30px 20px;box-shadow:0 12px 25px -20px #302c2180}.bill-brand{display:flex;align-items:center;gap:9px;font-size:15px}.bill-brand>span{margin-left:auto;font-size:12px;color:#68715d}.bill-rule{height:1px;background:#d9d9ce;margin-block:17px}.bill-rule.dashed{background:repeating-linear-gradient(to right,#b7b9ac 0 4px,transparent 4px 8px)}.bill-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:11px;margin-bottom:11px}.bill-row,.bill-total-row{display:flex;justify-content:space-between;align-items:baseline;gap:15px;font-size:13px;padding-block:7px}.bill-row small{display:block;color:var(--muted);font-size:11px}.bill-row b,.bill-total-row b{font-variant-numeric:tabular-nums}.bill-total-row{font-size:12px}.bill-grand{display:flex;align-items:baseline;justify-content:space-between}.bill-grand span{font-size:14px;font-weight:600}.bill-grand strong{font:600 32px/1 var(--display);letter-spacing:-.04em}.bill-caption{font-size:10px;line-height:1.5;color:var(--muted);margin-top:18px}.bill-preview-foot{display:flex;align-items:center;gap:8px;font-size:11px;color:#525a4b;margin-top:16px}.bill-status-dot{width:7px;height:7px;border-radius:50%;background:#397344}.billing-flow{background:#252b24;color:#f6f5ef;padding-block:90px 98px}.billing-section-heading{display:grid;grid-template-columns:.85fr 1fr;column-gap:80px;align-items:end}.billing-section-heading .billing-kicker{grid-column:1/-1;color:#f5a06a;margin-bottom:27px}.billing-section-heading h2{font-size:clamp(40px,5vw,65px)}.billing-section-heading h2 em{color:#ff9d60}.billing-section-heading>p:last-child{max-width:390px;color:#c8cdbf;font-size:15px;line-height:1.8}.billing-steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:62px;border-top:1px solid #61665a}.billing-steps article{padding:23px 24px 0 0;margin-right:24px;border-right:1px solid #61665a}.billing-steps article:last-child{border:0;margin:0}.billing-steps article>span{font-size:11px;color:#f5a06a}.billing-steps h3{font-size:22px;margin-top:30px}.billing-steps p{font-size:13px;line-height:1.75;color:#c8cdbf;margin-top:11px;max-width:245px}.billing-detail{padding-block:100px}.billing-detail-head{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:30px}.billing-detail-head .billing-kicker{grid-column:1/-1}.billing-detail-head h2{font-size:clamp(40px,5vw,64px)}.billing-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 50px;margin-top:51px}.billing-detail-grid article{display:grid;grid-template-columns:42px 1fr;gap:20px;padding:25px 0;border-top:1px solid var(--line)}.detail-index{color:var(--orange-ink);font-size:12px;font-weight:700}.billing-detail-grid h3{font-size:22px}.billing-detail-grid p{color:var(--muted);font-size:14px;line-height:1.8;margin-top:10px;max-width:460px}.billing-boundary{background:#e7ebdf;padding-block:77px}.boundary-inner{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}.boundary-inner .billing-kicker{margin-bottom:22px}.boundary-inner h2{font-size:clamp(40px,5vw,61px)}.boundary-inner>div:last-child>p{font-size:14px;line-height:1.85;color:#4e5649;margin-bottom:15px}.boundary-inner .text-link{margin-top:8px}.billing-faq{display:grid;grid-template-columns:.75fr 1.25fr;gap:80px;padding-block:96px}.billing-faq h2{font-size:clamp(40px,5vw,60px);margin-top:22px}.billing-faq-list details{border-top:1px solid var(--line)}.billing-faq-list details:last-child{border-bottom:1px solid var(--line)}.billing-faq-list summary{display:flex;align-items:center;justify-content:space-between;gap:25px;min-height:68px;list-style:none;cursor:pointer;font-size:15px;font-weight:600}.billing-faq-list summary::-webkit-details-marker{display:none}.billing-faq-list summary span{font-size:24px;font-weight:400;color:var(--orange-ink);transition:transform .2s}.billing-faq-list details[open] summary span{transform:rotate(45deg)}.billing-faq-list details p{font-size:13px;line-height:1.8;color:var(--muted);padding:0 45px 20px 0}.billing-cta{background:#f4cda9;padding-block:67px}.billing-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:30px}.billing-cta h2{font-size:clamp(40px,4.6vw,59px);margin-top:17px}.billing-cta>div>div>p:last-child{max-width:490px;font-size:14px;color:#5d4c3d;margin-top:16px}.billing-cta .button{flex-shrink:0}
  @media(max-width:950px){.billing-hero{gap:36px;padding-block:65px}.billing-section-heading{column-gap:38px}.billing-faq{gap:40px}.billing-steps article{padding-right:16px;margin-right:16px}}
  @media(max-width:700px){.billing-hero{grid-template-columns:1fr;gap:38px;padding-block:53px 65px}.billing-hero h1{font-size:clamp(48px,12vw,68px)}.billing-lede{font-size:16px}.bill-preview{padding:19px 16px 16px}.bill-paper{padding:22px 20px 18px}.billing-flow{padding-block:66px}.billing-section-heading{grid-template-columns:1fr;gap:0}.billing-section-heading .billing-kicker{margin-bottom:20px}.billing-section-heading h2{font-size:clamp(39px,10vw,53px)}.billing-section-heading>p:last-child{margin-top:15px}.billing-steps{grid-template-columns:1fr 1fr;row-gap:27px;margin-top:41px}.billing-steps article{min-height:170px}.billing-steps article:nth-child(2){border-right:0}.billing-steps h3{font-size:19px;margin-top:22px}.billing-detail{padding-block:68px}.billing-detail-head{grid-template-columns:1fr;gap:18px}.billing-detail-head h2{font-size:clamp(39px,10vw,53px)}.billing-detail-grid{grid-template-columns:1fr;gap:0;margin-top:34px}.billing-detail-grid article{gap:14px;padding-block:21px}.billing-detail-grid h3{font-size:20px}.billing-boundary{padding-block:58px}.boundary-inner{grid-template-columns:1fr;gap:22px}.boundary-inner h2{font-size:clamp(39px,10vw,52px)}.billing-faq{grid-template-columns:1fr;gap:28px;padding-block:68px}.billing-faq h2{font-size:clamp(39px,10vw,52px);margin-top:15px}.billing-faq-list summary{min-height:66px;font-size:14px}.billing-cta{padding-block:53px}.billing-cta-inner{align-items:flex-start;flex-direction:column}.billing-cta h2{font-size:clamp(39px,10vw,52px)}}
  @media(prefers-reduced-motion:reduce){.billing-faq-list summary span{transition:none}}
</style>
<style>
  .breadcrumbs{display:flex;align-items:center;gap:10px;padding-top:21px;font-size:12px;color:var(--muted)}.breadcrumbs a{text-decoration:underline;text-underline-offset:3px}.breadcrumbs [aria-current=page]{color:var(--ink)}
  .billing-order-section{display:grid;grid-template-columns:.84fr 1.16fr;gap:64px;align-items:center;padding-block:94px}.billing-order-copy h2{font-size:clamp(39px,4.4vw,58px);margin-top:19px}.billing-order-copy h2 em{font-style:normal;color:var(--orange-ink)}.billing-order-copy>p:not(.billing-kicker){font-size:14px;color:var(--muted);line-height:1.85;margin-top:19px;max-width:500px}.billing-order-copy .text-link{margin-top:18px}.billing-order-screen{min-width:0;background:#e9e5d9;border:1px solid #d9d7ca;border-radius:15px;padding:17px 18px 15px}.billing-order-screen figcaption{display:flex;justify-content:space-between;gap:15px;margin:0 0 12px;font-size:10px;color:var(--muted)}.billing-order-screen figcaption span:first-child{font-weight:700;color:var(--ink)}.billing-screen-frame{overflow:hidden;border:8px solid #252a24;border-radius:13px;background:#252a24;box-shadow:0 17px 28px -22px #272c2480}.billing-screen-frame picture,.billing-screen-frame img{display:block;width:100%;height:auto}.billing-screen-frame img{border-radius:4px}.billing-screen-caption{font-size:10px;color:var(--muted);margin-top:10px}
  .billing-services{background:#f7f6f1;color:var(--ink);padding-block:88px}.billing-services .billing-section-heading{grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);column-gap:clamp(32px,5vw,68px);margin-bottom:40px}.billing-services .billing-section-heading .billing-kicker{color:var(--orange-ink)}.billing-services .billing-section-heading h2 em{color:var(--orange-ink)}.billing-services .billing-section-heading>p:last-child{max-width:420px;color:#4f554c;font-size:16px;line-height:1.8;justify-self:end}.billing-service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.billing-service-grid article{min-height:205px;background:#fff;border:1px solid #dedfd5;border-radius:12px;padding:24px 25px}.billing-service-grid article>span{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--orange-ink);font-weight:700}.billing-service-grid h3{font-size:22px;margin-top:29px}.billing-service-grid p{font-size:13px;line-height:1.75;color:#555b52;margin-top:11px}
  .billing-boundary .billing-kicker{color:#a23d12}.billing-cta .billing-kicker{color:#783516}.billing-corrections{background:#252b24;color:#f6f5ef;padding-block:76px}.billing-corrections-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px}.billing-corrections .billing-kicker{color:#f5a06a;margin-bottom:20px}.billing-corrections h2{font-size:clamp(40px,5vw,61px)}.billing-corrections h2 em{font-style:normal;color:#ff9d60}.billing-corrections-layout>div:last-child>p{font-size:14px;color:#c8cdbf;line-height:1.85;margin-bottom:16px}.billing-corrections .text-link{color:#fff}
  @media(max-width:950px){.billing-order-section{grid-template-columns:1fr;gap:33px;padding-block:68px}.billing-order-copy{max-width:700px}.billing-corrections-layout{gap:40px}.billing-services .billing-section-heading{grid-template-columns:minmax(0,1fr) minmax(250px,.8fr);column-gap:32px}.billing-service-grid{gap:12px}.billing-service-grid article{padding:20px}}
  @media(max-width:700px){.breadcrumbs{padding-top:16px;font-size:11px}.billing-order-section{gap:24px;padding-block:59px}.billing-order-copy h2{font-size:clamp(37px,9.5vw,48px)}.billing-order-copy>p:not(.billing-kicker){font-size:13px}.billing-order-screen{padding:13px 12px 12px;border-radius:12px}.billing-order-screen figcaption{font-size:9px;gap:8px}.billing-screen-frame{border-width:6px;border-radius:10px}.billing-screen-caption{font-size:9px}.billing-services{padding-block:63px}.billing-services .billing-section-heading{grid-template-columns:1fr;gap:0;margin-bottom:27px}.billing-services .billing-section-heading>p:last-child{justify-self:start;max-width:540px;margin-top:16px;font-size:15px}.billing-service-grid{grid-template-columns:1fr;gap:11px}.billing-service-grid article{min-height:0;padding:20px 21px}.billing-service-grid h3{font-size:20px;margin-top:16px}.billing-service-grid p{font-size:13px;margin-top:8px}.billing-corrections{padding-block:58px}.billing-corrections-layout{grid-template-columns:1fr;gap:20px}.billing-corrections h2{font-size:clamp(39px,10vw,52px)}.billing-corrections-layout>div:last-child>p{font-size:13px}}
</style>
