---
import { getEntry } from 'astro:content';
import Mark from '../../components/Mark.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const pageEntry = await getEntry('pages', 'kitchen-display-system');
if (!pageEntry) throw new Error('CMS content entry "kitchen-display-system" is missing.');
const { seo, copy, kitchenLists, faqs, imageAlt } = pageEntry.data;
if (!kitchenLists) throw new Error('Kitchen display page content is incomplete.');
if (!imageAlt?.kitchenQueue) throw new Error('Kitchen display page screenshot alt text is missing.');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Android, iOS, macOS, Windows' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
    { '@type': 'ListItem', position: 2, name: 'Kitchen display system', item: seo.canonical },
  ] },
};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="kds-page">
    <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>

    <section class="kds-hero container" aria-labelledby="kds-title">
      <div class="kds-hero-copy">
        <p class="kds-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="kds-title">{copy.heroTitle}</h1>
        <p class="kds-lede">{copy.heroDescription}</p>
        <div class="kds-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#workflow">{copy.workflowCta}<Mark name="down" /></a></div>
      </div>
      <figure class="kds-screen">
        <figcaption><span>{copy.screenLabel}</span><span>{copy.screenDataLabel}</span></figcaption>
        <div class="kds-device-shell"><div class="kds-bezel"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-kitchen-display-mobile.webp" width="800" height="1656"/><img src="/pos-images/restabee-restaurant-pos-kitchen-display-desktop.webp" width="2488" height="1656" alt={imageAlt.kitchenQueue} loading="eager" decoding="async" fetchpriority="high"/></picture></div><div class="kds-monitor-stand" aria-hidden="true"><span></span></div></div>
      </figure>
    </section>

    <section class="kds-workflow" id="workflow" aria-labelledby="workflow-title">
      <div class="container">
        <header class="kds-section-heading"><p class="kds-kicker">{copy.workflowKicker}</p><h2 id="workflow-title">{copy.workflowTitle}</h2><p>{copy.workflowDescription}</p></header>
        <ol class="kds-workflow-grid">{kitchenLists.workflowSteps.map((step) => <li><span class="kds-step-number">{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
      </div>
    </section>

    <section class="kds-stations container" aria-labelledby="station-title">
      <div class="kds-station-copy"><p class="kds-kicker">{copy.stationKicker}</p><h2 id="station-title">{copy.stationTitle}</h2><p>{copy.stationDescription}</p><h3>{copy.ticketDetailsTitle}</h3><p>{copy.ticketDetailsDescription}</p></div>
      <ul class="kds-ticket-details" aria-label={copy.ticketDetailsAriaLabel}>{kitchenLists.ticketDetails.map((detail) => <li><Mark name="check"/><div><h3>{detail.title}</h3><p>{detail.description}</p></div></li>)}</ul>
    </section>

    <section class="kds-states" aria-labelledby="stages-title">
      <div class="container kds-states-layout">
        <div><p class="kds-kicker">{copy.quantityKicker}</p><h2 id="stages-title">{copy.quantityTitle}</h2><p>{copy.quantityDescription}</p><a class="text-link" href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a></div>
        <ol class="kds-state-list" aria-label={copy.stagesAriaLabel}>{kitchenLists.stages.map((stage, index) => <li class={`kds-state-card kds-state-card-${index + 1}`}><span class="kds-state-number">0{index + 1}</span><div><h3>{stage.title}</h3><p>{stage.description}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="kds-changes container" aria-labelledby="changes-title">
      <div class="kds-change-intro"><p class="kds-kicker">{copy.changesKicker}</p><h2 id="changes-title">{copy.changesTitle}</h2><p>{copy.changesDescription}</p></div>
      <ol class="kds-change-list">{kitchenLists.changeDetails.map((item) => <li><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>)}</ol>
    </section>

    <section class="kds-print" aria-labelledby="print-title"><div class="container kds-print-inner"><div><p class="kds-kicker">{copy.printKicker}</p><h2 id="print-title">{copy.printTitle}</h2></div><div><p>{copy.printDescription}</p><div class="kds-print-links"><a class="text-link" href="/features/kot-management/">{copy.kotLinkLabel}<Mark /></a><a class="text-link" href="/pricing/">{copy.pricingLinkLabel}<Mark /></a><a class="text-link" href="/blog/what-is-kot-in-restaurant/">{copy.kotGuideLinkLabel}<Mark /></a></div></div></div></section>

    <section class="kds-faq container" aria-labelledby="faq-title">
      <div class="kds-faq-intro"><p class="kds-kicker">{copy.faqKicker}</p><h2 id="faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div>
      <div class="kds-faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="kds-cta"><div class="container kds-cta-inner"><div><p class="kds-kicker">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a></div></section>
  </main>
  <SiteFooter />
</SiteLayout>
<style>
  .kds-page{overflow:hidden}.breadcrumbs{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.breadcrumbs a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.breadcrumbs [aria-current=page]{color:var(--ink)}
  .kds-kicker{display:flex;align-items:center;gap:10px;color:var(--orange-ink);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.kds-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}
  .kds-hero{display:grid;grid-template-columns:minmax(330px,.78fr) minmax(0,1.22fr);gap:clamp(36px,6vw,84px);align-items:center;padding-block:70px 88px}.kds-hero h1{max-width:620px;font-size:clamp(50px,5.6vw,76px);line-height:1.03;letter-spacing:-.045em;margin-top:21px}.kds-lede{max-width:570px;margin-top:22px;color:#51574e;font-size:17px;line-height:1.75}.kds-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:28px}.kds-actions .button{gap:22px}.kds-screen{min-width:0;background:#f1eee5;border:1px solid #dedacd;border-radius:16px;padding:17px 18px 12px;box-shadow:0 22px 46px -36px #252a2480}.kds-screen figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 12px;color:#4f554c;font-size:11px}.kds-screen figcaption span:first-child{font-weight:700;color:var(--ink)}.kds-device-shell{padding-bottom:0}.kds-bezel{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.kds-bezel picture,.kds-bezel img{display:block;width:100%;height:auto}.kds-bezel img{border-radius:4px}.kds-monitor-stand{width:28%;height:24px;margin:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}.kds-monitor-stand span{display:block;width:170%;height:5px;margin:18px 0 0 -35%;background:#7c8076;border-radius:5px}
  .kds-workflow{background:#252b24;color:#f6f5ef;padding-block:82px 88px}.kds-workflow .kds-kicker,.kds-states .kds-kicker,.kds-print .kds-kicker{color:#ffb17d}.kds-section-heading{max-width:750px}.kds-section-heading h2,.kds-station-copy h2,.kds-states h2,.kds-change-intro h2,.kds-print h2,.kds-faq h2,.kds-cta h2{font-size:clamp(39px,4.8vw,62px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.kds-section-heading>p:last-child{max-width:690px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:16px}.kds-workflow-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;list-style:none;margin-top:42px;border-top:1px solid #60665b}.kds-workflow-grid li{min-height:195px;padding:23px 24px 0 0;border-right:1px solid #60665b}.kds-workflow-grid li+li{padding-left:23px}.kds-workflow-grid li:last-child{border-right:0}.kds-step-number,.kds-state-number{font-size:11px;color:#ffb17d;font-weight:700}.kds-workflow-grid h3{font-size:21px;margin-top:30px}.kds-workflow-grid p{max-width:255px;margin-top:10px;font-size:13px;line-height:1.7;color:#d0d4ca}
  .kds-states .kds-kicker{color:#a43e15}
  .kds-stations{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(38px,7vw,96px);padding-block:92px;align-items:center}.kds-station-copy h2{max-width:560px}.kds-station-copy>p:not(.kds-kicker){max-width:570px;color:#51574e;font-size:15px;line-height:1.8;margin-top:18px}.kds-station-copy h3{font-size:22px;margin-top:29px}.kds-ticket-details{list-style:none;border-top:1px solid var(--line)}.kds-ticket-details li{display:grid;grid-template-columns:20px 1fr;gap:14px;padding:19px 0;border-bottom:1px solid var(--line)}.kds-ticket-details li>svg{width:17px;height:17px;color:#287441;margin-top:3px}.kds-ticket-details h3{font-size:18px}.kds-ticket-details p{font-size:13px;line-height:1.7;color:#51574e;margin-top:5px}
  .kds-states{background:#e8ecdf;padding-block:84px}.kds-states-layout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(42px,7vw,100px);align-items:center}.kds-states h2{max-width:560px}.kds-states-layout>div>p:not(.kds-kicker){max-width:520px;margin-top:18px;color:#42493f;font-size:15px;line-height:1.8}.kds-states .text-link{display:inline-flex;margin-top:20px}.kds-state-list{list-style:none;border-top:1px solid #c8cebd}.kds-state-card{display:grid;grid-template-columns:40px 1fr;gap:12px;padding:21px 0;border-bottom:1px solid #c8cebd}.kds-state-card h3{font-size:21px}.kds-state-card p{color:#454c42;font-size:13px;line-height:1.7;margin-top:5px}.kds-state-card-1 .kds-state-number{color:#344ca7}.kds-state-card-2 .kds-state-number{color:#8a4b00}.kds-state-card-3 .kds-state-number{color:#176b3b}
  .kds-changes{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:clamp(40px,7vw,98px);padding-block:91px}.kds-change-intro h2{max-width:560px}.kds-change-intro>p:last-child{max-width:560px;color:#51574e;font-size:15px;line-height:1.8;margin-top:19px}.kds-change-list{list-style:none;border-top:1px solid var(--line)}.kds-change-list li{display:grid;grid-template-columns:34px 1fr;gap:14px;padding:21px 0;border-bottom:1px solid var(--line)}.kds-change-list li>span{font-size:11px;color:var(--orange-ink);font-weight:700}.kds-change-list h3{font-size:20px}.kds-change-list p{font-size:13px;color:#51574e;line-height:1.75;margin-top:7px}
  .kds-print{background:#252b24;color:#f6f5ef;padding-block:72px}.kds-print-inner{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(40px,7vw,90px);align-items:center}.kds-print h2{max-width:580px}.kds-print-inner>div:last-child>p{font-size:15px;line-height:1.8;color:#d0d4ca}.kds-print-links{display:flex;flex-wrap:wrap;gap:4px 20px;margin-top:14px}.kds-print .text-link{display:inline-flex;color:#fff;margin-top:0}
  .kds-faq{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:clamp(36px,7vw,90px);padding-block:88px}.kds-faq-intro h2{max-width:390px}.kds-faq-intro>p:last-child{font-size:14px;line-height:1.7;color:#51574e;margin-top:16px}.kds-faq-list details{border-top:1px solid var(--line)}.kds-faq-list details:last-child{border-bottom:1px solid var(--line)}.kds-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:66px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.kds-faq-list summary::-webkit-details-marker{display:none}.kds-faq-list summary span{font-size:24px;font-weight:400;color:var(--orange-ink);flex:none}.kds-faq-list details[open] summary span{transform:rotate(45deg)}.kds-faq-list details>p{padding:0 36px 20px 0;color:#51574e;font-size:13px;line-height:1.8}
  .kds-cta{background:#f0caa8;padding-block:62px}.kds-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.kds-cta .kds-kicker{color:#783516}.kds-cta h2{max-width:660px}.kds-cta-inner>div>p:last-child{max-width:540px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.kds-cta .button{flex:none}
  @media(max-width:1100px){.kds-hero{grid-template-columns:minmax(280px,.72fr) minmax(0,1.28fr);gap:35px}.kds-monitor-stand{display:none}.kds-workflow-grid{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:27px}.kds-workflow-grid li:nth-child(2){border-right:0}.kds-workflow-grid li:nth-child(3){padding-left:0}.kds-workflow-grid li{min-height:170px}}
  @media(max-width:950px){.kds-hero{grid-template-columns:1fr;padding-block:58px 68px}.kds-hero-copy{max-width:750px}.kds-hero h1{max-width:730px;font-size:clamp(49px,8vw,68px)}.kds-stations,.kds-states-layout,.kds-changes,.kds-print-inner{grid-template-columns:1fr;gap:37px}.kds-stations,.kds-changes{padding-block:67px}.kds-state-list{max-width:740px;width:100%}.kds-faq{gap:40px}.kds-print{padding-block:62px}}
  @media(max-width:700px){.breadcrumbs{padding-top:15px;font-size:11px}.kds-hero{padding-block:46px 58px;gap:28px}.kds-hero h1{font-size:clamp(43px,11.3vw,60px);margin-top:18px}.kds-lede{font-size:15px;margin-top:17px}.kds-actions{display:grid;grid-template-columns:1fr;gap:14px;margin-top:22px}.kds-actions .button{width:100%;justify-content:space-between}.kds-screen{padding:14px 12px 11px;border-radius:13px}.kds-screen figcaption{font-size:9px;gap:8px;margin-bottom:12px}.kds-bezel{max-width:310px;margin-inline:auto;padding:6px;border-width:2px;border-radius:25px}.kds-bezel img{border-radius:18px}.kds-workflow{padding-block:61px}.kds-section-heading h2,.kds-station-copy h2,.kds-states h2,.kds-change-intro h2,.kds-print h2,.kds-faq h2,.kds-cta h2{font-size:clamp(36px,9vw,47px)}.kds-section-heading>p:last-child{font-size:14px}.kds-workflow-grid{grid-template-columns:1fr;margin-top:29px;row-gap:0}.kds-workflow-grid li,.kds-workflow-grid li+li{min-height:0;padding:18px 0;border-right:0;border-bottom:1px solid #60665b}.kds-workflow-grid li:last-child{border-bottom:0}.kds-workflow-grid h3{font-size:20px;margin-top:12px}.kds-workflow-grid p{max-width:none;font-size:13px}.kds-stations,.kds-changes{padding-block:58px}.kds-station-copy>p:not(.kds-kicker){font-size:14px}.kds-station-copy h3{font-size:20px}.kds-ticket-details h3{font-size:17px}.kds-states{padding-block:59px}.kds-states-layout{gap:27px}.kds-states-layout>div>p:not(.kds-kicker){font-size:14px}.kds-change-intro>p:last-child{font-size:14px}.kds-change-list h3{font-size:18px}.kds-print{padding-block:57px}.kds-print-inner{gap:23px}.kds-print-inner>div:last-child>p{font-size:14px}.kds-faq{grid-template-columns:1fr;gap:22px;padding-block:62px}.kds-faq-list summary{min-height:62px;font-size:13px}.kds-faq-list details>p{font-size:12px}.kds-cta{padding-block:51px}.kds-cta-inner{display:grid;grid-template-columns:1fr;gap:23px}.kds-cta-inner>div>p:last-child{font-size:13px}.kds-cta .button{width:100%;justify-content:space-between}}
  @media(prefers-reduced-motion:reduce){.kds-faq-list summary span{transition:none}.kds-faq-list details[open] summary span{transform:none}}
</style>
