---
import { getEntry } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
const entry = await getEntry('pages', 'restaurant-cash-management');
if (!entry) throw new Error('CMS content entry "restaurant-cash-management" is missing.');
const { seo, copy, cashLists, imageAlt } = entry.data;
if (!cashLists?.controls.length || !cashLists.workflowSteps.length || !cashLists.faqs.length || !imageAlt?.cashShiftPhone) throw new Error('Restaurant cash management page content is incomplete.');
const schema = {'@context':'https://schema.org','@type':'WebPage',name:seo.title,url:seo.canonical,description:seo.description,isPartOf:{'@type':'WebSite',name:'RestaBee',url:'https://restabee.com/'},about:{'@type':'SoftwareApplication',name:'RestaBee',applicationCategory:'BusinessApplication',operatingSystem:'Web'},breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Restaurant POS',item:'https://restabee.com/'},{'@type':'ListItem',position:2,name:'Features',item:'https://restabee.com/features/'},{'@type':'ListItem',position:3,name:'Restaurant cash management',item:seo.canonical}]}};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="cash-page">
    <nav class="cash-breadcrumb container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><a href="/features/">Features</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>
    <section class="cash-hero container" aria-labelledby="cash-title">
      <div class="cash-hero-copy"><p class="cash-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p><h1 id="cash-title">{copy.heroTitle}</h1><p class="cash-lede">{copy.heroDescription}</p><div class="cash-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#cash-workflow">{copy.workflowCta}<Mark name="down" /></a></div></div>
      <figure class="cash-phone"><figcaption><span>{copy.screenLabel}</span><span>{copy.screenDataLabel}</span></figcaption><div class="cash-phone-bezel"><img src="/pos-images/restabee-pos-my-shift-mobile.webp" width="800" height="1656" alt={imageAlt.cashShiftPhone} fetchpriority="high" decoding="async"/></div><p>{copy.screenCaption}</p></figure>
    </section>
    <section class="cash-overview container" aria-labelledby="cash-overview-title"><div><p class="cash-kicker">{copy.overviewKicker}</p><h2 id="cash-overview-title">{copy.overviewTitle}</h2></div><div class="cash-copy"><p>{copy.overviewParagraphOne}</p><p>{copy.overviewParagraphTwo}</p><p>{copy.overviewParagraphThree}</p></div></section>
    <section class="cash-controls" aria-labelledby="cash-controls-title"><div class="container"><header class="cash-section-head"><p class="cash-kicker">{copy.controlsKicker}</p><h2 id="cash-controls-title">{copy.controlsTitle}</h2><p>{copy.controlsDescription}</p></header><ul class="cash-control-grid" aria-label={copy.controlsListLabel}>{cashLists.controls.map((item,index)=><li><span>0{index+1}</span><h3>{item.title}</h3><p>{item.description}</p></li>)}</ul></div></section>
    <section class="cash-workflow" id="cash-workflow" aria-labelledby="cash-workflow-title"><div class="container"><header class="cash-section-head"><p class="cash-kicker">{copy.workflowKicker}</p><h2 id="cash-workflow-title">{copy.workflowTitle}</h2><p>{copy.workflowDescription}</p></header><ol class="cash-workflow-list" aria-label={copy.workflowListLabel}>{cashLists.workflowSteps.map(step=><li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></div></section>
    <section class="cash-movement container" aria-labelledby="cash-movement-title"><div class="cash-movement-heading"><p class="cash-kicker">{copy.movementKicker}</p><h2 id="cash-movement-title">{copy.movementTitle}</h2></div><div class="cash-copy"><p>{copy.movementParagraphOne}</p><p>{copy.movementParagraphTwo}</p><p>{copy.movementParagraphThree}</p></div></section>
    <section class="cash-roles"><div class="container cash-roles-inner"><div><p class="cash-kicker">{copy.rolesKicker}</p><h2>{copy.rolesTitle}</h2></div><div class="cash-copy"><p>{copy.rolesParagraphOne}</p><p>{copy.rolesParagraphTwo}</p></div></div></section>
    <section class="cash-related container" aria-labelledby="cash-related-title"><div><p class="cash-kicker">{copy.relatedKicker}</p><h2 id="cash-related-title">{copy.relatedTitle}</h2><p>{copy.relatedDescription}</p></div><div class="cash-related-links"><a href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a><a href="/features/">{copy.featuresLinkLabel}<Mark /></a></div></section>
    <section class="cash-faq container" aria-labelledby="cash-faq-title"><div class="cash-faq-intro"><p class="cash-kicker">{copy.faqKicker}</p><h2 id="cash-faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div><div class="cash-faq-list">{cashLists.faqs.map(({question,answer})=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <section class="cash-cta"><div class="container cash-cta-inner"><div><p class="cash-kicker">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a></div></section>
  </main>
  <SiteFooter />
</SiteLayout>
<style>
.cash-page{overflow:hidden}.cash-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.cash-breadcrumb a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.cash-breadcrumb [aria-current=page]{color:var(--ink)}.cash-kicker{display:flex;align-items:center;gap:10px;color:#963b18;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.cash-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}.cash-hero{display:grid;grid-template-columns:minmax(300px,.9fr) minmax(260px,.55fr);gap:clamp(38px,7vw,92px);align-items:center;padding-block:61px 76px}.cash-hero h1{max-width:650px;font-size:clamp(48px,5.2vw,70px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.cash-lede{max-width:590px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.cash-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.cash-actions .button{gap:20px}.cash-phone{width:100%;max-width:340px;justify-self:center;padding:15px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.cash-phone figcaption{display:flex;justify-content:space-between;gap:12px;margin:0 0 13px;color:#4f554c;font-size:10px}.cash-phone figcaption span:first-child{font-weight:700;color:var(--ink)}.cash-phone-bezel{max-width:225px;margin-inline:auto;padding:6px;border:3px solid #252a24;border-radius:27px;background:#20231f}.cash-phone img{display:block;width:100%;height:auto;border-radius:19px}.cash-phone>p{padding-top:12px;color:#51574e;font-size:12px;line-height:1.6}.cash-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 86px;border-top:1px solid var(--line)}.cash-overview h2,.cash-section-head h2,.cash-movement h2,.cash-roles h2,.cash-related h2,.cash-faq h2,.cash-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.cash-copy p{color:#51574e;font-size:15px;line-height:1.8}.cash-copy p+p{margin-top:13px}.cash-controls,.cash-workflow{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.cash-section-head{max-width:760px}.cash-controls .cash-kicker,.cash-workflow .cash-kicker{color:#ffb17d}.cash-section-head>p:last-child{max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:15px}.cash-control-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:38px;border-top:1px solid #60665b;border-left:1px solid #60665b}.cash-control-grid li{min-height:228px;padding:22px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.cash-control-grid li>span,.cash-workflow-list li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.08em}.cash-control-grid h3{font-size:20px;line-height:1.28;margin-top:25px}.cash-control-grid p,.cash-workflow-list p{max-width:350px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}.cash-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:39px;border-top:1px solid #60665b}.cash-workflow-list li{min-height:190px;padding:21px 20px 0 0;border-right:1px solid #60665b}.cash-workflow-list li+li{padding-left:21px}.cash-workflow-list li:last-child{border-right:0}.cash-workflow-list h3{font-size:20px;line-height:1.25;margin-top:25px}.cash-movement{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:86px}.cash-movement h2{max-width:600px}.cash-roles{padding-block:74px;background:#e8ecdf}.cash-roles-inner{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);align-items:start}.cash-roles h2{max-width:600px}.cash-roles .cash-copy p{color:#42493f}.cash-related{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:end;padding-block:76px;border-top:1px solid var(--line)}.cash-related>div>p:last-child{max-width:690px;margin-top:16px;color:#51574e;font-size:15px;line-height:1.8}.cash-related-links{display:grid;gap:13px;min-width:245px}.cash-related-links a{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:15px 0;border-bottom:1px solid var(--line);color:#85310e;font-weight:700;text-decoration:none}.cash-faq{display:grid;grid-template-columns:minmax(220px,.72fr) minmax(0,1.28fr);gap:clamp(36px,7vw,88px);padding-block:82px}.cash-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:15px}.cash-faq-list details{border-top:1px solid var(--line)}.cash-faq-list details:last-child{border-bottom:1px solid var(--line)}.cash-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:64px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.cash-faq-list summary::-webkit-details-marker{display:none}.cash-faq-list summary span{font-size:24px;font-weight:400;color:#963b18;flex:none;transition:transform .18s}.cash-faq-list details[open] summary span{transform:rotate(45deg)}.cash-faq-list details>p{padding:0 35px 19px 0;color:#51574e;font-size:13px;line-height:1.8}.cash-cta{padding-block:62px;background:#f0caa8}.cash-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.cash-cta .cash-kicker{color:#783516}.cash-cta h2{max-width:700px}.cash-cta-inner>div>p:last-child{max-width:570px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.cash-cta .button{flex:none}
@media(max-width:1050px){.cash-control-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cash-control-grid li{min-height:0}.cash-control-grid h3{margin-top:17px}.cash-workflow-list{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:25px}.cash-workflow-list li:nth-child(2){border-right:0}.cash-workflow-list li:nth-child(3){padding-left:0}.cash-workflow-list li{min-height:165px}}
@media(max-width:950px){.cash-hero{grid-template-columns:minmax(0,1fr) minmax(220px,.55fr);gap:34px;padding-block:52px 62px}.cash-hero h1{font-size:clamp(44px,6.5vw,62px)}.cash-overview,.cash-movement,.cash-roles-inner{grid-template-columns:1fr;gap:28px}.cash-overview{padding-block:60px}.cash-movement,.cash-roles{padding-block:65px}.cash-related{gap:28px}}
@media(max-width:700px){.cash-breadcrumb{padding-top:14px;font-size:10px;gap:7px}.cash-hero{grid-template-columns:1fr;padding-block:43px 54px;gap:28px}.cash-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.cash-lede{font-size:14px;margin-top:16px}.cash-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.cash-actions .button{width:100%;justify-content:space-between}.cash-phone{max-width:320px;margin-top:8px;padding:13px 12px;border-radius:13px}.cash-phone figcaption{font-size:9px;gap:8px;margin-bottom:11px}.cash-phone-bezel{max-width:215px}.cash-phone>p{font-size:11px}.cash-overview{padding-block:52px 59px;gap:22px}.cash-overview h2,.cash-section-head h2,.cash-movement h2,.cash-roles h2,.cash-related h2,.cash-faq h2,.cash-cta h2{font-size:clamp(35px,9vw,46px)}.cash-copy p{font-size:14px}.cash-controls,.cash-workflow{padding-block:59px 64px}.cash-section-head>p:last-child{font-size:14px}.cash-control-grid{grid-template-columns:1fr;margin-top:27px}.cash-control-grid li{padding:18px}.cash-control-grid h3{font-size:19px;margin-top:13px}.cash-control-grid p,.cash-workflow-list p{font-size:13px}.cash-workflow-list{grid-template-columns:1fr;margin-top:28px;row-gap:0}.cash-workflow-list li,.cash-workflow-list li+li{min-height:0;padding:17px 0;border-right:0;border-bottom:1px solid #60665b}.cash-workflow-list li:last-child{border-bottom:0}.cash-workflow-list h3{font-size:19px;margin-top:10px}.cash-movement,.cash-roles{padding-block:59px}.cash-roles-inner{gap:22px}.cash-related{grid-template-columns:1fr;gap:23px;padding-block:59px}.cash-related-links{min-width:0}.cash-faq{grid-template-columns:1fr;gap:21px;padding-block:59px}.cash-faq-list summary{min-height:61px;font-size:13px}.cash-faq-list details>p{font-size:12px}.cash-cta{padding-block:50px}.cash-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.cash-cta-inner>div>p:last-child{font-size:13px}.cash-cta .button{width:100%;justify-content:space-between}}
@media(prefers-reduced-motion:reduce){.cash-faq-list summary span{transition:none}.cash-faq-list details[open] summary span{transform:none}}
</style>
