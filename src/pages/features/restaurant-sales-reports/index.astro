---
import { getEntry } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const entry = await getEntry('pages', 'restaurant-sales-reports');
if (!entry) throw new Error('CMS content entry "restaurant-sales-reports" is missing.');
const { seo, copy, salesReportLists, imageAlt } = entry.data;
if (!salesReportLists?.reportGroups.length || salesReportLists.reportGroups.some((group) => !group.reports.length) || !salesReportLists.workflowSteps.length || !salesReportLists.faqs.length || !imageAlt?.salesReportsPhone) {
  throw new Error('Restaurant sales reports page content is incomplete.');
}
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
    { '@type': 'ListItem', position: 2, name: 'Features', item: 'https://restabee.com/features/' },
    { '@type': 'ListItem', position: 3, name: 'Restaurant sales reports', item: seo.canonical },
  ] },
};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="reports-page">
    <nav class="reports-breadcrumb container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><a href="/features/">Features</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>
    <section class="reports-hero container" aria-labelledby="reports-title">
      <div class="reports-hero-copy">
        <p class="reports-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="reports-title">{copy.heroTitle}</h1>
        <p class="reports-lede">{copy.heroDescription}</p>
        <div class="reports-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#report-workflow">{copy.workflowCta}<Mark name="down" /></a></div>
      </div>
      <figure class="reports-phone">
        <figcaption><span>{copy.screenLabel}</span><span>{copy.screenDataLabel}</span></figcaption>
        <div class="reports-phone-bezel"><img src="/pos-images/restabee-pos-reports-mobile.webp" width="800" height="1656" alt={imageAlt.salesReportsPhone} fetchpriority="high" decoding="async" /></div>
        <p>{copy.screenCaption}</p>
      </figure>
    </section>

    <section class="reports-overview container" aria-labelledby="reports-overview-title">
      <div><p class="reports-kicker">{copy.overviewKicker}</p><h2 id="reports-overview-title">{copy.overviewTitle}</h2></div>
      <div class="reports-copy"><p>{copy.overviewParagraphOne}</p><p>{copy.overviewParagraphTwo}</p><p>{copy.overviewParagraphThree}</p></div>
    </section>

    <section class="reports-views" aria-labelledby="reports-views-title">
      <div class="container">
        <header class="reports-section-head"><p class="reports-kicker">{copy.viewsKicker}</p><h2 id="reports-views-title">{copy.viewsTitle}</h2><p>{copy.viewsDescription}</p></header>
        <div class="reports-group-grid" role="group" aria-label={copy.viewsListLabel}>{salesReportLists.reportGroups.map((group) => <section class="reports-group-card" aria-labelledby={`reports-group-${group.title.toLowerCase().replaceAll(' ', '-')}`}><header><h3 id={`reports-group-${group.title.toLowerCase().replaceAll(' ', '-')}`}>{group.title}</h3></header><ul>{group.reports.map((report) => <li><h4>{report.title}</h4><p>{report.description}</p></li>)}</ul></section>)}</div>
      </div>
    </section>

    <section class="reports-workflow" id="report-workflow" aria-labelledby="report-workflow-title">
      <div class="container">
        <header class="reports-section-head"><p class="reports-kicker">{copy.workflowKicker}</p><h2 id="report-workflow-title">{copy.workflowTitle}</h2><p>{copy.workflowDescription}</p></header>
        <ol class="reports-workflow-list" aria-label={copy.workflowListLabel}>{salesReportLists.workflowSteps.map((step) => <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="reports-scope" aria-labelledby="reports-scope-title">
      <div class="container reports-scope-inner">
        <div><p class="reports-kicker">{copy.scopeKicker}</p><h2 id="reports-scope-title">{copy.scopeTitle}</h2></div>
        <div class="reports-copy"><p>{copy.scopeParagraphOne}</p><p>{copy.scopeParagraphTwo}</p><p>{copy.scopeParagraphThree}</p></div>
      </div>
    </section>

    <section class="reports-shift container" aria-labelledby="reports-shift-title">
      <div><p class="reports-kicker">{copy.shiftKicker}</p><h2 id="reports-shift-title">{copy.shiftTitle}</h2></div>
      <div class="reports-copy"><p>{copy.shiftParagraphOne}</p><p>{copy.shiftParagraphTwo}</p><div class="reports-related-links"><a href="/features/restaurant-cash-management/">{copy.cashLinkLabel}<Mark /></a><a href="/features/multi-outlet-restaurant-management/">{copy.multiOutletLinkLabel}<Mark /></a></div></div>
    </section>

    <section class="reports-audit" aria-labelledby="reports-audit-title"><div class="container reports-audit-inner"><div><p class="reports-kicker">{copy.auditKicker}</p><h2 id="reports-audit-title">{copy.auditTitle}</h2></div><p>{copy.auditParagraph}</p></div></section>

    <section class="reports-faq container" aria-labelledby="reports-faq-title">
      <div class="reports-faq-intro"><p class="reports-kicker">{copy.faqKicker}</p><h2 id="reports-faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div>
      <div class="reports-faq-list">{salesReportLists.faqs.map(({ question, answer }) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="reports-cta"><div class="container reports-cta-inner"><div><p class="reports-kicker">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a></div></section>
  </main>
  <SiteFooter />
</SiteLayout>
<style>
.reports-page{overflow:hidden}.reports-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.reports-breadcrumb a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.reports-breadcrumb [aria-current=page]{color:var(--ink)}.reports-kicker{display:flex;align-items:center;gap:10px;color:#963b18;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.reports-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}.reports-hero{display:grid;grid-template-columns:minmax(300px,.9fr) minmax(260px,.55fr);gap:clamp(38px,7vw,92px);align-items:center;padding-block:61px 76px}.reports-hero h1{max-width:680px;font-size:clamp(48px,5.2vw,70px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.reports-lede{max-width:610px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.reports-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.reports-actions .button{gap:20px}.reports-phone{width:100%;max-width:340px;justify-self:center;padding:15px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.reports-phone figcaption{display:flex;justify-content:space-between;gap:12px;margin:0 0 13px;color:#4f554c;font-size:10px}.reports-phone figcaption span:first-child{font-weight:700;color:var(--ink)}.reports-phone-bezel{max-width:225px;margin-inline:auto;padding:6px;border:3px solid #252a24;border-radius:27px;background:#20231f}.reports-phone img{display:block;width:100%;height:auto;border-radius:19px}.reports-phone>p{padding-top:12px;color:#51574e;font-size:12px;line-height:1.6}.reports-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 86px;border-top:1px solid var(--line)}.reports-overview h2,.reports-section-head h2,.reports-scope h2,.reports-shift h2,.reports-faq h2,.reports-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.reports-copy p{color:#51574e;font-size:15px;line-height:1.8}.reports-copy p+p{margin-top:13px}.reports-views,.reports-workflow{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.reports-section-head{max-width:760px}.reports-views .reports-kicker,.reports-workflow .reports-kicker{color:#ffb17d}.reports-section-head>p:last-child{max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:15px}.reports-view-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;margin-top:38px;border-top:1px solid #60665b;border-left:1px solid #60665b}.reports-view-grid li{min-height:208px;padding:22px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.reports-view-grid li>span,.reports-workflow-list li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.08em}.reports-view-grid h3{font-size:20px;line-height:1.28;margin-top:25px}.reports-view-grid p,.reports-workflow-list p{max-width:350px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}.reports-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:39px;border-top:1px solid #60665b}.reports-workflow-list li{min-height:190px;padding:21px 20px 0 0;border-right:1px solid #60665b}.reports-workflow-list li+li{padding-left:21px}.reports-workflow-list li:last-child{border-right:0}.reports-workflow-list h3{font-size:20px;line-height:1.25;margin-top:25px}.reports-scope{padding-block:74px;background:#e8ecdf}.reports-scope-inner{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);align-items:start}.reports-scope h2{max-width:600px}.reports-scope .reports-copy p{color:#42493f}.reports-shift{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:82px}.reports-shift h2{max-width:600px}.reports-related-links{display:flex;flex-wrap:wrap;gap:18px 28px;margin-top:24px}.reports-related-links a{display:inline-flex;align-items:center;gap:9px;color:#85310e;font-size:14px;font-weight:700;text-decoration:underline;text-underline-offset:4px}.reports-faq{display:grid;grid-template-columns:minmax(220px,.72fr) minmax(0,1.28fr);gap:clamp(36px,7vw,88px);padding-block:82px}.reports-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:15px}.reports-faq-list details{border-top:1px solid var(--line)}.reports-faq-list details:last-child{border-bottom:1px solid var(--line)}.reports-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:64px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.reports-faq-list summary::-webkit-details-marker{display:none}.reports-faq-list summary span{font-size:24px;font-weight:400;color:#963b18;flex:none;transition:transform .18s}.reports-faq-list details[open] summary span{transform:rotate(45deg)}.reports-faq-list details>p{padding:0 35px 19px 0;color:#51574e;font-size:13px;line-height:1.8}.reports-cta{padding-block:62px;background:#f0caa8}.reports-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.reports-cta .reports-kicker{color:#783516}.reports-cta h2{max-width:700px}.reports-cta-inner>div>p:last-child{max-width:570px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.reports-cta .button{flex:none}
@media(max-width:1050px){.reports-view-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.reports-view-grid li{min-height:0}.reports-view-grid h3{margin-top:17px}.reports-workflow-list{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:25px}.reports-workflow-list li:nth-child(2){border-right:0}.reports-workflow-list li:nth-child(3){padding-left:0}.reports-workflow-list li{min-height:165px}}
@media(max-width:950px){.reports-hero{grid-template-columns:minmax(0,1fr) minmax(220px,.55fr);gap:34px;padding-block:52px 62px}.reports-hero h1{font-size:clamp(44px,6.5vw,62px)}.reports-overview,.reports-scope-inner,.reports-shift{grid-template-columns:1fr;gap:28px}.reports-overview{padding-block:60px}.reports-shift{padding-block:65px}}
@media(max-width:700px){.reports-breadcrumb{padding-top:14px;font-size:10px;gap:7px}.reports-hero{grid-template-columns:1fr;padding-block:43px 54px;gap:28px}.reports-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.reports-lede{font-size:14px;margin-top:16px}.reports-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.reports-actions .button{width:100%;justify-content:space-between}.reports-phone{max-width:320px;margin-top:8px;padding:13px 12px;border-radius:13px}.reports-phone figcaption{font-size:9px;gap:8px;margin-bottom:11px}.reports-phone-bezel{max-width:215px}.reports-phone>p{font-size:11px}.reports-overview{padding-block:52px 59px;gap:22px}.reports-overview h2,.reports-section-head h2,.reports-scope h2,.reports-shift h2,.reports-faq h2,.reports-cta h2{font-size:clamp(35px,9vw,46px)}.reports-copy p{font-size:14px}.reports-views,.reports-workflow{padding-block:59px 64px}.reports-section-head>p:last-child{font-size:14px}.reports-view-grid{grid-template-columns:1fr;margin-top:27px}.reports-view-grid li{padding:18px}.reports-view-grid h3{font-size:19px;margin-top:13px}.reports-view-grid p,.reports-workflow-list p{font-size:13px}.reports-workflow-list{grid-template-columns:1fr;margin-top:28px;row-gap:0}.reports-workflow-list li,.reports-workflow-list li+li{min-height:0;padding:17px 0;border-right:0;border-bottom:1px solid #60665b}.reports-workflow-list li:last-child{border-bottom:0}.reports-workflow-list h3{font-size:19px;margin-top:10px}.reports-scope,.reports-shift{padding-block:59px}.reports-scope-inner{gap:22px}.reports-related-links{display:grid;gap:14px}.reports-faq{grid-template-columns:1fr;gap:21px;padding-block:59px}.reports-faq-list summary{min-height:61px;font-size:13px}.reports-faq-list details>p{font-size:12px}.reports-cta{padding-block:50px}.reports-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.reports-cta-inner>div>p:last-child{font-size:13px}.reports-cta .button{width:100%;justify-content:space-between}}
@media(prefers-reduced-motion:reduce){.reports-faq-list summary span{transition:none}.reports-faq-list details[open] summary span{transform:none}}
.reports-group-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:38px;align-items:start}.reports-group-card{overflow:hidden;border:1px solid #dfe0dd;border-radius:18px;background:#fffefa;color:#242820}.reports-group-card>header{display:flex;align-items:center;min-height:62px;padding:16px 20px;border-bottom:1px solid #dedfd5}.reports-group-card h3{font-size:20px;line-height:1.25}.reports-group-card ul{list-style:none}.reports-group-card li{min-height:108px;padding:18px 20px;border-bottom:1px solid #dedfd5}.reports-group-card li:last-child{border-bottom:0}.reports-group-card h4{font-size:16px;line-height:1.3}.reports-group-card p{margin-top:7px;color:#51574e;font-size:13px;line-height:1.55}.reports-audit{padding-block:70px;background:#e8ecdf}.reports-audit-inner{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);align-items:start}.reports-audit h2{max-width:560px;font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.reports-audit-inner>p{color:#42493f;font-size:15px;line-height:1.8}@media(max-width:1050px){.reports-group-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.reports-group-card li{min-height:0}}@media(max-width:950px){.reports-audit-inner{grid-template-columns:1fr;gap:24px}}@media(max-width:700px){.reports-group-grid{grid-template-columns:1fr;margin-top:27px;gap:14px}.reports-group-card>header{min-height:55px;padding:14px 16px}.reports-group-card h3{font-size:18px}.reports-group-card li{padding:15px 16px}.reports-group-card h4{font-size:15px}.reports-audit{padding-block:59px}.reports-audit h2{font-size:clamp(35px,9vw,46px)}}
</style>
