---
import { getEntry } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
const entry = await getEntry('pages', 'restaurant-table-management');
if (!entry) throw new Error('CMS content entry "restaurant-table-management" is missing.');
const { seo, copy, tableLists, imageAlt } = entry.data;
if (!tableLists?.floorStates.length || !tableLists.workflowSteps.length || !tableLists.faqs.length || !imageAlt?.floorView) throw new Error('Restaurant table management page content is incomplete.');
const schema = {'@context':'https://schema.org','@type':'WebPage',name:seo.title,url:seo.canonical,description:seo.description,isPartOf:{'@type':'WebSite',name:'RestaBee',url:'https://restabee.com/'},about:{'@type':'SoftwareApplication',name:'RestaBee',applicationCategory:'BusinessApplication',operatingSystem:'Web, Android, iOS, macOS, Windows'},breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Restaurant POS',item:'https://restabee.com/'},{'@type':'ListItem',position:2,name:'Restaurant table management',item:seo.canonical}]}};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="table-page">
    <nav class="table-breadcrumb container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>
    <section class="table-hero container" aria-labelledby="table-title"><div class="table-hero-copy"><p class="table-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p><h1 id="table-title">{copy.heroTitle}</h1><p class="table-lede">{copy.heroDescription}</p><div class="table-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#table-workflow">{copy.workflowCta}<Mark name="down" /></a></div></div><figure class="table-screen"><figcaption><span>{copy.screenLabel}</span><span>{copy.screenDataLabel}</span></figcaption><div class="table-monitor"><div class="table-bezel"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-floor-view-mobile.webp" width="800" height="1656"/><img src="/pos-images/restabee-restaurant-pos-floor-view-desktop.webp" width="2296" height="1656" alt={imageAlt.floorView} fetchpriority="high" decoding="async"/></picture></div><div class="table-stand" aria-hidden="true"></div></div><p>{copy.screenCaption}</p></figure></section>
    <section class="table-overview container" aria-labelledby="table-overview-title"><div><p class="table-kicker">{copy.overviewKicker}</p><h2 id="table-overview-title">{copy.overviewTitle}</h2></div><div class="table-copy"><p>{copy.overviewParagraphOne}</p><p>{copy.overviewParagraphTwo}</p><p>{copy.overviewParagraphThree}</p></div></section>
    <section class="table-states" aria-labelledby="table-states-title"><div class="container"><header class="table-section-heading"><p class="table-kicker">{copy.statesKicker}</p><h2 id="table-states-title">{copy.statesTitle}</h2><p>{copy.statesDescription}</p></header><ul class="table-state-grid" aria-label={copy.statesListLabel}>{tableLists.floorStates.map((state,index)=><li><span>0{index+1}</span><h3>{state.title}</h3><p>{state.description}</p></li>)}</ul></div></section>
    <section class="table-workflow" id="table-workflow" aria-labelledby="table-workflow-title"><div class="container"><header class="table-section-heading"><p class="table-kicker">{copy.workflowKicker}</p><h2 id="table-workflow-title">{copy.workflowTitle}</h2><p>{copy.workflowDescription}</p></header><ol class="table-workflow-list" aria-label={copy.workflowListLabel}>{tableLists.workflowSteps.map(step=><li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></div></section>
    <section class="table-assignment container" aria-labelledby="table-assignment-title"><div class="table-assignment-heading"><p class="table-kicker">{copy.assignmentKicker}</p><h2 id="table-assignment-title">{copy.assignmentTitle}</h2></div><div class="table-copy"><p>{copy.assignmentParagraphOne}</p><p>{copy.assignmentParagraphTwo}</p><p>{copy.assignmentParagraphThree}</p></div></section>
    <section class="table-qr"><div class="container table-qr-inner"><div><p class="table-kicker">{copy.qrKicker}</p><h2>{copy.qrTitle}</h2><p>{copy.qrDescription}</p></div><a class="text-link" href="/#qr-ordering">{copy.qrLinkLabel}<Mark /></a></div></section>
    <section class="table-operations container" aria-labelledby="table-operations-title"><div><p class="table-kicker">{copy.operationsKicker}</p><h2 id="table-operations-title">{copy.operationsTitle}</h2><p>{copy.operationsDescription}</p></div><figure class="table-phone"><figcaption><span>{copy.screenLabel} · phone</span><span>{copy.screenDataLabel}</span></figcaption><div class="table-phone-bezel"><img src="/pos-images/restabee-restaurant-pos-floor-view-mobile.webp" width="800" height="1656" alt={imageAlt.floorView} loading="lazy" decoding="async"/></div></figure></section>
    <section class="table-related container" aria-labelledby="table-related-title"><div><p class="table-kicker">{copy.relatedKicker}</p><h2 id="table-related-title">{copy.relatedTitle}</h2><p>{copy.relatedDescription}</p></div><div class="table-related-links"><a href="/features/restaurant-order-management/">{copy.orderLinkLabel}<Mark /></a><a href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a></div></section>
    <section class="table-faq container" aria-labelledby="table-faq-title"><div class="table-faq-intro"><p class="table-kicker">{copy.faqKicker}</p><h2 id="table-faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div><div class="table-faq-list">{tableLists.faqs.map(({question,answer})=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <section class="table-cta"><div class="container table-cta-inner"><div><p class="table-kicker">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a></div></section>
  </main><SiteFooter />
</SiteLayout>
<style>
.table-page{overflow:hidden}.table-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.table-breadcrumb a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.table-breadcrumb [aria-current=page]{color:var(--ink)}.table-kicker{display:flex;align-items:center;gap:10px;color:#963b18;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.table-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}.table-hero{display:grid;grid-template-columns:minmax(300px,.78fr) minmax(0,1.22fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:66px 78px}.table-hero h1{max-width:610px;font-size:clamp(49px,5.3vw,72px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.table-lede{max-width:565px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.table-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.table-actions .button{gap:20px}.table-screen{min-width:0;padding:17px 18px 14px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.table-screen figcaption,.table-phone figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 16px;color:#4f554c;font-size:11px}.table-screen figcaption span:first-child,.table-phone figcaption span:first-child{font-weight:700;color:var(--ink)}.table-bezel{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.table-bezel picture,.table-bezel img{display:block;width:100%;height:auto}.table-bezel img{border-radius:4px}.table-stand{width:28%;height:24px;margin:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}.table-screen>p{padding-top:12px;color:#62665d;font-size:13px}.table-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 86px;border-top:1px solid var(--line)}.table-overview h2,.table-section-heading h2,.table-assignment h2,.table-qr h2,.table-operations h2,.table-related h2,.table-faq h2,.table-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.table-copy p,.table-qr-inner>div>p:last-child,.table-operations>div>p:last-child,.table-related>div>p:last-child{color:#51574e;font-size:15px;line-height:1.8}.table-copy p+p{margin-top:13px}.table-states,.table-workflow{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.table-section-heading{max-width:760px}.table-states .table-kicker,.table-workflow .table-kicker{color:#ffb17d}.table-section-heading>p:last-child{max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:15px}.table-state-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;margin-top:38px;border-top:1px solid #60665b;border-left:1px solid #60665b}.table-state-grid li{min-height:205px;padding:23px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.table-state-grid li>span,.table-workflow-list li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.08em}.table-state-grid h3{font-size:22px;margin-top:25px}.table-state-grid p,.table-workflow-list p{max-width:340px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}.table-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:39px;border-top:1px solid #60665b}.table-workflow-list li{min-height:190px;padding:21px 20px 0 0;border-right:1px solid #60665b}.table-workflow-list li+li{padding-left:21px}.table-workflow-list li:last-child{border-right:0}.table-workflow-list h3{font-size:20px;line-height:1.25;margin-top:25px}.table-assignment{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:86px}.table-assignment h2{max-width:600px}.table-assignment .table-copy>p:first-child{margin-top:1px}.table-qr{padding-block:70px;background:#e8ecdf}.table-qr-inner{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:end}.table-qr .table-kicker{color:#783516}.table-qr h2{max-width:700px}.table-qr-inner>div>p:last-child{max-width:760px;margin-top:16px;color:#42493f}.table-qr .text-link{white-space:nowrap;margin-bottom:5px}.table-operations{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,.55fr);gap:clamp(40px,7vw,90px);align-items:center;padding-block:86px}.table-operations h2{max-width:620px}.table-operations>div>p:last-child{margin-top:18px}.table-phone{width:100%;max-width:350px;justify-self:center;padding:15px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.table-phone figcaption{font-size:10px;margin-bottom:13px}.table-phone-bezel{max-width:220px;margin-inline:auto;padding:6px;border:3px solid #252a24;border-radius:27px;background:#20231f}.table-phone img{display:block;width:100%;height:auto;border-radius:19px}.table-related{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:end;padding-block:76px;border-top:1px solid var(--line)}.table-related>div>p:last-child{max-width:690px;margin-top:16px}.table-related-links{display:grid;gap:13px;min-width:245px}.table-related-links a{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:15px 0;border-bottom:1px solid var(--line);color:#85310e;font-weight:700;text-decoration:none}.table-faq{display:grid;grid-template-columns:minmax(220px,.72fr) minmax(0,1.28fr);gap:clamp(36px,7vw,88px);padding-block:82px}.table-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:15px}.table-faq-list details{border-top:1px solid var(--line)}.table-faq-list details:last-child{border-bottom:1px solid var(--line)}.table-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:64px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.table-faq-list summary::-webkit-details-marker{display:none}.table-faq-list summary span{font-size:24px;font-weight:400;color:#963b18;flex:none;transition:transform .18s}.table-faq-list details[open] summary span{transform:rotate(45deg)}.table-faq-list details>p{padding:0 35px 19px 0;color:#51574e;font-size:13px;line-height:1.8}.table-cta{padding-block:62px;background:#f0caa8}.table-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.table-cta .table-kicker{color:#783516}.table-cta h2{max-width:700px}.table-cta-inner>div>p:last-child{max-width:570px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.table-cta .button{flex:none}
@media(max-width:1050px){.table-state-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.table-state-grid li{min-height:0}.table-state-grid h3{margin-top:17px}.table-workflow-list{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:25px}.table-workflow-list li:nth-child(2){border-right:0}.table-workflow-list li:nth-child(3){padding-left:0}.table-workflow-list li{min-height:165px}}@media(max-width:950px){.table-hero{grid-template-columns:1fr;padding-block:56px 66px}.table-hero-copy{max-width:750px}.table-overview,.table-assignment{grid-template-columns:1fr;gap:30px}.table-overview{padding-block:60px}.table-assignment{padding-block:65px}.table-screen{max-width:850px;width:100%;margin-inline:auto}.table-operations{grid-template-columns:minmax(0,1fr) minmax(230px,.55fr);gap:35px}}@media(max-width:700px){.table-breadcrumb{padding-top:14px;font-size:10px;gap:7px}.table-hero{padding-block:43px 54px;gap:26px}.table-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.table-lede{font-size:14px;margin-top:16px}.table-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.table-actions .button{width:100%;justify-content:space-between}.table-screen{padding:13px 11px 12px;border-radius:13px}.table-screen figcaption,.table-phone figcaption{font-size:9px;gap:8px;margin-bottom:11px}.table-bezel{padding:6px;max-width:380px;margin-inline:auto;border-width:2px;border-radius:25px}.table-bezel img{border-radius:18px}.table-stand{display:none}.table-screen>p{font-size:12px}.table-overview{padding-block:52px 59px;gap:22px}.table-overview h2,.table-section-heading h2,.table-assignment h2,.table-qr h2,.table-operations h2,.table-related h2,.table-faq h2,.table-cta h2{font-size:clamp(35px,9vw,46px)}.table-copy p,.table-qr-inner>div>p:last-child,.table-operations>div>p:last-child,.table-related>div>p:last-child{font-size:14px}.table-states,.table-workflow{padding-block:59px 64px}.table-section-heading>p:last-child{font-size:14px}.table-state-grid{grid-template-columns:1fr;margin-top:27px}.table-state-grid li{padding:18px}.table-state-grid h3{font-size:19px;margin-top:13px}.table-state-grid p,.table-workflow-list p{font-size:13px}.table-workflow-list{grid-template-columns:1fr;margin-top:28px;row-gap:0}.table-workflow-list li,.table-workflow-list li+li{min-height:0;padding:17px 0;border-right:0;border-bottom:1px solid #60665b}.table-workflow-list li:last-child{border-bottom:0}.table-workflow-list h3{font-size:19px;margin-top:10px}.table-assignment{padding-block:59px;gap:24px}.table-qr{padding-block:58px}.table-qr-inner{grid-template-columns:1fr;gap:21px}.table-qr .text-link{margin-bottom:0}.table-operations{grid-template-columns:1fr;gap:30px;padding-block:62px}.table-phone{max-width:320px;margin-top:12px}.table-related{grid-template-columns:1fr;gap:23px;padding-block:59px}.table-related-links{min-width:0}.table-faq{grid-template-columns:1fr;gap:21px;padding-block:59px}.table-faq-list summary{min-height:61px;font-size:13px}.table-faq-list details>p{font-size:12px}.table-cta{padding-block:50px}.table-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.table-cta-inner>div>p:last-child{font-size:13px}.table-cta .button{width:100%;justify-content:space-between}}@media(prefers-reduced-motion:reduce){.table-faq-list summary span{transition:none}.table-faq-list details[open] summary span{transform:none}}
</style>
