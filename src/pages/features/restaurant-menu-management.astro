---
import { getEntry } from 'astro:content';
import Mark from '../../components/Mark.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const pageEntry = await getEntry('pages', 'restaurant-menu-management');
if (!pageEntry) throw new Error('CMS content entry "restaurant-menu-management" is missing.');
const { seo, copy, menuLists, imageAlt } = pageEntry.data;
if (!menuLists) throw new Error('Menu content validation failed: add catalog parts, workflow steps, outlet modes and FAQs to menuLists.');
if (!imageAlt?.centralMenu || !imageAlt?.posMenu || !imageAlt?.menuPhotos || !imageAlt?.menuCompact) throw new Error('Menu content validation failed: add descriptive alternative text for each product screenshot.');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Android, iOS, macOS, Windows' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
    { '@type': 'ListItem', position: 2, name: 'Restaurant menu management', item: seo.canonical },
  ] },
};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="menu-page">
    <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>

    <section class="menu-hero container" aria-labelledby="menu-title">
      <div class="menu-hero-copy">
        <p class="menu-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="menu-title">{copy.heroTitle}</h1>
        <p class="menu-lede">{copy.heroDescription}</p>
        <div class="menu-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#menu-workflow">{copy.workflowCta}<Mark name="down" /></a></div>
      </div>
      <figure class="menu-screen menu-screen-central">
        <figcaption><span>{copy.screenLabel}</span><span>{copy.screenDataLabel}</span></figcaption>
        <div class="menu-device-shell"><div class="menu-bezel"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-central-menu-mobile.webp" width="880" height="1656"/><img src="/pos-images/restabee-restaurant-pos-central-menu-desktop.webp" width="2106" height="1656" alt={imageAlt.centralMenu} loading="eager" decoding="async" fetchpriority="high"/></picture></div><div class="menu-monitor-stand" aria-hidden="true"><span></span></div></div>
      </figure>
    </section>

    <section class="menu-overview container" aria-labelledby="menu-overview-title">
      <div class="menu-overview-copy"><p class="menu-kicker">{copy.overviewKicker}</p><h2 id="menu-overview-title">{copy.overviewTitle}</h2></div>
      <div class="menu-overview-body"><p>{copy.overviewParagraphOne}</p><p>{copy.overviewParagraphTwo}</p><p>{copy.overviewParagraphThree}</p></div>
    </section>

    <section class="menu-catalog" aria-labelledby="menu-catalog-title">
      <div class="container">
        <header class="menu-section-heading"><p class="menu-kicker">{copy.catalogKicker}</p><h2 id="menu-catalog-title">{copy.catalogTitle}</h2><p>{copy.catalogDescription}</p></header>
        <ul class="menu-catalog-grid" aria-label={copy.catalogListLabel}>{menuLists.catalogParts.map((part, index) => <li><span class="menu-index">0{index + 1}</span><h3>{part.title}</h3><p>{part.description}</p></li>)}</ul>
      </div>
    </section>

    <section class="menu-workflow container" id="menu-workflow" aria-labelledby="menu-workflow-title">
      <header class="menu-section-heading"><p class="menu-kicker">{copy.workflowKicker}</p><h2 id="menu-workflow-title">{copy.workflowTitle}</h2><p>{copy.workflowDescription}</p></header>
      <ol class="menu-workflow-list" aria-label={copy.workflowListLabel}>{menuLists.workflowSteps.map((step) => <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
    </section>

    <section class="menu-outlets" aria-labelledby="menu-outlet-title">
      <div class="container menu-outlet-layout">
        <div class="menu-outlet-copy"><p class="menu-kicker">{copy.outletKicker}</p><h2 id="menu-outlet-title">{copy.outletTitle}</h2><p>{copy.outletParagraphOne}</p><p>{copy.outletParagraphTwo}</p><p>{copy.outletParagraphThree}</p><a class="text-link" href="/pricing/">{copy.pricingLinkLabel}<Mark /></a><a class="text-link" href="/features/multi-outlet-restaurant-management/">{copy.outletMultiLinkLabel}<Mark /></a></div>
        <ul class="menu-outlet-modes" aria-label={copy.outletListLabel}>{menuLists.outletModes.map((mode, index) => <li><span>0{index + 1}</span><div><h3>{mode.title}</h3><p>{mode.description}</p></div></li>)}</ul>
      </div>
    </section>

    <section class="menu-control container" id="menu-product-example" aria-labelledby="menu-control-title">
      <div class="menu-control-copy"><p class="menu-kicker">{copy.controlKicker}</p><h2 id="menu-control-title">{copy.controlTitle}</h2><p>{copy.controlParagraphOne}</p><p>{copy.controlParagraphTwo}</p><p>{copy.controlParagraphThree}</p><a class="text-link" href="/features/kot-management/">{copy.kotLinkLabel}<Mark /></a></div>
      <div class="menu-pos-showcase"><header class="menu-pos-intro"><p class="menu-kicker">{copy.sampleKicker}</p><h3>{copy.sampleTitle}</h3><p>{copy.sampleDescription}</p></header><figure class="menu-screen menu-screen-pos">
        <figcaption><span>{copy.sampleScreenLabel}</span><span>{copy.sampleScreenDataLabel}</span></figcaption>
        <div class="menu-pos-shell"><div class="menu-pos-bezel"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-mobile.webp" width="800" height="1656"/><img src="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656" alt={imageAlt.posMenu} loading="lazy" decoding="async"/></picture></div></div>
      </figure></div>
    </section>

    <section class="menu-views container" aria-labelledby="menu-views-title">
      <header class="menu-section-heading"><p class="menu-kicker">{copy.menuViewsKicker}</p><h2 id="menu-views-title">{copy.menuViewsTitle}</h2><p>{copy.menuViewsDescription}</p></header>
      <div class="menu-view-grid">
        <figure class="menu-view-card"><h3>{copy.menuPhotoVariantTitle}</h3><div class="menu-view-frame"><div class="menu-pos-bezel"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-with-photos-mobile.webp" width="872" height="1804"/><img src="/pos-images/restabee-restaurant-pos-menu-with-photos-desktop.webp" width="1548" height="1016" alt={imageAlt.menuPhotos} loading="lazy" decoding="async"/></picture></div></div><figcaption>{copy.menuPhotoVariantCaption}</figcaption></figure>
        <figure class="menu-view-card"><h3>{copy.menuCompactVariantTitle}</h3><div class="menu-view-frame"><div class="menu-pos-bezel"><picture><source media="(min-width: 701px) and (max-width: 950px)" srcset="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656"/><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-mobile.webp" width="800" height="1656"/><img src="/pos-images/restabee-restaurant-pos-menu-desktop.webp" width="2910" height="1656" alt={imageAlt.menuCompact} loading="lazy" decoding="async"/></picture></div></div><figcaption>{copy.menuCompactVariantCaption}</figcaption></figure>
      </div>
    </section>

    <section class="menu-faq container" aria-labelledby="menu-faq-title">
      <div class="menu-faq-intro"><p class="menu-kicker">{copy.faqKicker}</p><h2 id="menu-faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div>
      <div class="menu-faq-list">{menuLists.faqs.map(({ question, answer }) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="menu-cta"><div class="container menu-cta-inner"><div><p class="menu-kicker">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a></div></section>
  </main>
  <SiteFooter />
</SiteLayout>
<style>
  .menu-page{overflow:hidden}.breadcrumbs{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.breadcrumbs a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.breadcrumbs [aria-current=page]{color:var(--ink)}
  .menu-views{padding-block:24px 82px}.menu-view-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:30px}.menu-view-card{min-width:0;padding:22px;border:1px solid #dedacd;border-radius:16px;background:#fbfaf6}.menu-view-card h3{font-size:20px;line-height:1.3}.menu-view-frame{margin-top:17px;padding:20px;border-radius:12px;background:#f1eee5}.menu-view-frame .menu-pos-bezel{border-width:7px}.menu-view-card figcaption{margin-top:15px;color:#51574e;font-size:12px;line-height:1.6}
  .menu-kicker{display:flex;align-items:center;gap:10px;color:var(--orange-ink);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.menu-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}
  .menu-hero{display:grid;grid-template-columns:minmax(320px,.78fr) minmax(0,1.22fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:66px 78px}.menu-hero h1{max-width:640px;font-size:clamp(48px,5.2vw,70px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.menu-lede{max-width:565px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.menu-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.menu-actions .button{gap:20px}
  .menu-screen{min-width:0;background:#f1eee5;border:1px solid #dedacd;border-radius:16px;padding:17px 18px 14px;box-shadow:0 22px 46px -36px #252a2480}.menu-screen figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 16px;color:#4f554c;font-size:11px}.menu-screen figcaption span:first-child{font-weight:700;color:var(--ink)}.menu-device-shell{padding-bottom:0}.menu-bezel,.menu-pos-bezel{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.menu-bezel picture,.menu-bezel img,.menu-pos-bezel picture,.menu-pos-bezel img{display:block;width:100%;height:auto}.menu-bezel img,.menu-pos-bezel img{border-radius:4px}.menu-monitor-stand{width:28%;height:24px;margin:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}.menu-monitor-stand span{display:block;width:170%;height:5px;margin:18px 0 0 -35%;background:#7c8076;border-radius:5px}
  .menu-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 88px;border-top:1px solid var(--line)}.menu-overview h2,.menu-section-heading h2,.menu-outlet h2,.menu-control h2,.menu-faq h2,.menu-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.menu-overview-body p,.menu-outlet-copy>p:not(.menu-kicker),.menu-control-copy>p:not(.menu-kicker){color:#51574e;font-size:15px;line-height:1.8}.menu-overview-body p+p,.menu-outlet-copy>p:not(.menu-kicker)+p,.menu-control-copy>p:not(.menu-kicker)+p{margin-top:13px}
  .menu-catalog{background:#252b24;color:#f6f5ef;padding-block:82px 89px}.menu-catalog .menu-kicker{color:#ffb17d}.menu-workflow .menu-kicker{color:var(--orange-ink)}.menu-outlets .menu-kicker{color:#a43e15}.menu-cta .menu-kicker{color:#96350f}.menu-section-heading{max-width:760px}.menu-section-heading>p:last-child{max-width:680px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:16px}.menu-catalog-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:42px;border-top:1px solid #60665b;border-left:1px solid #60665b}.menu-catalog-grid li{min-height:218px;padding:22px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.menu-index,.menu-workflow-list>li>span,.menu-outlet-modes>li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.07em}.menu-catalog-grid h3{font-size:20px;margin-top:32px}.menu-catalog-grid p{font-size:13px;line-height:1.75;color:#d0d4ca;margin-top:9px}
  .menu-workflow{padding-block:86px 92px}.menu-workflow .menu-section-heading>p:last-child{color:#51574e}.menu-workflow-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:38px;border-top:1px solid var(--line);border-left:1px solid var(--line)}.menu-workflow-list li{display:grid;grid-template-columns:38px 1fr;gap:15px;padding:25px 22px 27px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.menu-workflow-list>li>span{color:var(--orange-ink)}.menu-workflow-list h3{font-size:21px}.menu-workflow-list p{color:#51574e;font-size:13px;line-height:1.75;margin-top:8px}
  .menu-outlets{background:#e8ecdf;padding-block:82px}.menu-outlet-layout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(40px,7vw,94px);align-items:center}.menu-outlet-copy h2{max-width:590px}.menu-outlet-copy>p:not(.menu-kicker){max-width:580px;margin-top:17px}.menu-outlet-copy .text-link,.menu-control-copy .text-link{display:inline-flex;margin-top:22px}.menu-outlet-modes{list-style:none;border-top:1px solid #c8cebd}.menu-outlet-modes li{display:grid;grid-template-columns:38px 1fr;gap:15px;padding:20px 0;border-bottom:1px solid #c8cebd}.menu-outlet-modes>li>span{color:#a43e15}.menu-outlet-modes h3{font-size:20px}.menu-outlet-modes p{color:#454c42;font-size:13px;line-height:1.75;margin-top:6px}
  .menu-control{display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:88px}.menu-control-copy h2{max-width:590px}.menu-control-copy h2+p:not(.menu-kicker){margin-top:18px}.menu-pos-intro h3{font-size:clamp(25px,2.8vw,34px);line-height:1.15;letter-spacing:-.03em;margin-top:11px}.menu-pos-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:11px}.menu-screen-pos{margin-top:clamp(40px,4vw,56px);padding:16px;background:#fbfaf6}.menu-pos-shell{padding:0 4px 4px}.menu-pos-bezel{border-width:7px}.menu-faq{display:grid;grid-template-columns:minmax(230px,.7fr) minmax(0,1.3fr);gap:clamp(36px,7vw,84px);padding-block:82px}.menu-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:14px}.menu-faq-list{border-top:1px solid var(--line)}.menu-faq-list details{border-bottom:1px solid var(--line)}.menu-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:66px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.menu-faq-list summary::-webkit-details-marker{display:none}.menu-faq-list summary span{font-size:24px;font-weight:400;color:var(--orange-ink);flex:none;transition:transform .18s}.menu-faq-list details[open] summary span{transform:rotate(45deg)}.menu-faq-list details>p{padding:0 36px 20px 0;color:#51574e;font-size:13px;line-height:1.8}
  .menu-cta{background:#f0caa8;padding-block:62px}.menu-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.menu-cta h2{max-width:660px}.menu-cta-inner>div>p:last-child{max-width:540px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.menu-cta .button{flex:none}
  @media(max-width:1100px){.menu-hero{grid-template-columns:minmax(280px,.75fr) minmax(0,1.25fr);gap:34px}.menu-monitor-stand{display:none}.menu-catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:950px){.menu-hero{grid-template-columns:1fr;padding-block:56px 66px}.menu-hero-copy{max-width:750px}.menu-hero h1{max-width:740px;font-size:clamp(49px,8vw,68px)}.menu-overview,.menu-outlet-layout,.menu-control{grid-template-columns:1fr;gap:30px}.menu-overview{padding-block:60px}.menu-outlet-layout{gap:32px}.menu-control{padding-block:65px}.menu-pos-bezel{max-width:820px;margin:auto}.menu-faq{gap:37px}.menu-view-grid{gap:16px}.menu-view-card{padding:17px}.menu-view-frame{padding:13px}}
  @media(max-width:700px){.breadcrumbs{padding-top:14px;font-size:10px;gap:7px}.menu-hero{padding-block:43px 54px;gap:26px}.menu-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.menu-lede{font-size:14px;margin-top:16px}.menu-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.menu-actions .button{width:100%;justify-content:space-between}.menu-screen{padding:13px 11px 12px;border-radius:13px}.menu-screen figcaption{font-size:9px;gap:8px;margin-bottom:11px}.menu-bezel{max-width:310px;margin-inline:auto;padding:6px;border-width:2px;border-radius:25px}.menu-bezel img{border-radius:18px}.menu-overview{padding-block:52px 59px;gap:22px}.menu-overview h2,.menu-section-heading h2,.menu-outlet h2,.menu-control h2,.menu-faq h2,.menu-cta h2{font-size:clamp(35px,9vw,46px)}.menu-overview-body p,.menu-outlet-copy>p:not(.menu-kicker),.menu-control-copy>p:not(.menu-kicker){font-size:14px}.menu-catalog{padding-block:59px 63px}.menu-section-heading>p:last-child{font-size:14px}.menu-catalog-grid{grid-template-columns:1fr;margin-top:27px}.menu-catalog-grid li{min-height:0;padding:18px}.menu-catalog-grid h3{font-size:19px;margin-top:13px}.menu-catalog-grid p{font-size:13px}.menu-workflow{padding-block:59px 64px}.menu-workflow-list{grid-template-columns:1fr;margin-top:26px}.menu-workflow-list li{padding:18px 14px;gap:9px}.menu-workflow-list h3{font-size:19px}.menu-workflow-list p{font-size:13px}.menu-outlets{padding-block:59px}.menu-outlet-layout{gap:24px}.menu-outlet-copy>p:not(.menu-kicker){font-size:14px}.menu-outlet-modes li{padding:17px 0}.menu-outlet-modes h3{font-size:18px}.menu-control{padding-block:59px;gap:27px}.menu-control-copy>p:not(.menu-kicker){font-size:14px}.menu-control-copy h2+p:not(.menu-kicker){margin-top:16px}.menu-pos-intro h3{font-size:24px}.menu-screen-pos{margin-top:28px;padding:12px 10px;border-radius:13px}.menu-pos-shell{padding:0}.menu-pos-bezel{max-width:310px;margin:auto;padding:6px;border-width:2px;border-radius:25px}.menu-pos-bezel img{border-radius:18px}.menu-view-grid{grid-template-columns:1fr;gap:20px;margin-top:24px}.menu-view-card{padding:16px}.menu-view-frame{margin-top:14px;padding:14px 10px}.menu-view-frame .menu-pos-bezel{max-width:310px;margin:auto;padding:6px;border-width:2px;border-radius:25px}.menu-view-frame .menu-pos-bezel img{border-radius:18px}.menu-views{padding-block:10px 58px}.menu-faq{grid-template-columns:1fr;gap:20px;padding-block:59px}.menu-faq-list summary{min-height:61px;font-size:13px}.menu-faq-list details>p{font-size:12px}.menu-cta{padding-block:50px}.menu-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.menu-cta-inner>div>p:last-child{font-size:13px}.menu-cta .button{width:100%;justify-content:space-between}}
  @media(prefers-reduced-motion:reduce){.menu-faq-list summary span{transition:none}.menu-faq-list details[open] summary span{transform:none}}
</style>
