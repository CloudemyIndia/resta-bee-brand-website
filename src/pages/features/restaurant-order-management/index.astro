---
import { getEntry } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const entry = await getEntry('pages', 'restaurant-order-management');
if (!entry) throw new Error('CMS content entry "restaurant-order-management" is missing.');
const { seo, copy, orderLists, imageAlt } = entry.data;
if (!orderLists?.orderTypes.length || !orderLists.workflowSteps.length || !orderLists.faqs.length || !imageAlt?.orderManagement) {
  throw new Error('Order management page content is incomplete.');
}
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Android, iOS, macOS, Windows' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
    { '@type': 'ListItem', position: 2, name: 'Restaurant order management', item: seo.canonical },
  ] },
};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="order-page">
    <nav class="order-breadcrumb container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>

    <section class="order-hero container" aria-labelledby="order-title">
      <div class="order-hero-copy">
        <p class="order-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="order-title">{copy.heroTitle}</h1>
        <p class="order-lede">{copy.heroDescription}</p>
        <div class="order-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#order-workflow">{copy.workflowCta}<Mark name="down" /></a></div>
      </div>
      <figure class="order-screen">
        <figcaption><span>{copy.screenLabel}</span><span>{copy.screenDataLabel}</span></figcaption>
        <div class="order-monitor"><div class="order-bezel"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-mobile.webp" width="800" height="1656"/><source media="(max-width: 1100px)" srcset="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656"/><img src="/pos-images/restabee-restaurant-pos-menu-desktop.webp" width="2910" height="1656" alt={imageAlt.orderManagement} fetchpriority="high" decoding="async"/></picture></div><div class="order-stand" aria-hidden="true"></div></div>
        <p>{copy.screenCaption}</p>
      </figure>
    </section>

    <section class="order-overview container" aria-labelledby="order-overview-title">
      <div><p class="order-kicker">{copy.overviewKicker}</p><h2 id="order-overview-title">{copy.overviewTitle}</h2></div>
      <div class="order-overview-copy"><p>{copy.overviewParagraphOne}</p><p>{copy.overviewParagraphTwo}</p><p>{copy.overviewParagraphThree}</p></div>
    </section>

    <section class="order-types" aria-labelledby="order-types-title">
      <div class="container">
        <header class="order-section-heading"><p class="order-kicker">{copy.typesKicker}</p><h2 id="order-types-title">{copy.typesTitle}</h2><p>{copy.typesDescription}</p></header>
        <ul class="order-type-grid" aria-label={copy.orderTypesListLabel}>{orderLists.orderTypes.map((type, index) => <li><span>0{index + 1}</span><h3>{type.title}</h3><p>{type.description}</p></li>)}</ul>
      </div>
    </section>

    <section class="order-customize container" aria-labelledby="order-customize-title">
      <div class="order-customize-heading"><p class="order-kicker">{copy.customizeKicker}</p><h2 id="order-customize-title">{copy.customizeTitle}</h2></div>
      <div class="order-customize-copy"><p>{copy.customizeParagraphOne}</p><p>{copy.customizeParagraphTwo}</p><a class="text-link" href="/features/restaurant-menu-management/">{copy.menuLinkLabel}<Mark /></a></div>
    </section>

    <section class="order-workflow" id="order-workflow" aria-labelledby="order-workflow-title">
      <div class="container">
        <header class="order-section-heading"><p class="order-kicker">{copy.reviewKicker}</p><h2 id="order-workflow-title">{copy.reviewTitle}</h2><p>{copy.reviewParagraphOne}</p><p>{copy.reviewParagraphTwo}</p></header>
        <ol class="order-workflow-list" aria-label={copy.workflowListLabel}>{orderLists.workflowSteps.map((step) => <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="order-changes"><div class="container order-changes-inner"><div><p class="order-kicker">{copy.changesKicker}</p><h2>{copy.changesTitle}</h2><p>{copy.changesDescription}</p></div><a class="text-link" href="/features/kot-management/">{copy.kotLinkLabel}<Mark /></a></div></section>

    <section class="order-billing container" aria-labelledby="order-billing-title">
      <div class="order-billing-heading"><p class="order-kicker">{copy.billKicker}</p><h2 id="order-billing-title">{copy.billTitle}</h2></div>
      <div class="order-billing-copy"><p>{copy.billParagraphOne}</p><p>{copy.billParagraphTwo}</p><a class="text-link" href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a></div>
    </section>

    <section class="order-faq container" aria-labelledby="order-faq-title">
      <div class="order-faq-intro"><p class="order-kicker">{copy.faqKicker}</p><h2 id="order-faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div>
      <div class="order-faq-list">{orderLists.faqs.map(({ question, answer }) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="order-cta"><div class="container order-cta-inner"><div><p class="order-kicker">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a></div></section>
  </main>
  <SiteFooter />
</SiteLayout>
<style>
  .order-page{overflow:hidden}.order-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.order-breadcrumb a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.order-breadcrumb [aria-current=page]{color:var(--ink)}
  .order-kicker{display:flex;align-items:center;gap:10px;color:var(--orange-ink);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.order-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}
  .order-hero{display:grid;grid-template-columns:minmax(310px,.78fr) minmax(0,1.22fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:66px 78px}.order-hero h1{max-width:610px;font-size:clamp(49px,5.3vw,72px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.order-lede{max-width:565px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.order-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.order-actions .button{gap:20px}
  .order-screen{min-width:0;padding:17px 18px 14px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.order-screen figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 16px;color:#4f554c;font-size:11px}.order-screen figcaption span:first-child{font-weight:700;color:var(--ink)}.order-bezel{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.order-bezel picture,.order-bezel img{display:block;width:100%;height:auto}.order-bezel img{border-radius:4px}.order-stand{width:28%;height:24px;margin:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}
  .order-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 86px;border-top:1px solid var(--line)}.order-overview h2,.order-section-heading h2,.order-customize h2,.order-changes h2,.order-billing h2,.order-faq h2,.order-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.order-overview-copy p,.order-customize-copy p,.order-billing-copy p{color:#51574e;font-size:15px;line-height:1.8}.order-overview-copy p+p,.order-customize-copy p+p,.order-billing-copy p+p{margin-top:13px}
  .order-types{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.order-types .order-kicker,.order-workflow .order-kicker{color:#ffb17d}.order-section-heading{max-width:760px}.order-section-heading>p:not(.order-kicker){max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:15px}.order-type-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;margin-top:38px;border-top:1px solid #60665b;border-left:1px solid #60665b}.order-type-grid li{min-height:220px;padding:23px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.order-type-grid li>span,.order-workflow-list li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.08em}.order-type-grid h3{font-size:23px;margin-top:30px}.order-type-grid p{max-width:340px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}
  .order-customize{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:86px}.order-customize-heading h2{max-width:530px}.order-customize-copy>p:first-child{margin-top:33px}.order-customize-copy .text-link,.order-billing-copy .text-link{display:inline-flex;margin-top:22px}
  .order-workflow{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.order-workflow .order-section-heading>p:not(.order-kicker){color:#d0d4ca}.order-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:39px;border-top:1px solid #60665b}.order-workflow-list li{min-height:220px;padding:21px 20px 0 0;border-right:1px solid #60665b}.order-workflow-list li+li{padding-left:21px}.order-workflow-list li:last-child{border-right:0}.order-workflow-list h3{font-size:20px;line-height:1.25;margin-top:25px}.order-workflow-list p{color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:9px}
  .order-changes{padding-block:67px;background:#e8ecdf}.order-changes-inner{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:30px;align-items:end}.order-changes .order-kicker{color:#a43e15}.order-changes h2{max-width:670px;margin-top:8px}.order-changes-inner>div>p:last-child{max-width:730px;color:#42493f;font-size:15px;line-height:1.8;margin-top:16px}.order-changes .text-link{display:inline-flex;white-space:nowrap;margin-bottom:5px}
  .order-billing{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:86px}.order-faq{display:grid;grid-template-columns:minmax(220px,.72fr) minmax(0,1.28fr);gap:clamp(36px,7vw,88px);padding-block:82px}.order-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:15px}.order-faq-list details{border-top:1px solid var(--line)}.order-faq-list details:last-child{border-bottom:1px solid var(--line)}.order-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:64px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.order-faq-list summary::-webkit-details-marker{display:none}.order-faq-list summary span{font-size:24px;font-weight:400;color:var(--orange-ink);flex:none;transition:transform .18s}.order-faq-list details[open] summary span{transform:rotate(45deg)}.order-faq-list details>p{padding:0 35px 19px 0;color:#51574e;font-size:13px;line-height:1.8}
  .order-cta{padding-block:62px;background:#f0caa8}.order-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.order-cta .order-kicker{color:#783516}.order-cta h2{max-width:700px}.order-cta-inner>div>p:last-child{max-width:570px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.order-cta .button{flex:none}
  @media(max-width:1050px){.order-hero{grid-template-columns:minmax(280px,.78fr) minmax(0,1.22fr);gap:34px}.order-type-grid{grid-template-columns:1fr}.order-type-grid li{min-height:0}.order-type-grid h3{margin-top:18px}.order-workflow-list{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:25px}.order-workflow-list li:nth-child(2){border-right:0}.order-workflow-list li:nth-child(3){padding-left:0}.order-workflow-list li{min-height:190px}}
  @media(max-width:950px){.order-hero{grid-template-columns:1fr;padding-block:56px 66px}.order-hero-copy{max-width:750px}.order-hero h1{max-width:740px;font-size:clamp(49px,8vw,68px)}.order-overview,.order-customize,.order-billing{grid-template-columns:1fr;gap:30px}.order-overview{padding-block:60px}.order-customize,.order-billing{padding-block:65px}.order-faq{gap:37px}.order-screen{max-width:850px;width:100%;margin-inline:auto}}
  @media(max-width:700px){.order-breadcrumb{padding-top:14px;font-size:10px;gap:7px}.order-hero{padding-block:43px 54px;gap:26px}.order-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.order-lede{font-size:14px;margin-top:16px}.order-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.order-actions .button{width:100%;justify-content:space-between}.order-screen{padding:13px 11px 12px;border-radius:13px}.order-screen figcaption{font-size:9px;gap:8px;margin-bottom:11px}.order-bezel{max-width:310px;margin-inline:auto;padding:6px;border-width:2px;border-radius:25px}.order-bezel img{border-radius:18px}.order-overview{padding-block:52px 59px;gap:22px}.order-overview h2,.order-section-heading h2,.order-customize h2,.order-changes h2,.order-billing h2,.order-faq h2,.order-cta h2{font-size:clamp(35px,9vw,46px)}.order-overview-copy p,.order-customize-copy p,.order-billing-copy p{font-size:14px}.order-types,.order-workflow{padding-block:59px 64px}.order-section-heading>p:not(.order-kicker){font-size:14px}.order-type-grid{margin-top:27px}.order-type-grid li{padding:18px}.order-type-grid h3{font-size:19px;margin-top:13px}.order-type-grid p,.order-workflow-list p{font-size:13px}.order-customize,.order-billing{padding-block:59px;gap:24px}.order-customize-copy>p:first-child{margin-top:0}.order-workflow-list{grid-template-columns:1fr;margin-top:28px;row-gap:0}.order-workflow-list li,.order-workflow-list li+li{min-height:0;padding:17px 0;border-right:0;border-bottom:1px solid #60665b}.order-workflow-list li:last-child{border-bottom:0}.order-workflow-list h3{font-size:19px;margin-top:10px}.order-changes{padding-block:56px}.order-changes-inner{grid-template-columns:1fr;gap:21px}.order-changes-inner>div>p:last-child{font-size:14px}.order-changes .text-link{margin-bottom:0}.order-faq{grid-template-columns:1fr;gap:21px;padding-block:59px}.order-faq-list summary{min-height:61px;font-size:13px}.order-faq-list details>p{font-size:12px}.order-cta{padding-block:50px}.order-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.order-cta-inner>div>p:last-child{font-size:13px}.order-cta .button{width:100%;justify-content:space-between}}
  @media(prefers-reduced-motion:reduce){.order-faq-list summary span{transition:none}.order-faq-list details[open] summary span{transform:none}}
</style>
