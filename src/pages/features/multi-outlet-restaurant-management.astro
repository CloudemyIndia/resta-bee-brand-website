---
import { getEntry } from 'astro:content';
import Mark from '../../components/Mark.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entry = await getEntry('pages', 'multi-outlet-restaurant-management');
if (!entry) throw new Error('CMS content entry "multi-outlet-restaurant-management" is missing.');
const { seo, copy, multiOutletLists, imageAlt } = entry.data;
if (!multiOutletLists) throw new Error('Multi-outlet page content validation failed.');
if (!imageAlt?.centralMenu || !imageAlt?.reports) throw new Error('Multi-outlet page requires descriptive central-menu and reports screenshot alt text.');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Android, iOS, macOS, Windows' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
    { '@type': 'ListItem', position: 2, name: 'Multi-outlet restaurant management', item: seo.canonical },
  ] },
};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="outlet-page">
    <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href="/">{copy.breadcrumbLinkLabel}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>
    <section class="outlet-hero container" aria-labelledby="outlet-title">
      <div class="outlet-hero-copy"><p class="outlet-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p><h1 id="outlet-title">{copy.heroTitle}</h1><p class="outlet-lede">{copy.heroDescription}</p><div class="outlet-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#outlet-workflow">{copy.workflowCta}<Mark name="down" /></a></div></div>
      <figure class="outlet-screen"><figcaption><span>{copy.screenLabel}</span><span>{copy.screenDataLabel}</span></figcaption><div class="outlet-device"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-central-menu-mobile.webp" width="880" height="1656"/><img src="/pos-images/restabee-restaurant-pos-central-menu-desktop.webp" width="2106" height="1656" alt={imageAlt.centralMenu} loading="eager" decoding="async" fetchpriority="high"/></picture></div></figure>
    </section>

    <section class="outlet-overview container" aria-labelledby="overview-title"><div><p class="outlet-kicker">{copy.overviewKicker}</p><h2 id="overview-title">{copy.overviewTitle}</h2></div><div class="outlet-copy"><p>{copy.overviewParagraphOne}</p><p>{copy.overviewParagraphTwo}</p><p>{copy.overviewParagraphThree}</p></div></section>

    <section class="outlet-workflow" id="outlet-workflow" aria-labelledby="workflow-title"><div class="container"><header class="outlet-section-heading"><p class="outlet-kicker">{copy.workflowKicker}</p><h2 id="workflow-title">{copy.workflowTitle}</h2><p>{copy.workflowDescription}</p></header><ol class="outlet-workflow-list">{multiOutletLists.workflowSteps.map((step) => <li><span>{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></div></section>

    <section class="outlet-operating container" aria-labelledby="operating-title"><div class="outlet-operating-copy"><p class="outlet-kicker">{copy.operatingKicker}</p><h2 id="operating-title">{copy.operatingTitle}</h2><p>{copy.operatingIntro}</p><p>{copy.operatingDetailOne}</p><p>{copy.operatingDetailTwo}</p><p>{copy.operatingDetailThree}</p><p>{copy.operatingDetailFour}</p><a class="text-link" href="/features/restaurant-menu-management/">{copy.menuLinkLabel}<Mark /></a></div><ul class="outlet-parts">{multiOutletLists.operatingParts.map((part, index) => <li><span>0{index + 1}</span><div><h3>{part.title}</h3><p>{part.description}</p></div></li>)}</ul></section>

    <section class="outlet-scenario" aria-labelledby="scenario-title"><div class="container outlet-scenario-grid"><div class="outlet-scenario-copy"><p class="outlet-kicker">{copy.scenarioKicker}</p><h2 id="scenario-title">{copy.scenarioTitle}</h2><p>{copy.scenarioIntro}</p><p>{copy.scenarioDetail}</p><p>{copy.scenarioClosing}</p></div><ol class="outlet-scenario-steps">{multiOutletLists.scenarioSteps.map((step, index) => <li><span>0{index + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></div></section>

    <section class="outlet-reports container" aria-labelledby="reports-title"><div class="outlet-reports-copy"><p class="outlet-kicker">{copy.reportScreenLabel}</p><h2 id="reports-title">{copy.reportScreenTitle}</h2><p>{copy.reportScreenDescription}</p><p>{copy.limitsBodyOne}</p><p>{copy.limitsBodyTwo}</p><p>{copy.limitsBodyThree}</p><a class="text-link" href="/pricing/">{copy.pricingLinkLabel}<Mark /></a></div><figure class="outlet-phone"><figcaption><span>{copy.reportScreenLabel}</span><span>{copy.reportScreenDataLabel}</span></figcaption><div class="outlet-phone-bezel"><img src="/pos-images/restabee-pos-reports-mobile.webp" width="880" height="1656" alt={imageAlt.reports} loading="lazy" decoding="async"/></div></figure></section>

    <section class="outlet-faq container" aria-labelledby="faq-title"><div class="outlet-faq-intro"><p class="outlet-kicker">{copy.faqKicker}</p><h2 id="faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div><div class="outlet-faq-list">{multiOutletLists.faqs.map(({ question, answer }) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>

    <section class="outlet-cta"><div class="container outlet-cta-inner"><div><p class="outlet-kicker">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a></div></section>
  </main>
  <SiteFooter />
</SiteLayout>
<style>
  .outlet-page{overflow:hidden}.breadcrumbs{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.breadcrumbs a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.breadcrumbs [aria-current=page]{color:var(--ink)}
  .outlet-kicker{display:flex;align-items:center;gap:10px;color:var(--orange-ink);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.outlet-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}
  .outlet-hero{display:grid;grid-template-columns:minmax(310px,.82fr) minmax(0,1.18fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:65px 76px}.outlet-hero h1{max-width:650px;font-size:clamp(46px,5.1vw,68px);line-height:1.045;letter-spacing:-.045em;margin-top:20px}.outlet-lede{max-width:565px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.outlet-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.outlet-actions .button{gap:18px}.outlet-screen{min-width:0;padding:17px 18px 16px;background:#f1eee5;border:1px solid #dedacd;border-radius:16px;box-shadow:0 22px 46px -36px #252a2480}.outlet-screen figcaption,.outlet-phone figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 12px;color:#4f554c;font-size:11px}.outlet-screen figcaption span:first-child,.outlet-phone figcaption span:first-child{font-weight:700;color:var(--ink)}.outlet-device{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.outlet-device picture,.outlet-device img{display:block;width:100%;height:auto}.outlet-device img{border-radius:4px}
  .outlet-overview{display:grid;grid-template-columns:minmax(280px,.75fr) minmax(0,1.25fr);gap:clamp(40px,7vw,92px);padding-block:73px 85px;border-top:1px solid var(--line)}.outlet-overview h2,.outlet-operating h2,.outlet-scenario h2,.outlet-reports h2,.outlet-faq h2,.outlet-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.outlet-copy p,.outlet-operating-copy>p:not(.outlet-kicker),.outlet-scenario-copy>p:not(.outlet-kicker),.outlet-reports-copy>p:not(.outlet-kicker){color:#51574e;font-size:15px;line-height:1.85}.outlet-copy p+p,.outlet-operating-copy>p:not(.outlet-kicker)+p,.outlet-scenario-copy>p:not(.outlet-kicker)+p,.outlet-reports-copy>p:not(.outlet-kicker)+p{margin-top:14px}
  .outlet-workflow{background:#252b24;color:#f6f5ef;padding-block:79px 85px}.outlet-workflow .outlet-kicker{color:#ffb17d}.outlet-section-heading{max-width:760px}.outlet-section-heading>p:last-child{max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:16px}.outlet-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:40px;border-top:1px solid #60665b}.outlet-workflow-list li{min-height:220px;padding:21px 20px 0 0;border-right:1px solid #60665b}.outlet-workflow-list li+li{padding-left:22px}.outlet-workflow-list li:last-child{border-right:0}.outlet-workflow-list li>span,.outlet-parts li>span,.outlet-scenario-steps li>span{font-size:11px;font-weight:700;letter-spacing:.06em;color:#a43e15}.outlet-workflow-list li>span{color:#ffb17d}.outlet-workflow-list h3{font-size:21px;line-height:1.25;margin-top:25px}.outlet-workflow-list p{max-width:245px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}
  .outlet-operating{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:clamp(42px,7vw,95px);align-items:start;padding-block:87px}.outlet-operating-copy h2{max-width:680px}.outlet-operating-copy>p:not(.outlet-kicker){margin-top:17px}.outlet-operating-copy .text-link,.outlet-reports-copy .text-link{display:inline-flex;margin-top:22px}.outlet-parts{list-style:none;border-top:1px solid var(--line)}.outlet-parts li,.outlet-scenario-steps li{display:grid;grid-template-columns:35px 1fr;gap:14px;padding:22px 0;border-bottom:1px solid var(--line)}.outlet-parts h3,.outlet-scenario-steps h3{font-size:20px;line-height:1.3}.outlet-parts p,.outlet-scenario-steps p{color:#51574e;font-size:13px;line-height:1.75;margin-top:7px}
  .outlet-scenario{background:#e8ecdf;padding-block:81px}.outlet-scenario .outlet-kicker,.outlet-cta .outlet-kicker{color:#82300d}.outlet-scenario-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(40px,7vw,90px);align-items:start}.outlet-scenario-copy h2{max-width:600px}.outlet-scenario-copy>p:not(.outlet-kicker){margin-top:17px}.outlet-scenario-steps{list-style:none;border-top:1px solid #c8cebd}.outlet-scenario-steps li{border-color:#c8cebd}.outlet-scenario-steps li>span{color:#a43e15}
  .outlet-reports{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.7fr);gap:clamp(48px,8vw,110px);align-items:center;padding-block:87px}.outlet-reports-copy h2{max-width:650px}.outlet-phone{max-width:340px;justify-self:center;width:100%;padding:15px;background:#f1eee5;border:1px solid #dedacd;border-radius:17px;box-shadow:0 22px 46px -36px #252a2480}.outlet-phone figcaption{font-size:10px}.outlet-phone-bezel{max-width:220px;margin-inline:auto;padding:6px;overflow:hidden;border:3px solid #252a24;border-radius:27px;background:#252a24}.outlet-phone-bezel img{display:block;width:100%;height:auto;border-radius:20px}
  .outlet-faq{display:grid;grid-template-columns:minmax(230px,.7fr) minmax(0,1.3fr);gap:clamp(36px,7vw,84px);padding-block:82px}.outlet-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:14px}.outlet-faq-list{border-top:1px solid var(--line)}.outlet-faq-list details{border-bottom:1px solid var(--line)}.outlet-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:66px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.outlet-faq-list summary::-webkit-details-marker{display:none}.outlet-faq-list summary span{font-size:24px;font-weight:400;color:var(--orange-ink);flex:none;transition:transform .18s}.outlet-faq-list details[open] summary span{transform:rotate(45deg)}.outlet-faq-list details>p{padding:0 36px 20px 0;color:#51574e;font-size:13px;line-height:1.8}
  .outlet-cta{background:#f0caa8;padding-block:62px}.outlet-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.outlet-cta h2{max-width:660px}.outlet-cta-inner>div>p:last-child{max-width:540px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.outlet-cta .button{flex:none}
  @media(max-width:950px){.outlet-hero{grid-template-columns:1fr;padding-block:54px 65px}.outlet-hero-copy{max-width:760px}.outlet-hero h1{max-width:760px}.outlet-overview,.outlet-operating,.outlet-scenario-grid,.outlet-reports{grid-template-columns:1fr;gap:30px}.outlet-overview{padding-block:60px}.outlet-operating{padding-block:65px}.outlet-scenario{padding-block:62px}.outlet-reports{padding-block:63px}.outlet-phone{max-width:400px}}
  @media(max-width:700px){.breadcrumbs{padding-top:14px;font-size:10px;gap:7px}.outlet-hero{padding-block:43px 54px;gap:26px}.outlet-hero h1{font-size:clamp(42px,10.5vw,57px);margin-top:17px}.outlet-lede{font-size:14px;margin-top:16px}.outlet-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.outlet-actions .button{width:100%;justify-content:space-between}.outlet-screen{padding:13px 11px;border-radius:13px}.outlet-screen figcaption{font-size:9px;gap:8px;margin-bottom:11px}.outlet-device{border-width:4px;border-radius:10px}.outlet-overview{grid-template-columns:1fr;padding-block:52px 59px;gap:22px}.outlet-overview h2,.outlet-operating h2,.outlet-scenario h2,.outlet-reports h2,.outlet-faq h2,.outlet-cta h2{font-size:clamp(35px,9vw,46px)}.outlet-copy p,.outlet-operating-copy>p:not(.outlet-kicker),.outlet-scenario-copy>p:not(.outlet-kicker),.outlet-reports-copy>p:not(.outlet-kicker){font-size:14px}.outlet-workflow{padding-block:59px 64px}.outlet-section-heading>p:last-child{font-size:14px}.outlet-workflow-list{grid-template-columns:1fr;margin-top:26px}.outlet-workflow-list li{min-height:0;padding:18px 0;border-right:0;border-bottom:1px solid #60665b}.outlet-workflow-list li+li{padding-left:0}.outlet-workflow-list h3{font-size:19px;margin-top:10px}.outlet-workflow-list p{max-width:none;font-size:13px}.outlet-operating{padding-block:59px;gap:25px}.outlet-parts li,.outlet-scenario-steps li{padding:17px 0}.outlet-parts h3,.outlet-scenario-steps h3{font-size:18px}.outlet-scenario{padding-block:58px}.outlet-scenario-grid{gap:22px}.outlet-reports{padding-block:59px;gap:23px}.outlet-phone{max-width:350px;padding:12px}.outlet-phone-bezel{max-width:220px}.outlet-faq{grid-template-columns:1fr;gap:20px;padding-block:59px}.outlet-faq-list summary{min-height:61px;font-size:13px}.outlet-faq-list details>p{font-size:12px}.outlet-cta{padding-block:50px}.outlet-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.outlet-cta-inner>div>p:last-child{font-size:13px}.outlet-cta .button{width:100%;justify-content:space-between}}
  @media(prefers-reduced-motion:reduce){.outlet-faq-list summary span{transition:none}.outlet-faq-list details[open] summary span{transform:none}}
</style>
