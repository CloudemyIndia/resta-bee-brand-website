---
import { getEntry } from 'astro:content';
import Mark from '../../components/Mark.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import DemoLeadForm from '../../components/DemoLeadForm.astro';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('CMS content entry "contact" is missing.');
const { seo, copy, faqs, imageAlt } = entry.data;
if (!faqs.length || !copy.emailValue || !copy.phoneValue || !copy.addressValue || !imageAlt?.contactPosMenu) throw new Error('RestaBee contact page content is incomplete.');
const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) throw new Error('CMS content entry "home" is missing for the shared demo form.');
const apiBaseUrl = (import.meta.env.PUBLIC_API_BASE_URL || (import.meta.env.DEV ? 'http://127.0.0.1:3007' : 'https://api.restabee.com')).replace(/\/+$/, '');
const phoneHref = `tel:+${copy.phoneValue.replace(/\D/g, '')}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  mainEntity: {
    '@type': 'Organization',
    name: 'RestaBee',
    parentOrganization: { '@type': 'Organization', name: 'Cloudemy Digital Technologies Pvt. Ltd.' },
    email: copy.emailValue,
    telephone: `+${copy.phoneValue.replace(/\D/g, '')}`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Diamond City Plaza, B-2/23, Sector F, Jankipuram',
      addressLocality: 'Lucknow',
      addressRegion: 'Uttar Pradesh',
      postalCode: '226021',
      addressCountry: 'IN'
    }
  },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact RestaBee', item: seo.canonical }
  ] }
};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="contact-page">
    <nav class="contact-breadcrumb container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>

    <section class="contact-hero container" aria-labelledby="contact-title">
      <div class="contact-hero-copy">
        <p class="contact-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="contact-title">{copy.heroTitle}</h1>
        <p class="contact-lede">{copy.heroDescription}</p>
        <div class="contact-direct">
          <h2>{copy.contactDetailsTitle}</h2>
          <a href={`mailto:${copy.emailValue}`}><Mark name="mail" />{copy.emailValue}</a>
          <a href={phoneHref}><Mark name="phone" />{copy.phoneValue}</a>
        </div>
        <p class="contact-company-note">{copy.companyDescription} <a href="https://cloudemy.in/" rel="external">{copy.companyLinkLabel}<Mark /></a></p>
      </div>
      <section class="contact-form-wrap" aria-labelledby="contact-form-title">
        <DemoLeadForm apiBaseUrl={apiBaseUrl} submitLabel={homeEntry.data.copy.formSubmit} privacyNotice={homeEntry.data.copy.formPrivacy} heading={copy.formHeading} headingId="contact-form-title" introduction={copy.formIntroduction} />
      </section>
    </section>

    <section class="contact-product" aria-labelledby="contact-demo-title"><div class="container contact-product-inner">
      <div class="contact-product-copy"><p class="contact-kicker"><span aria-hidden="true"></span>{copy.demoLabel}</p><h2 id="contact-demo-title">{copy.demoTitle}</h2><p>{copy.demoDescription}</p><div class="contact-topic-grid">
        <article><h3>{copy.salesTitle}</h3><p>{copy.salesDescription}</p><a href="/pricing/">View pricing <Mark /></a></article>
        <article><h3>{copy.supportTitle}</h3><p>{copy.supportDescription}</p><a href={`mailto:${copy.emailValue}`}>{copy.emailValue}<Mark /></a></article>
      </div></div>
      <figure class="contact-product-screen"><figcaption><span>RestaBee POS menu · phone</span><span>Sample restaurant data</span></figcaption><div class="contact-phone-frame"><img src="/pos-images/restabee-restaurant-pos-menu-mobile.webp" width="800" height="1656" alt={imageAlt.contactPosMenu} loading="lazy" decoding="async" /></div></figure>
    </div></section>

    <section class="contact-company" aria-labelledby="contact-company-title"><div class="container contact-company-inner"><div><p class="contact-kicker"><span aria-hidden="true"></span>{copy.companyKicker}</p><h2 id="contact-company-title">{copy.companyTitle}</h2></div><address><span>{copy.addressLabel}</span><p>{copy.addressValue}</p></address></div></section>

    <section class="contact-faq container" aria-labelledby="contact-faq-title">
      <div class="contact-faq-intro"><p class="contact-kicker">{copy.faqKicker}</p><h2 id="contact-faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div>
      <div class="contact-faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>

  </main>
  <SiteFooter />
</SiteLayout>
<style>
.contact-page{overflow:hidden}.contact-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:18px;color:var(--muted);font-size:12px}.contact-breadcrumb a{text-decoration:underline;text-underline-offset:3px}.contact-breadcrumb [aria-current=page]{color:var(--ink)}
.contact-kicker{display:flex;align-items:center;gap:9px;color:#963b18;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.contact-kicker>span{width:7px;height:7px;flex:none;border-radius:50%;background:var(--orange)}
.contact-hero{display:grid;grid-template-columns:minmax(0,.9fr) minmax(470px,1.1fr);align-items:center;gap:clamp(42px,6vw,86px);padding-block:44px 78px}.contact-hero h1{max-width:620px;margin-top:17px;font-size:clamp(48px,5.3vw,70px);line-height:1.03;letter-spacing:-.048em;text-wrap:balance}.contact-lede{max-width:540px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.75}.contact-direct{display:grid;grid-template-columns:1fr 1fr;gap:10px 22px;margin-top:32px;padding-top:20px;border-top:1px solid var(--line)}.contact-direct h2{grid-column:1/-1;font-family:var(--body);font-size:12px;font-weight:650;letter-spacing:.01em}.contact-direct a{display:inline-flex;align-items:center;gap:9px;min-height:35px;color:#81320f;font-size:13px;font-weight:650;overflow-wrap:anywhere}.contact-direct .icon{width:17px;height:17px;flex:none}.contact-company-note{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;margin-top:22px;color:#62665d;font-size:11px;line-height:1.7}.contact-company-note a{display:inline-flex;align-items:center;gap:5px;color:#81320f;font-weight:650;text-decoration:underline;text-underline-offset:3px}
.contact-form-wrap{min-width:0;padding:15px;border:1px solid #e2ddcf;border-radius:21px;background:#f0eee6;box-shadow:0 23px 54px -44px #24282080}.contact-form-wrap .enquiry-panel{padding:27px 28px;border:1px solid #e4e1d7;border-radius:15px;background:#fffefa;box-shadow:0 10px 30px -29px #252a2490}.contact-form-wrap .enquiry-panel>h3{font-size:26px;line-height:1.15}.contact-form-wrap .form-intro{margin-top:7px;margin-bottom:19px;font-size:13px;line-height:1.6}.contact-form-wrap .form-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.contact-form-wrap .form-field{margin-bottom:13px;gap:6px}.contact-form-wrap .form-field label{font-size:11px}.contact-form-wrap .form-field input,.contact-form-wrap .form-field select,.contact-form-wrap .form-field textarea{min-height:42px;padding:9px 11px;font-size:13px}.contact-form-wrap .form-field textarea{min-height:66px}.contact-form-wrap .form-submit{min-height:48px;font-size:13px}.contact-form-wrap .form-help{font-size:10px}.contact-form-wrap .draft-result{margin-top:15px;padding:16px 17px}.contact-form-wrap .draft-result h4{font-size:18px}.contact-form-wrap .draft-result>p{font-size:12px}
.contact-product{padding-block:68px;background:#252b24;color:#f6f5ef}.contact-product-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,.48fr);align-items:center;gap:clamp(45px,7vw,105px)}.contact-product .contact-kicker{color:#ffb17d}.contact-product-copy>h2,.contact-company h2,.contact-faq h2{max-width:700px;margin-top:15px;font-size:clamp(36px,4.5vw,56px);line-height:1.06;letter-spacing:-.04em}.contact-product-copy>p:not(.contact-kicker){max-width:600px;margin-top:14px;color:#d0d4ca;font-size:14px;line-height:1.75}.contact-topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px 28px;margin-top:28px;padding-top:20px;border-top:1px solid #51584d}.contact-topic-grid h3{font-size:16px;line-height:1.3}.contact-topic-grid p{margin-top:8px;color:#d0d4ca;font-size:12px;line-height:1.65}.contact-topic-grid a{display:inline-flex;align-items:center;gap:7px;margin-top:12px;color:#ffb17d;font-size:12px;font-weight:650;text-decoration:underline;text-underline-offset:3px}.contact-topic-grid .icon{width:15px;height:15px}.contact-product-screen{width:100%;max-width:290px;justify-self:center;padding:15px;border:1px solid #52594f;border-radius:16px;background:#20251f}.contact-product-screen figcaption{display:flex;justify-content:space-between;gap:10px;margin:0 0 12px;color:#d0d4ca;font-size:9px}.contact-product-screen figcaption span:first-child{font-weight:650;color:#f6f5ef}.contact-phone-frame{width:100%;max-width:208px;margin-inline:auto;padding:6px;border:3px solid #72786d;border-radius:27px;background:#1e231e;box-shadow:0 20px 45px -34px #050605}.contact-phone-frame img{display:block;width:100%;height:auto;border-radius:19px}
.contact-company{padding-block:40px;background:#e8ecdf}.contact-company-inner{display:grid;grid-template-columns:minmax(0,.8fr) minmax(300px,1.2fr);align-items:center;gap:45px}.contact-company h2{font-size:clamp(28px,3.2vw,40px)}.contact-company address{padding:17px 20px;border-left:2px solid #819073;color:#30372e;font-size:13px;font-style:normal;line-height:1.7}.contact-company address>span{display:block;margin-bottom:5px;color:#50574c;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.contact-faq{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:clamp(36px,7vw,84px);padding-block:70px 82px}.contact-faq-intro>p:last-child{margin-top:13px;color:#51574e;font-size:13px;line-height:1.7}.contact-faq-list details{border-top:1px solid var(--line)}.contact-faq-list details:last-child{border-bottom:1px solid var(--line)}.contact-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:59px;cursor:pointer;list-style:none;font-size:13px;line-height:1.5;font-weight:650}.contact-faq-list summary::-webkit-details-marker{display:none}.contact-faq-list summary span{flex:none;color:#963b18;font-size:23px;font-weight:400;transition:transform .18s}.contact-faq-list details[open] summary span{transform:rotate(45deg)}.contact-faq-list details>p{padding:0 34px 17px 0;color:#51574e;font-size:12px;line-height:1.75}
@media(max-width:1000px){.contact-hero{grid-template-columns:1fr;gap:30px;padding-block:40px 62px}.contact-hero-copy{max-width:750px}.contact-form-wrap{width:100%;max-width:820px;justify-self:center}.contact-product-inner{gap:35px}.contact-company-inner{grid-template-columns:1fr 1.2fr}}
@media(max-width:700px){.contact-breadcrumb{padding-top:13px;font-size:10px;gap:7px}.contact-hero{padding-block:35px 48px;gap:24px}.contact-hero h1{font-size:clamp(42px,10.5vw,56px);margin-top:15px}.contact-lede{font-size:14px;margin-top:15px}.contact-direct{grid-template-columns:1fr;gap:5px;margin-top:24px;padding-top:16px}.contact-direct h2{grid-column:auto;margin-bottom:3px}.contact-direct a{min-height:34px;font-size:13px}.contact-company-note{margin-top:15px}.contact-form-wrap{padding:8px;border-radius:15px}.contact-form-wrap .enquiry-panel{padding:22px 18px;border-radius:11px}.contact-form-wrap .enquiry-panel>h3{font-size:24px}.contact-form-wrap .form-intro{margin-bottom:17px}.contact-form-wrap .form-row{grid-template-columns:1fr;gap:0}.contact-form-wrap .form-field{margin-bottom:12px}.contact-form-wrap .form-field label{font-size:12px}.contact-form-wrap .form-field input,.contact-form-wrap .form-field select,.contact-form-wrap .form-field textarea{font-size:16px;min-height:46px}.contact-form-wrap .form-field input::placeholder,.contact-form-wrap .form-field textarea::placeholder{font-size:13px}.contact-product{padding-block:49px}.contact-product-inner{grid-template-columns:1fr;gap:26px}.contact-product-copy>h2,.contact-company h2,.contact-faq h2{font-size:clamp(34px,8.8vw,44px)}.contact-product-copy>p:not(.contact-kicker){font-size:13px}.contact-topic-grid{grid-template-columns:1fr;gap:20px;margin-top:23px;padding-top:18px}.contact-topic-grid p{font-size:12px}.contact-product-screen{max-width:275px;padding:12px}.contact-phone-frame{max-width:212px}.contact-company{padding-block:34px}.contact-company-inner{grid-template-columns:1fr;gap:16px}.contact-company address{padding:14px 16px;font-size:12px}.contact-faq{grid-template-columns:1fr;gap:17px;padding-block:50px 59px}.contact-faq-intro>p:last-child{font-size:12px}.contact-faq-list summary{min-height:56px;font-size:12px}.contact-faq-list details>p{font-size:12px}}
@media(prefers-reduced-motion:reduce){.contact-faq-list summary span{transition:none}.contact-faq-list details[open] summary span{transform:none}}
.contact-form-wrap .form-field select{padding-right:42px;background-position:right 14px center}
</style>
