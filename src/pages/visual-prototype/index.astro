---
import { buildStation, states } from '../../visuals/station.mjs';
const station=buildStation();
---
<!doctype html>
<html lang="en-IN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>RestaBee — Isometric service prototype</title><link rel="icon" href="/restabee-logo.png"/></head>
<body>
<header><a class="brand" href="/"><img src="/restabee-logo.png" alt="" width="34" height="34"/>RestaBee</a><a class="back" href="/">Back to website ↗</a></header>
<main><div class="introduction"><p class="prototype-label">Visual study / Anatomy SVG</p><h1>One order.<br/>A connected restaurant.</h1><p>A small view of a busy service. Explore how the order moves from your team to the kitchen, then on to billing.</p></div>
<figure class="station-study" data-state="0" data-active="terminal">
<div class="iso-plate"><div class="plate-head"><span>FIG. 01</span><span>The service counter</span></div><div class="drawing" set:html={station.svg}></div><div class="plate-foot"><span>Select a stage below</span><output class="readout" data-readout aria-live="polite">{states[0].readout}</output></div></div>
<figcaption>Illustrative workflow and hardware. This is not a product screenshot or a printer compatibility claim.</figcaption>
<div class="story"><div class="stage-controls" role="group" aria-label="Explore the service workflow">{states.map((state,index)=><button type="button" data-step={index} aria-pressed={index===0?'true':'false'}><span>0{index+1}</span>{state.name}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg></button>)}</div><div class="story-copy"><h2 data-title>{states[0].title}</h2><p data-description>{states[0].description}</p></div></div>
<noscript><div class="static-story"><h2>The service workflow</h2><ol>{states.map(state=><li><strong>{state.title}</strong> {state.description}</li>)}</ol></div></noscript>
</figure>
<footer><span>{station.count} solid parts · {station.paths} paths · build-time SVG</span><span>No WebGL. No automatic animation.</span></footer>
</main>
<script type="application/json" id="station-states" set:html={JSON.stringify(states)} />
<script>
const figure=document.querySelector<HTMLElement>('.station-study');
const model=JSON.parse(document.querySelector('#station-states')?.textContent??'[]') as {name:string;zone:string;title:string;description:string;readout:string}[];
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
function select(index:number){
 const state=model[index];if(!state||!figure)return;
 figure.dataset.state=String(index);figure.dataset.active=state.zone;
 buttons.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===index)));
 const title=figure.querySelector('[data-title]');const description=figure.querySelector('[data-description]');const readout=figure.querySelector('output');
 if(title)title.textContent=state.title;if(description)description.textContent=state.description;if(readout)readout.textContent=state.readout;
}
buttons.forEach((button,index)=>{button.addEventListener('click',()=>select(index));button.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%buttons.length;else if(event.key==='ArrowLeft')next=(index-1+buttons.length)%buttons.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=buttons.length-1;else return;event.preventDefault();select(next);buttons[next]?.focus();});});
</script>
<style is:global>
@font-face{font-family:Study;src:url('@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2') format('woff2');font-weight:400 700;font-display:swap}@font-face{font-family:Display;src:url('@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2') format('woff2');font-weight:200 800;font-display:swap}
*{box-sizing:border-box}body{margin:0;background:#faf7f1;color:#252724;font-family:Study,sans-serif;line-height:1.6}a{color:inherit;text-decoration:none}header{max-width:1320px;margin:auto;padding:26px 44px;display:flex;justify-content:space-between;align-items:center}.brand{display:flex;gap:10px;align-items:center;font-weight:700;font-size:22px}.back{font-size:13px;color:#625e54}main{max-width:1240px;margin:auto;padding:18px 44px 40px}.introduction{display:grid;grid-template-columns:1fr 1fr;column-gap:100px;align-items:end;margin:15px 0 34px}.prototype-label{grid-column:1/-1;text-transform:uppercase;letter-spacing:.14em;font-size:10px;color:#756e60;margin:0 0 15px}h1{font-family:Display,sans-serif;font-size:clamp(36px,4.2vw,59px);line-height:1.05;letter-spacing:-.035em;font-weight:600;margin:0}.introduction>p:last-child{font-size:16px;max-width:400px;color:#625e54;margin:0 0 2px}.station-study{margin:0}.iso-plate{background:#f0ebe1;border:1px solid #d8d1c2;border-radius:16px;padding:22px 28px 20px;position:relative;overflow:hidden}.plate-head,.plate-foot{display:flex;justify-content:space-between;gap:16px;font-size:11px;color:#615e54}.plate-head span:first-child{letter-spacing:.12em;color:#756e60}.plate-head span:last-child{font-weight:600}.drawing{max-width:880px;margin:-18px auto -20px}.iso-svg{display:block;width:100%;height:auto;overflow:visible}.plate-foot{position:relative;z-index:2;align-items:center}.readout{font-weight:600;color:#383a32;border-radius:4px;background:#e3ddce;padding:5px 10px;font-size:11px}figcaption{font-size:10px;color:#6c675c;margin:10px 0 26px;text-align:center}.story{display:grid;grid-template-columns:1fr 1fr;gap:80px}.stage-controls{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:start}button{font:inherit;color:inherit;display:flex;gap:10px;align-items:center;text-align:left;border:1px solid #ded7ca;background:transparent;border-radius:8px;padding:13px 15px;cursor:pointer;font-size:13px;transition:background .2s,color .2s}button>span{font-size:10px;color:#726957}button svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.3;margin-left:auto}button[aria-pressed=true]{background:#f5a623;border-color:#f5a623;color:#27251d}button[aria-pressed=true]>span{color:#594320}button:hover{background:#f9dfb0}button:focus-visible,a:focus-visible{outline:3px solid #805000;outline-offset:4px}h2{font-family:Display,sans-serif;font-size:27px;line-height:1.16;font-weight:550;letter-spacing:-.025em;margin:0 0 12px}.story-copy p{font-size:14px;color:#625e54;margin:0;max-width:470px;min-height:90px}footer{font-size:10px;color:#756e60;display:flex;justify-content:space-between;margin-top:34px;border-top:1px solid #ded7ca;padding-top:17px}.static-story{padding:24px 0}.static-story li{margin-top:12px}
/* Anatomy-style face shading; geometry stays static, selected physical assembly changes focus. */
.station-part{--paper:#ded7c7;--top:#f4efe4;--s0:#c0b6a2;--s1:#d1c7b3;--s2:#e2d9c6;--s3:#ece5d6;transition:filter .28s ease}.material-ivory{--paper:#efe9dc;--top:#fffaf0;--s0:#c6bda9;--s1:#dcd3bf;--s2:#ede5d3;--s3:#f6efdf}.material-dark{--paper:#383c37;--top:#54594e;--s0:#242923;--s1:#343b30;--s2:#424a3d;--s3:#4a5344}.material-metal{--paper:#969c8d;--top:#c6cbbb;--s0:#757d6e;--s1:#8a9380;--s2:#a7af9b;--s3:#b7bead}.material-paper{--paper:#f4f0e5;--top:#fffdf6;--s0:#d6cfbf;--s1:#e0d9c8;--s2:#eee7d7;--s3:#f6f1e5}.material-screen{--paper:#27312e;--top:#38413b;--s0:#151c16;--s1:#283126;--s2:#34402e;--s3:#3b4435}.material-accent{--paper:#c18a28;--top:#f5a623;--s0:#9c6c21;--s1:#b57e25;--s2:#d89932;--s3:#e8a63b}.iso-fill{fill:var(--paper);stroke:none}.iso-top{fill:var(--top);stroke:none}.iso-shade{stroke:none}.iso-shade[data-shade="0"]{fill:var(--s0)}.iso-shade[data-shade="1"]{fill:var(--s1)}.iso-shade[data-shade="2"]{fill:var(--s2)}.iso-shade[data-shade="3"]{fill:var(--s3)}.iso-line{fill:none;stroke:#5a5e5148;stroke-width:.6;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}.iso-edge{stroke:#484e444f}.material-dark .iso-edge{stroke:#171d2160}.iso-crease,.iso-bevel{stroke-width:.4;opacity:.55}.station-shadow{fill:#5b5543;opacity:.16;filter:blur(12px);transform:translateY(12px)}.printed rect{fill:#898574;opacity:.7}.screen-ui{pointer-events:none}.screen-check{opacity:0;transition:opacity .2s}.station-study[data-active=printer] .screen-check{opacity:1}.station-study[data-active=terminal] [data-zone=terminal],.station-study[data-active=kitchen] [data-zone=kitchen],.station-study[data-active=pass] [data-zone=pass],.station-study[data-active=printer] [data-zone=printer]{filter:brightness(1.1)}
@media(max-width:700px){header{padding:20px 22px}.brand{font-size:19px}.back{font-size:11px}main{padding:15px 20px 30px}.introduction{display:block;margin:16px 0 25px}.prototype-label{font-size:9px;margin-bottom:12px}.introduction>p:last-child{font-size:14px;margin-top:20px;max-width:340px}h1{font-size:42px}.iso-plate{padding:16px 12px}.drawing{margin:0 -7% -8px;width:114%}.plate-head{font-size:9px}.plate-foot{align-items:flex-start;flex-direction:column;gap:7px;font-size:9px}.readout{font-size:10px}.story{grid-template-columns:1fr;gap:27px}.story-copy{min-height:130px}h2{font-size:26px}figcaption{font-size:9px;margin-bottom:22px}footer{gap:15px;font-size:9px;align-items:start}footer>span{max-width:48%}button{min-height:48px;padding:12px;font-size:12px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}}
</style>
</body></html>
