---
import '../../styles/home.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Mark from '../../components/Mark.astro';
import { getEntry, getCollection } from 'astro:content';

const indexEntry = await getEntry('pages', 'blog-index');
if (!indexEntry) throw new Error('CMS content entry "blog-index" is missing.');
const { seo, copy } = indexEntry.data;

const allArticles = await getCollection('blog');
const sortedArticles = allArticles.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
const featuredArticle = sortedArticles.find(a => a.data.featured) || sortedArticles[0];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: {
    '@type': 'WebSite',
    name: 'RestaBee',
    url: 'https://restabee.com/'
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: seo.canonical }
    ]
  }
};
---

<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="blog-index-page">
    <nav class="blog-breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Restaurant POS</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Blog</span>
    </nav>

    <header class="blog-hero container">
      <p class="blog-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
      <h1>{copy.heroTitle}</h1>
      <p class="blog-lede">{copy.heroDescription}</p>
    </header>

    {featuredArticle && (
      <section class="blog-featured container" aria-labelledby="featured-heading">
        <div class="featured-card">
          <div class="featured-content">
            <div class="featured-meta">
              <span class="category-badge">{featuredArticle.data.category}</span>
              <span class="featured-flag">{copy.featuredHeading}</span>
              <span class="read-time">{featuredArticle.data.readTime}</span>
            </div>
            <h2 id="featured-heading">
              <a href={`/blog/${featuredArticle.data.slug}/`}>{featuredArticle.data.title}</a>
            </h2>
            <p class="featured-excerpt">{featuredArticle.data.excerpt}</p>
            <div class="featured-footer">
              <span class="author-name">{featuredArticle.data.author.name}</span>
              <span class="bullet" aria-hidden="true">·</span>
              <time datetime={featuredArticle.data.publishDate}>
                {new Date(featuredArticle.data.publishDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
              <a class="button button-orange featured-cta" href={`/blog/${featuredArticle.data.slug}/`}>
                {copy.readGuide} <Mark />
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="blog-grid-section container" aria-labelledby="all-articles-heading">
      <div class="section-header">
        <h2 id="all-articles-heading">{copy.latestHeading}</h2>
        <span class="articles-count">{sortedArticles.length} guides published</span>
      </div>

      <div class="articles-grid">
        {sortedArticles.map(article => (
          <article class="article-card">
            <div class="card-meta">
              <span class="category-badge">{article.data.category}</span>
              <span class="read-time">{article.data.readTime}</span>
            </div>
            <h3>
              <a href={`/blog/${article.data.slug}/`}>{article.data.title}</a>
            </h3>
            <p class="card-excerpt">{article.data.excerpt}</p>
            <div class="card-footer">
              <time datetime={article.data.publishDate}>
                {new Date(article.data.publishDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
              <a class="read-link" href={`/blog/${article.data.slug}/`}>
                {copy.readGuide} <Mark />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="blog-cta container" aria-labelledby="blog-cta-title">
      <div class="cta-inner">
        <div>
          <p class="cta-kicker">{copy.ctaKicker}</p>
          <h2 id="blog-cta-title">{copy.ctaTitle}</h2>
          <p class="cta-description">{copy.ctaDescription}</p>
        </div>
        <a class="button button-orange" href="/#demo">{copy.ctaButton} <Mark /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
.blog-index-page {
  overflow: hidden;
  padding-bottom: 90px;
}
.blog-breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-top: 20px;
  font-size: 12px;
  color: var(--muted);
}
.blog-breadcrumb a {
  text-decoration: underline;
  text-decoration-color: #afb3a8;
  text-underline-offset: 3px;
}
.blog-breadcrumb [aria-current="page"] {
  color: var(--ink);
}
.blog-hero {
  padding-top: 48px;
  padding-bottom: 40px;
}
.blog-kicker {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #963b18;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.blog-kicker > span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--orange);
}
.blog-hero h1 {
  max-width: 840px;
  font-size: clamp(42px, 5.2vw, 68px);
  line-height: 1.05;
  letter-spacing: -0.04em;
  margin-top: 18px;
}
.blog-lede {
  max-width: 680px;
  margin-top: 20px;
  color: #51574e;
  font-size: 17px;
  line-height: 1.75;
}

.blog-featured {
  margin-top: 20px;
  margin-bottom: 64px;
}
.featured-card {
  padding: 38px 42px;
  background: #f1eee5;
  border: 1px solid var(--line);
  border-radius: 16px;
  box-shadow: 0 16px 36px -24px #252a2430;
  transition: transform 0.2s ease, border-color 0.2s ease;
}
.featured-card:hover {
  border-color: #c7c9bf;
  transform: translateY(-2px);
}
.featured-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}
.category-badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 20px;
  background: #ffe7cf;
  color: #963b18;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.featured-flag {
  font-size: 12px;
  font-weight: 700;
  color: #62665d;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.read-time {
  font-size: 12px;
  color: #62665d;
}
.featured-card h2 {
  font-size: clamp(28px, 3.4vw, 42px);
  line-height: 1.15;
  letter-spacing: -0.035em;
  margin-bottom: 14px;
}
.featured-card h2 a {
  color: var(--ink);
  text-decoration: none;
}
.featured-card h2 a:hover {
  color: #963b18;
}
.featured-excerpt {
  max-width: 820px;
  color: #51574e;
  font-size: 16px;
  line-height: 1.7;
  margin-bottom: 26px;
}
.featured-footer {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 13px;
  color: #62665d;
  padding-top: 18px;
  border-top: 1px solid #dedfd5;
}
.author-name {
  font-weight: 600;
  color: var(--ink);
}
.bullet {
  color: #9a9e94;
}
.featured-cta {
  margin-left: auto;
  padding: 10px 20px;
  font-size: 13px;
}

.blog-grid-section {
  margin-bottom: 80px;
}
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 34px;
}
.section-header h2 {
  font-size: clamp(24px, 2.8vw, 34px);
  letter-spacing: -0.03em;
}
.articles-count {
  font-size: 13px;
  color: var(--muted);
  font-weight: 500;
}
.articles-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28px;
}
.article-card {
  display: flex;
  flex-direction: column;
  padding: 26px;
  background: #fffefa;
  border: 1px solid var(--line);
  border-radius: 14px;
  box-shadow: 0 8px 20px -16px #252a2425;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}
.article-card:hover {
  transform: translateY(-2px);
  border-color: #c7c9bf;
  box-shadow: 0 16px 28px -18px #252a2435;
}
.card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 14px;
}
.article-card h3 {
  font-size: 20px;
  line-height: 1.25;
  letter-spacing: -0.025em;
  margin-bottom: 12px;
}
.article-card h3 a {
  color: var(--ink);
  text-decoration: none;
}
.article-card h3 a:hover {
  color: #963b18;
}
.card-excerpt {
  color: #51574e;
  font-size: 14px;
  line-height: 1.65;
  margin-bottom: 22px;
  flex-grow: 1;
}
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 14px;
  border-top: 1px solid #eeeee6;
  font-size: 12px;
  color: var(--muted);
}
.read-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #963b18;
  font-weight: 700;
  text-decoration: none;
  font-size: 12px;
}
.read-link:hover {
  text-decoration: underline;
}

.blog-cta {
  padding-block: 20px;
}
.cta-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 36px;
  padding: 44px 50px;
  background: #f0caa8;
  border-radius: 16px;
}
.cta-kicker {
  color: #783516;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.cta-inner h2 {
  max-width: 620px;
  font-size: clamp(28px, 3.2vw, 40px);
  line-height: 1.12;
  letter-spacing: -0.035em;
  margin-top: 12px;
  color: var(--ink);
}
.cta-description {
  max-width: 580px;
  margin-top: 12px;
  color: #493e35;
  font-size: 15px;
  line-height: 1.7;
}
.cta-inner .button {
  flex: none;
}

@media (max-width: 1050px) {
  .articles-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 800px) {
  .cta-inner {
    flex-direction: column;
    align-items: flex-start;
    padding: 32px 28px;
  }
  .featured-footer .featured-cta {
    width: 100%;
    margin-left: 0;
    margin-top: 8px;
    justify-content: space-between;
  }
}
@media (max-width: 700px) {
  .blog-hero h1 {
    font-size: clamp(34px, 9vw, 44px);
  }
  .featured-card {
    padding: 24px 20px;
  }
  .articles-grid {
    grid-template-columns: 1fr;
  }
  .cta-inner .button {
    width: 100%;
    justify-content: space-between;
  }
}
</style>
