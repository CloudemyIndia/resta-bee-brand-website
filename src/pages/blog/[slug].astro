---
import '../../styles/home.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Mark from '../../components/Mark.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map(article => ({
    params: { slug: article.data.slug },
    props: { article }
  }));
}

interface Props {
  article: CollectionEntry<'blog'>;
}

const { article } = Astro.props;
const { seo, title, subtitle, publishDate, updatedDate, author, category, readTime, featuredImage, tableOfContents, sections, faqs, relatedLinks } = article.data;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: seo.description,
  url: seo.canonical,
  datePublished: publishDate,
  dateModified: updatedDate || publishDate,
  author: {
    '@type': 'Organization',
    name: author.name
  },
  publisher: {
    '@type': 'Organization',
    name: 'RestaBee',
    url: 'https://restabee.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://restabee.com/images/restabee-mark.webp'
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': seo.canonical
  },
  ...(featuredImage ? {
    image: {
      '@type': 'ImageObject',
      url: `https://restabee.com${featuredImage.src}`,
      width: featuredImage.width,
      height: featuredImage.height
    }
  } : {}),
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://restabee.com/blog/' },
      { '@type': 'ListItem', position: 3, name: title, item: seo.canonical }
    ]
  }
};
---

<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="article-page">
    <nav class="article-breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Restaurant POS</a>
      <span aria-hidden="true">/</span>
      <a href="/blog/">Blog</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{category}</span>
    </nav>

    <header class="article-hero container">
      <div class="article-hero-inner">
        <div class="article-meta-top">
          <span class="category-badge">{category}</span>
          <span class="read-time">{readTime}</span>
        </div>
        <h1>{title}</h1>
        <p class="article-lede">{subtitle}</p>
        <div class="article-author-bar">
          <div class="author-info">
            <span class="author-name">{author.name}</span>
            <span class="author-role">{author.role}</span>
          </div>
          <div class="article-dates">
            <span>Published: <time datetime={publishDate}>{new Date(publishDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</time></span>
            {updatedDate && updatedDate !== publishDate && (
              <span>Updated: <time datetime={updatedDate}>{new Date(updatedDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</time></span>
            )}
          </div>
        </div>
      </div>
    </header>

    {featuredImage && (
      <figure class="article-featured-image container">
        <img src={featuredImage.src} alt={featuredImage.alt} width={featuredImage.width} height={featuredImage.height} loading="lazy" decoding="async" />
        {featuredImage.caption && (
          <figcaption>{featuredImage.caption}</figcaption>
        )}
      </figure>
    )}

    <div class="article-layout container">
      <aside class="article-sidebar" aria-label="Table of contents">
        <div class="toc-sticky">
          <p class="toc-title">IN THIS ARTICLE</p>
          <nav class="toc-nav">
            <ol>
              {tableOfContents.map(item => (
                <li>
                  <a href={`#${item.id}`}>{item.title}</a>
                </li>
              ))}
              {faqs.length > 0 && (
                <li>
                  <a href="#frequently-asked-questions">Frequently asked questions</a>
                </li>
              )}
            </ol>
          </nav>
          <div class="sidebar-cta">
            <p class="sidebar-cta-title">Looking for restaurant POS?</p>
            <p class="sidebar-cta-text">RestaBee connects orders, kitchen stations and bills in one workflow.</p>
            <a class="button button-orange sidebar-button" href="/#demo">Book a demo <Mark /></a>
          </div>
        </div>
      </aside>

      <article class="article-content">
        <details class="mobile-toc">
          <summary>
            <span>Table of contents</span>
            <span class="toc-indicator" aria-hidden="true">+</span>
          </summary>
          <ol>
            {tableOfContents.map(item => (
              <li>
                <a href={`#${item.id}`}>{item.title}</a>
              </li>
            ))}
            {faqs.length > 0 && (
              <li>
                <a href="#frequently-asked-questions">Frequently asked questions</a>
              </li>
            )}
          </ol>
        </details>

        {sections.map(section => (
          <section id={section.id} class="content-block">
            <h2>{section.heading}</h2>

            {section.paragraphs.map(para => (
              <p>{para}</p>
            ))}

            {section.callout && (
              <aside class="article-callout" aria-label={section.callout.title}>
                <p class="callout-title">{section.callout.title}</p>
                <div class="callout-body">
                  {section.callout.text.split('\n').map(line => (
                    line.trim() ? <p>{line}</p> : <div class="callout-space" aria-hidden="true" />
                  ))}
                </div>
              </aside>
            )}

            {section.checklist && (
              <div class="article-checklist">
                {section.checklist.map(item => (
                  <div class="checklist-item">
                    <span class="checklist-bullet" aria-hidden="true">✓</span>
                    <div>
                      <strong>{item.item}</strong>
                      <p>{item.detail}</p>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {section.table && (
              <div class="article-table-wrapper">
                <table>
                  {section.table.caption && <caption>{section.table.caption}</caption>}
                  <thead>
                    <tr>
                      {section.table.headers.map(header => (
                        <th scope="col">{header}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map(row => (
                      <tr>
                        {[row.rowHeader, row.column2, row.column3, row.column4]
                          .filter((cell): cell is string => typeof cell === 'string')
                          .slice(0, section.table?.headers.length ?? 0)
                          .map((cell, idx) => (
                          idx === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {section.subsections && section.subsections.map(sub => (
              <div class="article-subsection">
                <h3>{sub.heading}</h3>
                {sub.paragraphs.map(para => (
                  <p>{para}</p>
                ))}
              </div>
            ))}

            {section.paragraphs_after && section.paragraphs_after.map(para => (
              <p>{para}</p>
            ))}
          </section>
        ))}

        {faqs.length > 0 && (
          <section id="frequently-asked-questions" class="article-faqs">
            <h2>Frequently asked questions</h2>
            <div class="faq-list">
              {faqs.map(faq => (
                <details>
                  <summary>
                    <span>{faq.question}</span>
                    <span class="faq-plus" aria-hidden="true">+</span>
                  </summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {relatedLinks.length > 0 && (
          <section class="related-features-box" aria-labelledby="related-heading">
            <h2 id="related-heading">Related restaurant capabilities</h2>
            <div class="related-grid">
              {relatedLinks.map(link => (
                <a class="related-card" href={link.href}>
                  <h3>{link.title} <Mark /></h3>
                  <p>{link.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="bottom-article-cta">
          <div class="cta-card">
            <div>
              <p class="cta-kicker">SEE RESTABEE IN ACTION</p>
              <h2>Experience how RestaBee manages your restaurant workflow</h2>
              <p class="cta-desc">Walk through order punching, multi-station kitchen tickets, floor tables, and billing with our specialist team.</p>
            </div>
            <a class="button button-orange" href="/#demo">Book a live demo <Mark /></a>
          </div>
        </section>
      </article>
    </div>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
.article-page {
  overflow: hidden;
  padding-bottom: 90px;
}
.article-breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-top: 20px;
  font-size: 12px;
  color: var(--muted);
  flex-wrap: wrap;
}
.article-breadcrumb a {
  text-decoration: underline;
  text-decoration-color: #afb3a8;
  text-underline-offset: 3px;
}
.article-breadcrumb [aria-current="page"] {
  color: var(--ink);
}

.article-hero {
  padding-top: 42px;
  padding-bottom: 36px;
  border-bottom: 1px solid var(--line);
}
.article-hero-inner {
  max-width: 900px;
}
.article-meta-top {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.category-badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 20px;
  background: #ffe7cf;
  color: #963b18;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.read-time {
  font-size: 13px;
  color: #62665d;
}
.article-hero h1 {
  font-size: clamp(36px, 4.8vw, 58px);
  line-height: 1.08;
  letter-spacing: -0.04em;
  color: var(--ink);
}
.article-lede {
  margin-top: 18px;
  color: #51574e;
  font-size: 18px;
  line-height: 1.65;
}
.article-author-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  margin-top: 28px;
  padding-top: 18px;
  border-top: 1px solid #eeeee6;
  font-size: 13px;
  color: #62665d;
}
.author-info {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.author-name {
  font-weight: 700;
  color: var(--ink);
}
.author-role {
  color: #73776d;
}
.article-dates {
  display: flex;
  align-items: center;
  gap: 16px;
}
.article-featured-image {
  width: min(100%, 900px);
  margin: 32px auto 0;
}
.article-featured-image img {
  display: block;
  width: 100%;
  max-width: 780px;
  max-height: min(52svh, 440px);
  height: auto;
  margin-inline: auto;
  object-fit: contain;
}
.article-featured-image figcaption {
  margin-top: 13px;
  color: #51574e;
  font-size: 12px;
  line-height: 1.5;
  text-align: center;
}

.article-layout {
  display: grid;
  grid-template-columns: minmax(240px, 280px) minmax(0, 1fr);
  gap: clamp(36px, 6vw, 72px);
  padding-top: 48px;
  align-items: start;
}

.article-sidebar {
  position: relative;
}
.toc-sticky {
  position: sticky;
  top: 96px;
  padding: 24px;
  background: #f6f5ef;
  border: 1px solid var(--line);
  border-radius: 14px;
}
.toc-title {
  color: #963b18;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 14px;
}
.toc-nav ol {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.toc-nav a {
  display: block;
  font-size: 13px;
  line-height: 1.45;
  color: #51574e;
  text-decoration: none;
  transition: color 0.15s ease;
}
.toc-nav a:hover {
  color: #963b18;
  text-decoration: underline;
}
.sidebar-cta {
  margin-top: 24px;
  padding-top: 18px;
  border-top: 1px solid #dedfd5;
}
.sidebar-cta-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6px;
}
.sidebar-cta-text {
  font-size: 12px;
  color: #51574e;
  line-height: 1.5;
  margin-bottom: 14px;
}
.sidebar-button {
  width: 100%;
  justify-content: space-between;
  padding: 10px 14px;
  font-size: 12px;
}

.mobile-toc {
  display: none;
  margin-bottom: 32px;
  padding: 16px 20px;
  background: #f6f5ef;
  border: 1px solid var(--line);
  border-radius: 12px;
}
.mobile-toc summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  list-style: none;
}
.mobile-toc summary::-webkit-details-marker {
  display: none;
}
.mobile-toc summary .toc-indicator {
  font-size: 20px;
  color: #963b18;
  transition: transform 0.18s ease;
}
.mobile-toc[open] summary .toc-indicator {
  transform: rotate(45deg);
}
.mobile-toc ol {
  list-style: decimal;
  padding-left: 20px;
  margin-top: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
}
.mobile-toc a {
  color: #51574e;
  text-decoration: none;
}
.mobile-toc a:hover {
  color: #963b18;
  text-decoration: underline;
}

.article-content {
  max-width: 820px;
}
.content-block {
  margin-bottom: 48px;
}
.content-block h2 {
  font-size: clamp(26px, 3.2vw, 36px);
  line-height: 1.18;
  letter-spacing: -0.03em;
  color: var(--ink);
  margin-bottom: 18px;
  padding-top: 8px;
}
.content-block p {
  color: #42473e;
  font-size: 16px;
  line-height: 1.78;
  margin-bottom: 16px;
}

.article-callout {
  margin-block: 28px;
  padding: 24px 28px;
  background: #f1eee5;
  border: 1px solid #dedacd;
  border-left: 4px solid var(--orange);
  border-radius: 10px;
}
.callout-title {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #963b18;
  margin-bottom: 10px;
}
.callout-body p {
  font-family: monospace, sans-serif;
  font-size: 13px;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 4px;
}
.callout-space {
  height: 8px;
}

.article-checklist {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-block: 24px;
}
.checklist-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 20px;
  background: #fffefa;
  border: 1px solid var(--line);
  border-radius: 10px;
}
.checklist-bullet {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #ffe7cf;
  color: #963b18;
  font-size: 12px;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 2px;
}
.checklist-item strong {
  display: block;
  font-size: 15px;
  color: var(--ink);
  margin-bottom: 4px;
}
.checklist-item p {
  margin-bottom: 0;
  font-size: 14px;
  color: #51574e;
  line-height: 1.6;
}

.article-table-wrapper {
  overflow-x: auto;
  margin-block: 28px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #fffefa;
}
.article-table-wrapper table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  text-align: left;
}
.article-table-wrapper caption {
  padding: 12px 18px;
  font-size: 12px;
  font-weight: 700;
  color: #62665d;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  background: #f6f5ef;
  border-bottom: 1px solid var(--line);
  text-align: left;
}
.article-table-wrapper th,
.article-table-wrapper td {
  padding: 14px 18px;
  border-bottom: 1px solid #eeeee6;
}
.article-table-wrapper thead th {
  background: #faf8f2;
  font-weight: 700;
  color: var(--ink);
  border-bottom: 1px solid var(--line);
}
.article-table-wrapper tbody tr:last-child th,
.article-table-wrapper tbody tr:last-child td {
  border-bottom: 0;
}
.article-table-wrapper tbody tr:hover {
  background: #f9f8f4;
}

.article-subsection {
  margin-top: 28px;
  margin-bottom: 20px;
}
.article-subsection h3 {
  font-size: 21px;
  line-height: 1.3;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin-bottom: 12px;
}

.article-faqs {
  margin-top: 56px;
  padding-top: 36px;
  border-top: 1px solid var(--line);
}
.article-faqs h2 {
  font-size: clamp(24px, 3vw, 32px);
  margin-bottom: 22px;
  letter-spacing: -0.03em;
}
.faq-list details {
  border-top: 1px solid var(--line);
}
.faq-list details:last-child {
  border-bottom: 1px solid var(--line);
}
.faq-list summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  min-height: 64px;
  cursor: pointer;
  list-style: none;
  font-size: 15px;
  font-weight: 650;
  color: var(--ink);
}
.faq-list summary::-webkit-details-marker {
  display: none;
}
.faq-plus {
  font-size: 24px;
  font-weight: 400;
  color: #963b18;
  flex: none;
  transition: transform 0.18s ease;
}
.faq-list details[open] summary .faq-plus {
  transform: rotate(45deg);
}
.faq-list details p {
  padding: 0 32px 18px 0;
  color: #51574e;
  font-size: 14px;
  line-height: 1.75;
}

.related-features-box {
  margin-top: 56px;
  padding: 34px 38px;
  background: #f1eee5;
  border: 1px solid var(--line);
  border-radius: 14px;
}
.related-features-box h2 {
  font-size: 22px;
  letter-spacing: -0.025em;
  margin-bottom: 20px;
}
.related-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}
.related-card {
  padding: 20px;
  background: #fffefa;
  border: 1px solid var(--line);
  border-radius: 10px;
  text-decoration: none;
  color: inherit;
  transition: transform 0.15s ease, border-color 0.15s ease;
}
.related-card:hover {
  transform: translateY(-2px);
  border-color: #c7c9bf;
}
.related-card h3 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 16px;
  color: #963b18;
  margin-bottom: 6px;
}
.related-card p {
  font-size: 13px;
  color: #51574e;
  line-height: 1.55;
  margin-bottom: 0;
}

.bottom-article-cta {
  margin-top: 48px;
}
.cta-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
  padding: 36px 40px;
  background: #f0caa8;
  border-radius: 14px;
}
.cta-kicker {
  color: #783516;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.cta-card h2 {
  max-width: 540px;
  font-size: clamp(22px, 2.6vw, 30px);
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin-top: 8px;
  color: var(--ink);
}
.cta-desc {
  max-width: 520px;
  color: #493e35;
  font-size: 14px;
  line-height: 1.65;
  margin-top: 10px;
  margin-bottom: 0;
}
.cta-card .button {
  flex: none;
}

@media (max-width: 950px) {
  .article-layout {
    grid-template-columns: 1fr;
  }
  .article-sidebar {
    display: none;
  }
  .mobile-toc {
    display: block;
  }
  .related-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 700px) {
  .article-featured-image {
    margin-top: 24px;
  }
  .article-featured-image img {
    max-height: min(44svh, 340px);
  }
  .article-hero h1 {
    font-size: clamp(30px, 8.5vw, 40px);
  }
  .article-lede {
    font-size: 16px;
  }
  .article-author-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .cta-card {
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 24px;
  }
  .cta-card .button {
    width: 100%;
    justify-content: space-between;
  }
  .related-features-box {
    padding: 24px 20px;
  }
}
</style>
