---
import { getEntry } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const entry = await getEntry('pages', 'bakery-pos');
if (!entry) throw new Error('CMS content entry "bakery-pos" is missing.');
const { seo, copy, bakeryLists, imageAlt } = entry.data;
if (!bakeryLists?.serviceTypes.length || !bakeryLists.customOrders.length || !bakeryLists.workflowSteps.length || !bakeryLists.faqs.length || !imageAlt?.bakeryPosMenu || !imageAlt?.bakeryPosReports) {
  throw new Error('Bakery POS page content is incomplete.');
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
      { '@type': 'ListItem', position: 2, name: 'Bakery POS', item: seo.canonical }
    ]
  }
};
---

<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="bakery-page">
    <nav class="bakery-breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span>
    </nav>

    <section class="bakery-hero container" aria-labelledby="bakery-title">
      <div class="bakery-hero-copy">
        <p class="bakery-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="bakery-title">{copy.heroTitle}</h1>
        <p class="bakery-lede">{copy.heroDescription}</p>
        <div class="bakery-actions">
          <a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a>
          <a class="text-link" href="#bakery-workflow">{copy.workflowCta}<Mark name="down" /></a>
        </div>
      </div>
      <figure class="bakery-screen">
        <figcaption><span>{copy.menuScreenLabel}</span><span>{copy.menuScreenDataLabel}</span></figcaption>
        <div class="bakery-monitor">
          <div class="bakery-bezel">
            <picture>
              <source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-with-photos-mobile.webp" width="872" height="1804"/>
              <source media="(max-width: 1100px)" srcset="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656"/>
              <img src="/pos-images/restabee-restaurant-pos-menu-with-photos-desktop.webp" width="1548" height="1016" alt={imageAlt.bakeryPosMenu} fetchpriority="high" decoding="async"/>
            </picture>
          </div>
          <div class="bakery-stand" aria-hidden="true"></div>
        </div>
        <p>{copy.menuScreenCaption}</p>
      </figure>
    </section>

    <section class="bakery-overview container" aria-labelledby="bakery-overview-title">
      <div>
        <p class="bakery-kicker">{copy.overviewKicker}</p>
        <h2 id="bakery-overview-title">{copy.overviewTitle}</h2>
      </div>
      <div class="bakery-copy">
        <p>{copy.overviewParagraphOne}</p>
        <p>{copy.overviewParagraphTwo}</p>
        <p>{copy.overviewParagraphThree}</p>
      </div>
    </section>

    <section class="bakery-services" aria-labelledby="bakery-service-title">
      <div class="container">
        <header class="bakery-section-head">
          <p class="bakery-kicker">{copy.serviceKicker}</p>
          <h2 id="bakery-service-title">{copy.serviceTitle}</h2>
          <p>{copy.serviceDescription}</p>
        </header>
        <ul class="bakery-service-grid" aria-label={copy.serviceListLabel}>
          {bakeryLists.serviceTypes.map((item, index) => (
            <li><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bakery-orders container" aria-labelledby="bakery-order-title">
      <div class="bakery-order-heading">
        <p class="bakery-kicker">{copy.customOrderKicker}</p>
        <h2 id="bakery-order-title">{copy.customOrderTitle}</h2>
        <p>{copy.customOrderDescription}</p>
      </div>
      <div class="bakery-order-copy">
        <p>{copy.customOrderParagraphOne}</p>
        <p>{copy.customOrderParagraphTwo}</p>
        <p>{copy.customOrderParagraphThree}</p>
      </div>
      <ul class="bakery-setup-grid" aria-label={copy.customOrderListLabel}>
        {bakeryLists.customOrders.map((item, index) => (
          <li><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></li>
        ))}
      </ul>
    </section>

    <section class="bakery-workflow" id="bakery-workflow" aria-labelledby="bakery-workflow-title">
      <div class="container">
        <header class="bakery-section-head">
          <p class="bakery-kicker">{copy.workflowKicker}</p>
          <h2 id="bakery-workflow-title">{copy.workflowTitle}</h2>
          <p>{copy.workflowDescription}</p>
        </header>
        <ol class="bakery-workflow-list" aria-label={copy.workflowListLabel}>
          {bakeryLists.workflowSteps.map(step => (
            <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="bakery-handoff container" aria-labelledby="bakery-handoff-title">
      <div class="bakery-handoff-heading">
        <p class="bakery-kicker">{copy.handoffKicker}</p>
        <h2 id="bakery-handoff-title">{copy.handoffTitle}</h2>
      </div>
      <div class="bakery-copy">
        <p>{copy.handoffParagraphOne}</p>
        <p>{copy.handoffParagraphTwo}</p>
        <p>{copy.handoffParagraphThree}</p>
        <a class="text-link" href="/features/kitchen-display-system/">{copy.kdsLinkLabel}<Mark /></a>
        <a class="text-link" href="/features/restaurant-menu-management/">{copy.menuLinkLabel}<Mark /></a>
        <a class="text-link" href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a>
      </div>
    </section>

    <section class="bakery-reports">
      <div class="container bakery-reports-inner">
        <div>
          <p class="bakery-kicker">{copy.reportKicker}</p>
          <h2>{copy.reportTitle}</h2>
          <p>{copy.reportDescription}</p>
          <a class="text-link" href="/features/restaurant-sales-reports/">{copy.reportLinkLabel}<Mark /></a>
        </div>
        <figure class="bakery-report-screen">
          <figcaption><span>{copy.reportScreenLabel}</span><span>{copy.reportScreenDataLabel}</span></figcaption>
          <div class="bakery-phone-bezel">
            <img src="/pos-images/restabee-pos-reports-mobile.webp" width="800" height="1656" alt={imageAlt.bakeryPosReports} loading="lazy" decoding="async"/>
          </div>
          <p>{copy.reportScreenCaption}</p>
        </figure>
      </div>
    </section>

    <section class="bakery-platform container" aria-labelledby="bakery-platform-title">
      <div>
        <p class="bakery-kicker">{copy.platformKicker}</p>
        <h2 id="bakery-platform-title">{copy.platformTitle}</h2>
        <p>{copy.platformDescription}</p>
      </div>
      <div class="bakery-platform-list" aria-label="Supported platforms">
        <span>Desktop</span><i></i><span>Tablet</span><i></i><span>Phone</span>
      </div>
    </section>

    <section class="bakery-related container" aria-label="Related restaurant POS features">
      <a href="/features/restaurant-order-management/">{copy.orderLinkLabel}<Mark /></a>
      <a href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a>
      <a href="/features/restaurant-cash-management/">Cash management<Mark /></a>
    </section>

    <section class="bakery-faq container" aria-labelledby="bakery-faq-title">
      <div class="bakery-faq-intro">
        <p class="bakery-kicker">{copy.faqKicker}</p>
        <h2 id="bakery-faq-title">{copy.faqTitle}</h2>
        <p>{copy.faqDescription}</p>
      </div>
      <div class="bakery-faq-list">
        {bakeryLists.faqs.map(({ question, answer }) => (
          <details>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="bakery-cta">
      <div class="container bakery-cta-inner">
        <div>
          <p class="bakery-kicker">{copy.ctaKicker}</p>
          <h2>{copy.ctaTitle}</h2>
          <p>{copy.ctaDescription}</p>
        </div>
        <a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
.bakery-page{overflow:hidden}.bakery-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.bakery-breadcrumb a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.bakery-breadcrumb [aria-current=page]{color:var(--ink)}.bakery-kicker{display:flex;align-items:center;gap:10px;color:#963b18;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.bakery-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}
.bakery-hero{display:grid;grid-template-columns:minmax(300px,.78fr) minmax(0,1.22fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:66px 78px}.bakery-hero h1{max-width:620px;font-size:clamp(49px,5.3vw,72px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.bakery-lede{max-width:570px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.bakery-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.bakery-actions .button{gap:20px}.bakery-screen{min-width:0;padding:17px 18px 14px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.bakery-screen figcaption,.bakery-report-screen figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 16px;color:#4f554c;font-size:11px}.bakery-screen figcaption span:first-child,.bakery-report-screen figcaption span:first-child{font-weight:700;color:var(--ink)}.bakery-bezel{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.bakery-bezel picture,.bakery-bezel img{display:block;width:100%;height:auto}.bakery-bezel img{border-radius:4px}.bakery-stand{width:28%;height:24px;margin:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}.bakery-screen>p,.bakery-report-screen>p{padding-top:12px;color:#62665d;font-size:13px}
.bakery-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 86px;border-top:1px solid var(--line)}.bakery-overview h2,.bakery-section-head h2,.bakery-orders h2,.bakery-handoff h2,.bakery-reports h2,.bakery-platform h2,.bakery-faq h2,.bakery-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.bakery-copy p,.bakery-reports-inner>div>p:not(.bakery-kicker),.bakery-platform>div>p:last-child{color:#51574e;font-size:15px;line-height:1.8}.bakery-copy p+p{margin-top:13px}.bakery-services,.bakery-workflow{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.bakery-section-head{max-width:760px}.bakery-services .bakery-kicker,.bakery-workflow .bakery-kicker{color:#ffb17d}.bakery-section-head>p:last-child{max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:15px}.bakery-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;margin-top:38px;border-top:1px solid #60665b;border-left:1px solid #60665b}.bakery-service-grid li{min-height:210px;padding:23px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.bakery-service-grid li>span,.bakery-setup-grid li>span,.bakery-workflow-list li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.08em}.bakery-service-grid h3{font-size:22px;margin-top:28px}.bakery-service-grid p,.bakery-setup-grid p,.bakery-workflow-list p{max-width:350px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}.bakery-orders{display:grid;grid-template-columns:minmax(0,.83fr) minmax(0,1.17fr);gap:clamp(38px,7vw,92px);padding-block:86px}.bakery-order-heading>p:last-child{color:#51574e;font-size:15px;line-height:1.8;margin-top:17px}.bakery-setup-grid{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:4px;border-top:1px solid var(--line)}.bakery-setup-grid li{min-height:185px;padding:20px 20px 18px 0;border-right:1px solid var(--line)}.bakery-setup-grid li+li{padding-left:20px}.bakery-setup-grid li:last-child{border-right:0}.bakery-setup-grid li>span{color:#963b18}.bakery-setup-grid h3{font-size:19px;line-height:1.3;margin-top:18px}.bakery-setup-grid p{color:#51574e;font-size:13px;margin-top:9px}.bakery-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:39px;border-top:1px solid #60665b}.bakery-workflow-list li{min-height:195px;padding:21px 20px 0 0;border-right:1px solid #60665b}.bakery-workflow-list li+li{padding-left:21px}.bakery-workflow-list li:last-child{border-right:0}.bakery-workflow-list h3{font-size:20px;line-height:1.25;margin-top:25px}.bakery-handoff{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:86px}.bakery-handoff h2{max-width:600px}.bakery-handoff .bakery-copy .text-link{display:flex;width:max-content;margin-top:17px}.bakery-reports{padding-block:72px;background:#e8ecdf}.bakery-reports-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.48fr);gap:clamp(38px,7vw,90px);align-items:center}.bakery-reports h2{max-width:620px}.bakery-reports-inner>div>p:not(.bakery-kicker){max-width:720px;margin-top:18px;color:#42493f}.bakery-reports-inner .text-link{display:inline-flex;margin-top:20px;color:#783516;font-weight:700}.bakery-report-screen{max-width:330px;justify-self:center;padding:15px;border:1px solid #d5d9cc;border-radius:16px;background:#f7f8f2}.bakery-report-screen figcaption{font-size:10px;margin-bottom:13px}.bakery-phone-bezel{max-width:210px;margin-inline:auto;padding:6px;border:3px solid #252a24;border-radius:27px;background:#20231f}.bakery-phone-bezel img{display:block;width:100%;height:auto;border-radius:19px}.bakery-platform{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:36px;align-items:center;padding-block:82px}.bakery-platform h2{max-width:620px}.bakery-platform>div>p:last-child{max-width:700px;margin-top:16px}.bakery-platform-list{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:13px;font-weight:700}.bakery-platform-list i{width:4px;height:4px;border-radius:50%;background:#963b18}.bakery-related{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding-block:26px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.bakery-related a{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#85310e;font-size:13px;font-weight:700;text-decoration:none}.bakery-faq{display:grid;grid-template-columns:minmax(230px,.72fr) minmax(0,1.28fr);gap:clamp(36px,7vw,88px);padding-block:82px}.bakery-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:15px}.bakery-faq-list details{border-top:1px solid var(--line)}.bakery-faq-list details:last-child{border-bottom:1px solid var(--line)}.bakery-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:64px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.bakery-faq-list summary::-webkit-details-marker{display:none}.bakery-faq-list summary span{font-size:24px;font-weight:400;color:#963b18;flex:none;transition:transform .18s}.bakery-faq-list details[open] summary span{transform:rotate(45deg)}.bakery-faq-list details>p{padding:0 35px 19px 0;color:#51574e;font-size:13px;line-height:1.8}.bakery-cta{padding-block:62px;background:#f0caa8}.bakery-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.bakery-cta .bakery-kicker{color:#783516}.bakery-cta h2{max-width:700px}.bakery-cta-inner>div>p:last-child{max-width:570px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.bakery-cta .button{flex:none}
@media(max-width:1050px){.bakery-service-grid{grid-template-columns:1fr}.bakery-service-grid li{min-height:0}.bakery-service-grid h3{margin-top:16px}.bakery-setup-grid{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:15px}.bakery-setup-grid li:nth-child(2){border-right:0}.bakery-setup-grid li:nth-child(3){padding-left:0}.bakery-setup-grid li{min-height:0}.bakery-workflow-list{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:25px}.bakery-workflow-list li:nth-child(2){border-right:0}.bakery-workflow-list li:nth-child(3){padding-left:0}.bakery-workflow-list li{min-height:165px}}
@media(max-width:950px){.bakery-hero{grid-template-columns:1fr;padding-block:56px 66px}.bakery-hero-copy{max-width:750px}.bakery-screen{max-width:850px;width:100%;margin-inline:auto}.bakery-overview,.bakery-orders,.bakery-handoff{grid-template-columns:1fr;gap:30px}.bakery-overview{padding-block:60px}.bakery-orders,.bakery-handoff{padding-block:65px}.bakery-reports-inner{grid-template-columns:minmax(0,1fr) minmax(220px,.5fr);gap:32px}.bakery-platform{grid-template-columns:1fr;gap:25px}}
@media(max-width:700px){.bakery-breadcrumb{padding-top:14px;font-size:10px;gap:7px}.bakery-hero{padding-block:43px 54px;gap:26px}.bakery-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.bakery-lede{font-size:14px;margin-top:16px}.bakery-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.bakery-actions .button{width:100%;justify-content:space-between}.bakery-screen{padding:13px 11px 12px;border-radius:13px}.bakery-screen figcaption,.bakery-report-screen figcaption{font-size:9px;gap:8px;margin-bottom:11px}.bakery-bezel{max-width:380px;margin-inline:auto;padding:6px;border-width:2px;border-radius:22px}.bakery-bezel img{border-radius:14px}.bakery-stand{display:none}.bakery-screen>p,.bakery-report-screen>p{font-size:12px}.bakery-overview{padding-block:52px 59px;gap:22px}.bakery-overview h2,.bakery-section-head h2,.bakery-orders h2,.bakery-handoff h2,.bakery-reports h2,.bakery-platform h2,.bakery-faq h2,.bakery-cta h2{font-size:clamp(35px,9vw,46px)}.bakery-copy p,.bakery-order-heading>p:last-child,.bakery-reports-inner>div>p:not(.bakery-kicker),.bakery-platform>div>p:last-child{font-size:14px}.bakery-services,.bakery-workflow{padding-block:59px 64px}.bakery-section-head>p:last-child{font-size:14px}.bakery-service-grid{margin-top:27px}.bakery-service-grid li{padding:18px}.bakery-service-grid h3{font-size:19px;margin-top:13px}.bakery-service-grid p,.bakery-setup-grid p,.bakery-workflow-list p{font-size:13px}.bakery-orders,.bakery-handoff{padding-block:59px;gap:24px}.bakery-setup-grid{grid-template-columns:1fr;margin-top:0;row-gap:0}.bakery-setup-grid li,.bakery-setup-grid li+li{padding:17px 0;border-right:0;border-bottom:1px solid var(--line)}.bakery-setup-grid li:last-child{border-bottom:0}.bakery-setup-grid h3{font-size:18px;margin-top:10px}.bakery-workflow-list{grid-template-columns:1fr;margin-top:28px;row-gap:0}.bakery-workflow-list li,.bakery-workflow-list li+li{min-height:0;padding:17px 0;border-right:0;border-bottom:1px solid #60665b}.bakery-workflow-list li:last-child{border-bottom:0}.bakery-workflow-list h3{font-size:19px;margin-top:10px}.bakery-reports{padding-block:59px}.bakery-reports-inner{grid-template-columns:1fr;gap:30px}.bakery-report-screen{max-width:310px;width:100%;margin-top:9px}.bakery-platform{padding-block:62px;gap:23px}.bakery-platform-list{gap:8px;font-size:12px}.bakery-related{grid-template-columns:1fr;gap:0;padding-block:10px}.bakery-related a{padding:14px 0;border-bottom:1px solid var(--line)}.bakery-related a:last-child{border-bottom:0}.bakery-faq{grid-template-columns:1fr;gap:21px;padding-block:59px}.bakery-faq-list summary{min-height:61px;font-size:13px}.bakery-faq-list details>p{font-size:12px}.bakery-cta{padding-block:50px}.bakery-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.bakery-cta-inner>div>p:last-child{font-size:13px}.bakery-cta .button{width:100%;justify-content:space-between}}
@media(prefers-reduced-motion:reduce){.bakery-faq-list summary span{transition:none}.bakery-faq-list details[open] summary span{transform:none}}
</style>
