---
import { getEntry } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const entry = await getEntry('pages', 'qsr-pos');
if (!entry) throw new Error('CMS content entry "qsr-pos" is missing.');
const { seo, copy, qsrLists, imageAlt } = entry.data;
if (!qsrLists?.serviceTypes.length || !qsrLists.comboSetup.length || !qsrLists.workflowSteps.length || !qsrLists.faqs.length || !imageAlt?.qsrPosMenu || !imageAlt?.qsrPosReports) {
  throw new Error('QSR POS page content is incomplete.');
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
      { '@type': 'ListItem', position: 2, name: 'QSR POS', item: seo.canonical }
    ]
  }
};
---

<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="qsr-page">
    <nav class="qsr-breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span>
    </nav>

    <section class="qsr-hero container" aria-labelledby="qsr-title">
      <div class="qsr-hero-copy">
        <p class="qsr-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="qsr-title">{copy.heroTitle}</h1>
        <p class="qsr-lede">{copy.heroDescription}</p>
        <div class="qsr-actions">
          <a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a>
          <a class="text-link" href="#qsr-workflow">{copy.workflowCta}<Mark name="down" /></a>
        </div>
      </div>
      <figure class="qsr-screen">
        <figcaption><span>{copy.menuScreenLabel}</span><span>{copy.menuScreenDataLabel}</span></figcaption>
        <div class="qsr-monitor">
          <div class="qsr-bezel">
            <picture>
              <source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-with-photos-mobile.webp" width="872" height="1804"/>
              <source media="(max-width: 1100px)" srcset="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656"/>
              <img src="/pos-images/restabee-restaurant-pos-menu-with-photos-desktop.webp" width="1548" height="1016" alt={imageAlt.qsrPosMenu} fetchpriority="high" decoding="async"/>
            </picture>
          </div>
          <div class="qsr-stand" aria-hidden="true"></div>
        </div>
        <p>{copy.menuScreenCaption}</p>
      </figure>
    </section>

    <section class="qsr-overview container" aria-labelledby="qsr-overview-title">
      <div>
        <p class="qsr-kicker">{copy.overviewKicker}</p>
        <h2 id="qsr-overview-title">{copy.overviewTitle}</h2>
      </div>
      <div class="qsr-copy">
        <p>{copy.overviewParagraphOne}</p>
        <p>{copy.overviewParagraphTwo}</p>
        <p>{copy.overviewParagraphThree}</p>
      </div>
    </section>

    <section class="qsr-services" aria-labelledby="qsr-service-title">
      <div class="container">
        <header class="qsr-section-head">
          <p class="qsr-kicker">{copy.serviceKicker}</p>
          <h2 id="qsr-service-title">{copy.serviceTitle}</h2>
          <p>{copy.serviceDescription}</p>
        </header>
        <ul class="qsr-service-grid" aria-label={copy.serviceListLabel}>
          {qsrLists.serviceTypes.map((item, index) => (
            <li><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="qsr-combos container" aria-labelledby="qsr-combo-title">
      <div class="qsr-combo-heading">
        <p class="qsr-kicker">{copy.comboKicker}</p>
        <h2 id="qsr-combo-title">{copy.comboTitle}</h2>
        <p>{copy.comboDescription}</p>
      </div>
      <div class="qsr-combo-copy">
        <p>{copy.comboParagraphOne}</p>
        <p>{copy.comboParagraphTwo}</p>
        <p>{copy.comboParagraphThree}</p>
      </div>
      <ul class="qsr-setup-grid" aria-label={copy.comboListLabel}>
        {qsrLists.comboSetup.map((item, index) => (
          <li><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></li>
        ))}
      </ul>
    </section>

    <section class="qsr-workflow" id="qsr-workflow" aria-labelledby="qsr-workflow-title">
      <div class="container">
        <header class="qsr-section-head">
          <p class="qsr-kicker">{copy.workflowKicker}</p>
          <h2 id="qsr-workflow-title">{copy.workflowTitle}</h2>
          <p>{copy.workflowDescription}</p>
        </header>
        <ol class="qsr-workflow-list" aria-label={copy.workflowListLabel}>
          {qsrLists.workflowSteps.map(step => (
            <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="qsr-handoff container" aria-labelledby="qsr-handoff-title">
      <div class="qsr-handoff-heading">
        <p class="qsr-kicker">{copy.handoffKicker}</p>
        <h2 id="qsr-handoff-title">{copy.handoffTitle}</h2>
      </div>
      <div class="qsr-copy">
        <p>{copy.handoffParagraphOne}</p>
        <p>{copy.handoffParagraphTwo}</p>
        <p>{copy.handoffParagraphThree}</p>
        <a class="text-link" href="/features/kitchen-display-system/">{copy.kdsLinkLabel}<Mark /></a>
        <a class="text-link" href="/features/restaurant-menu-management/">{copy.menuLinkLabel}<Mark /></a>
        <a class="text-link" href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a>
      </div>
    </section>

    <section class="qsr-reports">
      <div class="container qsr-reports-inner">
        <div>
          <p class="qsr-kicker">{copy.reportKicker}</p>
          <h2>{copy.reportTitle}</h2>
          <p>{copy.reportDescription}</p>
          <a class="text-link" href="/features/restaurant-sales-reports/">{copy.reportLinkLabel}<Mark /></a>
        </div>
        <figure class="qsr-report-screen">
          <figcaption><span>{copy.reportScreenLabel}</span><span>{copy.reportScreenDataLabel}</span></figcaption>
          <div class="qsr-phone-bezel">
            <img src="/pos-images/restabee-pos-reports-mobile.webp" width="800" height="1656" alt={imageAlt.qsrPosReports} loading="lazy" decoding="async"/>
          </div>
          <p>{copy.reportScreenCaption}</p>
        </figure>
      </div>
    </section>

    <section class="qsr-platform container" aria-labelledby="qsr-platform-title">
      <div>
        <p class="qsr-kicker">{copy.platformKicker}</p>
        <h2 id="qsr-platform-title">{copy.platformTitle}</h2>
        <p>{copy.platformDescription}</p>
      </div>
      <div class="qsr-platform-list" aria-label="Supported platforms">
        <span>Desktop</span><i></i><span>Tablet</span><i></i><span>Phone</span>
      </div>
    </section>

    <section class="qsr-related container" aria-label="Related restaurant POS features">
      <a href="/features/restaurant-order-management/">{copy.orderLinkLabel}<Mark /></a>
      <a href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a>
      <a href="/features/kitchen-display-system/">{copy.kdsLinkLabel}<Mark /></a>
    </section>

    <section class="qsr-faq container" aria-labelledby="qsr-faq-title">
      <div class="qsr-faq-intro">
        <p class="qsr-kicker">{copy.faqKicker}</p>
        <h2 id="qsr-faq-title">{copy.faqTitle}</h2>
        <p>{copy.faqDescription}</p>
      </div>
      <div class="qsr-faq-list">
        {qsrLists.faqs.map(({ question, answer }) => (
          <details>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="qsr-cta">
      <div class="container qsr-cta-inner">
        <div>
          <p class="qsr-kicker">{copy.ctaKicker}</p>
          <h2>{copy.ctaTitle}</h2>
          <p>{copy.ctaDescription}</p>
        </div>
        <a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
.qsr-page{overflow:hidden}.qsr-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.qsr-breadcrumb a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.qsr-breadcrumb [aria-current=page]{color:var(--ink)}.qsr-kicker{display:flex;align-items:center;gap:10px;color:#963b18;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.qsr-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}
.qsr-hero{display:grid;grid-template-columns:minmax(300px,.78fr) minmax(0,1.22fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:66px 78px}.qsr-hero h1{max-width:620px;font-size:clamp(49px,5.3vw,72px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.qsr-lede{max-width:570px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.qsr-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.qsr-actions .button{gap:20px}.qsr-screen{min-width:0;padding:17px 18px 14px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.qsr-screen figcaption,.qsr-report-screen figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 16px;color:#4f554c;font-size:11px}.qsr-screen figcaption span:first-child,.qsr-report-screen figcaption span:first-child{font-weight:700;color:var(--ink)}.qsr-bezel{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.qsr-bezel picture,.qsr-bezel img{display:block;width:100%;height:auto}.qsr-bezel img{border-radius:4px}.qsr-stand{width:28%;height:24px;margin:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}.qsr-screen>p,.qsr-report-screen>p{padding-top:12px;color:#62665d;font-size:13px}
.qsr-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 86px;border-top:1px solid var(--line)}.qsr-overview h2,.qsr-section-head h2,.qsr-combos h2,.qsr-handoff h2,.qsr-reports h2,.qsr-platform h2,.qsr-faq h2,.qsr-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.qsr-copy p,.qsr-reports-inner>div>p:not(.qsr-kicker),.qsr-platform>div>p:last-child{color:#51574e;font-size:15px;line-height:1.8}.qsr-copy p+p{margin-top:13px}.qsr-services,.qsr-workflow{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.qsr-section-head{max-width:760px}.qsr-services .qsr-kicker,.qsr-workflow .qsr-kicker{color:#ffb17d}.qsr-section-head>p:last-child{max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:15px}.qsr-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;margin-top:38px;border-top:1px solid #60665b;border-left:1px solid #60665b}.qsr-service-grid li{min-height:210px;padding:23px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.qsr-service-grid li>span,.qsr-setup-grid li>span,.qsr-workflow-list li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.08em}.qsr-service-grid h3{font-size:22px;margin-top:28px}.qsr-service-grid p,.qsr-setup-grid p,.qsr-workflow-list p{max-width:350px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}.qsr-combos{display:grid;grid-template-columns:minmax(0,.83fr) minmax(0,1.17fr);gap:clamp(38px,7vw,92px);padding-block:86px}.qsr-combo-heading>p:last-child{color:#51574e;font-size:15px;line-height:1.8;margin-top:17px}.qsr-setup-grid{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:4px;border-top:1px solid var(--line)}.qsr-setup-grid li{min-height:185px;padding:20px 20px 18px 0;border-right:1px solid var(--line)}.qsr-setup-grid li+li{padding-left:20px}.qsr-setup-grid li:last-child{border-right:0}.qsr-setup-grid li>span{color:#963b18}.qsr-setup-grid h3{font-size:19px;line-height:1.3;margin-top:18px}.qsr-setup-grid p{color:#51574e;font-size:13px;margin-top:9px}.qsr-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:39px;border-top:1px solid #60665b}.qsr-workflow-list li{min-height:195px;padding:21px 20px 0 0;border-right:1px solid #60665b}.qsr-workflow-list li+li{padding-left:21px}.qsr-workflow-list li:last-child{border-right:0}.qsr-workflow-list h3{font-size:20px;line-height:1.25;margin-top:25px}.qsr-handoff{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:86px}.qsr-handoff h2{max-width:600px}.qsr-handoff .qsr-copy .text-link{display:flex;width:max-content;margin-top:17px}.qsr-reports{padding-block:72px;background:#e8ecdf}.qsr-reports-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.48fr);gap:clamp(38px,7vw,90px);align-items:center}.qsr-reports h2{max-width:620px}.qsr-reports-inner>div>p:not(.qsr-kicker){max-width:720px;margin-top:18px;color:#42493f}.qsr-reports-inner .text-link{display:inline-flex;margin-top:20px;color:#783516;font-weight:700}.qsr-report-screen{max-width:330px;justify-self:center;padding:15px;border:1px solid #d5d9cc;border-radius:16px;background:#f7f8f2}.qsr-report-screen figcaption{font-size:10px;margin-bottom:13px}.qsr-phone-bezel{max-width:210px;margin-inline:auto;padding:6px;border:3px solid #252a24;border-radius:27px;background:#20231f}.qsr-phone-bezel img{display:block;width:100%;height:auto;border-radius:19px}.qsr-platform{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:36px;align-items:center;padding-block:82px}.qsr-platform h2{max-width:620px}.qsr-platform>div>p:last-child{max-width:700px;margin-top:16px}.qsr-platform-list{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:13px;font-weight:700}.qsr-platform-list i{width:4px;height:4px;border-radius:50%;background:#963b18}.qsr-related{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding-block:26px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.qsr-related a{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#85310e;font-size:13px;font-weight:700;text-decoration:none}.qsr-faq{display:grid;grid-template-columns:minmax(230px,.72fr) minmax(0,1.28fr);gap:clamp(36px,7vw,88px);padding-block:82px}.qsr-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:15px}.qsr-faq-list details{border-top:1px solid var(--line)}.qsr-faq-list details:last-child{border-bottom:1px solid var(--line)}.qsr-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:64px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.qsr-faq-list summary::-webkit-details-marker{display:none}.qsr-faq-list summary span{font-size:24px;font-weight:400;color:#963b18;flex:none;transition:transform .18s}.qsr-faq-list details[open] summary span{transform:rotate(45deg)}.qsr-faq-list details>p{padding:0 35px 19px 0;color:#51574e;font-size:13px;line-height:1.8}.qsr-cta{padding-block:62px;background:#f0caa8}.qsr-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.qsr-cta .qsr-kicker{color:#783516}.qsr-cta h2{max-width:700px}.qsr-cta-inner>div>p:last-child{max-width:570px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.qsr-cta .button{flex:none}
@media(max-width:1050px){.qsr-service-grid{grid-template-columns:1fr}.qsr-service-grid li{min-height:0}.qsr-service-grid h3{margin-top:16px}.qsr-setup-grid{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:15px}.qsr-setup-grid li:nth-child(2){border-right:0}.qsr-setup-grid li:nth-child(3){padding-left:0}.qsr-setup-grid li{min-height:0}.qsr-workflow-list{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:25px}.qsr-workflow-list li:nth-child(2){border-right:0}.qsr-workflow-list li:nth-child(3){padding-left:0}.qsr-workflow-list li{min-height:165px}}
@media(max-width:950px){.qsr-hero{grid-template-columns:1fr;padding-block:56px 66px}.qsr-hero-copy{max-width:750px}.qsr-screen{max-width:850px;width:100%;margin-inline:auto}.qsr-overview,.qsr-combos,.qsr-handoff{grid-template-columns:1fr;gap:30px}.qsr-overview{padding-block:60px}.qsr-combos,.qsr-handoff{padding-block:65px}.qsr-reports-inner{grid-template-columns:minmax(0,1fr) minmax(220px,.5fr);gap:32px}.qsr-platform{grid-template-columns:1fr;gap:25px}}
@media(max-width:700px){.qsr-breadcrumb{padding-top:14px;font-size:10px;gap:7px}.qsr-hero{padding-block:43px 54px;gap:26px}.qsr-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.qsr-lede{font-size:14px;margin-top:16px}.qsr-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.qsr-actions .button{width:100%;justify-content:space-between}.qsr-screen{padding:13px 11px 12px;border-radius:13px}.qsr-screen figcaption,.qsr-report-screen figcaption{font-size:9px;gap:8px;margin-bottom:11px}.qsr-bezel{max-width:380px;margin-inline:auto;padding:6px;border-width:2px;border-radius:22px}.qsr-bezel img{border-radius:14px}.qsr-stand{display:none}.qsr-screen>p,.qsr-report-screen>p{font-size:12px}.qsr-overview{padding-block:52px 59px;gap:22px}.qsr-overview h2,.qsr-section-head h2,.qsr-combos h2,.qsr-handoff h2,.qsr-reports h2,.qsr-platform h2,.qsr-faq h2,.qsr-cta h2{font-size:clamp(35px,9vw,46px)}.qsr-copy p,.qsr-combo-heading>p:last-child,.qsr-reports-inner>div>p:not(.qsr-kicker),.qsr-platform>div>p:last-child{font-size:14px}.qsr-services,.qsr-workflow{padding-block:59px 64px}.qsr-section-head>p:last-child{font-size:14px}.qsr-service-grid{margin-top:27px}.qsr-service-grid li{padding:18px}.qsr-service-grid h3{font-size:19px;margin-top:13px}.qsr-service-grid p,.qsr-setup-grid p,.qsr-workflow-list p{font-size:13px}.qsr-combos,.qsr-handoff{padding-block:59px;gap:24px}.qsr-setup-grid{grid-template-columns:1fr;margin-top:0;row-gap:0}.qsr-setup-grid li,.qsr-setup-grid li+li{padding:17px 0;border-right:0;border-bottom:1px solid var(--line)}.qsr-setup-grid li:last-child{border-bottom:0}.qsr-setup-grid h3{font-size:18px;margin-top:10px}.qsr-workflow-list{grid-template-columns:1fr;margin-top:28px;row-gap:0}.qsr-workflow-list li,.qsr-workflow-list li+li{min-height:0;padding:17px 0;border-right:0;border-bottom:1px solid #60665b}.qsr-workflow-list li:last-child{border-bottom:0}.qsr-workflow-list h3{font-size:19px;margin-top:10px}.qsr-reports{padding-block:59px}.qsr-reports-inner{grid-template-columns:1fr;gap:30px}.qsr-report-screen{max-width:310px;width:100%;margin-top:9px}.qsr-platform{padding-block:62px;gap:23px}.qsr-platform-list{gap:8px;font-size:12px}.qsr-related{grid-template-columns:1fr;gap:0;padding-block:10px}.qsr-related a{padding:14px 0;border-bottom:1px solid var(--line)}.qsr-related a:last-child{border-bottom:0}.qsr-faq{grid-template-columns:1fr;gap:21px;padding-block:59px}.qsr-faq-list summary{min-height:61px;font-size:13px}.qsr-faq-list details>p{font-size:12px}.qsr-cta{padding-block:50px}.qsr-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.qsr-cta-inner>div>p:last-child{font-size:13px}.qsr-cta .button{width:100%;justify-content:space-between}}
@media(prefers-reduced-motion:reduce){.qsr-faq-list summary span{transition:none}.qsr-faq-list details[open] summary span{transform:none}}
</style>
