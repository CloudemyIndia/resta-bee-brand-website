---
import { getEntry } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
const entry = await getEntry('pages', 'cafe-pos');
if (!entry) throw new Error('CMS content entry "cafe-pos" is missing.');
const { seo, copy, cafeLists, imageAlt } = entry.data;
if (!cafeLists?.serviceTypes.length || !cafeLists.drinkSetup.length || !cafeLists.workflowSteps.length || !cafeLists.faqs.length || !imageAlt?.cafePosMenu || !imageAlt?.cafePosReports) throw new Error('Cafe POS page content is incomplete.');
const schema = {'@context':'https://schema.org','@type':'WebPage',name:seo.title,url:seo.canonical,description:seo.description,isPartOf:{'@type':'WebSite',name:'RestaBee',url:'https://restabee.com/'},about:{'@type':'SoftwareApplication',name:'RestaBee',applicationCategory:'BusinessApplication',operatingSystem:'Web'},breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Restaurant POS',item:'https://restabee.com/'},{'@type':'ListItem',position:2,name:'Cafe POS',item:seo.canonical}]}};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="cafe-page">
    <nav class="cafe-breadcrumb container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span></nav>
    <section class="cafe-hero container" aria-labelledby="cafe-title">
      <div class="cafe-hero-copy"><p class="cafe-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p><h1 id="cafe-title">{copy.heroTitle}</h1><p class="cafe-lede">{copy.heroDescription}</p><div class="cafe-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#cafe-workflow">{copy.workflowCta}<Mark name="down" /></a></div></div>
      <figure class="cafe-screen"><figcaption><span>{copy.menuScreenLabel}</span><span>{copy.menuScreenDataLabel}</span></figcaption><div class="cafe-monitor"><div class="cafe-bezel"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-with-photos-mobile.webp" width="872" height="1804"/><source media="(max-width: 1100px)" srcset="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656"/><img src="/pos-images/restabee-restaurant-pos-menu-with-photos-desktop.webp" width="1548" height="1016" alt={imageAlt.cafePosMenu} fetchpriority="high" decoding="async"/></picture></div><div class="cafe-stand" aria-hidden="true"></div></div><p>{copy.menuScreenCaption}</p></figure>
    </section>
    <section class="cafe-overview container" aria-labelledby="cafe-overview-title"><div><p class="cafe-kicker">{copy.overviewKicker}</p><h2 id="cafe-overview-title">{copy.overviewTitle}</h2></div><div class="cafe-copy"><p>{copy.overviewParagraphOne}</p><p>{copy.overviewParagraphTwo}</p><p>{copy.overviewParagraphThree}</p></div></section>
    <section class="cafe-services" aria-labelledby="cafe-service-title"><div class="container"><header class="cafe-section-head"><p class="cafe-kicker">{copy.serviceKicker}</p><h2 id="cafe-service-title">{copy.serviceTitle}</h2><p>{copy.serviceDescription}</p></header><ul class="cafe-service-grid" aria-label={copy.serviceListLabel}>{cafeLists.serviceTypes.map((item,index)=><li><span>0{index+1}</span><h3>{item.title}</h3><p>{item.description}</p></li>)}</ul></div></section>
    <section class="cafe-drinks container" aria-labelledby="cafe-drink-title"><div class="cafe-drink-heading"><p class="cafe-kicker">{copy.drinkKicker}</p><h2 id="cafe-drink-title">{copy.drinkTitle}</h2><p>{copy.drinkDescription}</p></div><div class="cafe-drink-copy"><p>{copy.drinkParagraphOne}</p><p>{copy.drinkParagraphTwo}</p><p>{copy.drinkParagraphThree}</p></div><ul class="cafe-setup-grid" aria-label={copy.setupListLabel}>{cafeLists.drinkSetup.map((item,index)=><li><span>0{index+1}</span><h3>{item.title}</h3><p>{item.description}</p></li>)}</ul></section>
    <section class="cafe-workflow" id="cafe-workflow" aria-labelledby="cafe-workflow-title"><div class="container"><header class="cafe-section-head"><p class="cafe-kicker">{copy.workflowKicker}</p><h2 id="cafe-workflow-title">{copy.workflowTitle}</h2><p>{copy.workflowDescription}</p></header><ol class="cafe-workflow-list" aria-label={copy.workflowListLabel}>{cafeLists.workflowSteps.map(step=><li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></div></section>
    <section class="cafe-handoff container" aria-labelledby="cafe-handoff-title"><div class="cafe-handoff-heading"><p class="cafe-kicker">{copy.handoffKicker}</p><h2 id="cafe-handoff-title">{copy.handoffTitle}</h2></div><div class="cafe-copy"><p>{copy.handoffParagraphOne}</p><p>{copy.handoffParagraphTwo}</p><p>{copy.handoffParagraphThree}</p><a class="text-link" href="/features/kitchen-display-system/">{copy.kdsLinkLabel}<Mark /></a><a class="text-link" href="/features/restaurant-menu-management/">{copy.menuLinkLabel}<Mark /></a><a class="text-link" href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a></div></section>
    <section class="cafe-reports"><div class="container cafe-reports-inner"><div><p class="cafe-kicker">{copy.reportKicker}</p><h2>{copy.reportTitle}</h2><p>{copy.reportDescription}</p><a class="text-link" href="/features/multi-outlet-restaurant-management/">{copy.reportLinkLabel}<Mark /></a></div><figure class="cafe-report-screen"><figcaption><span>{copy.reportScreenLabel}</span><span>{copy.reportScreenDataLabel}</span></figcaption><div class="cafe-phone-bezel"><img src="/pos-images/restabee-pos-reports-mobile.webp" width="800" height="1656" alt={imageAlt.cafePosReports} loading="lazy" decoding="async"/></div><p>{copy.reportScreenCaption}</p></figure></div></section>
    <section class="cafe-platform container" aria-labelledby="cafe-platform-title"><div><p class="cafe-kicker">{copy.platformKicker}</p><h2 id="cafe-platform-title">{copy.platformTitle}</h2><p>{copy.platformDescription}</p></div><div class="cafe-platform-list" aria-label="Supported platforms"><span>Desktop</span><i></i><span>Tablet</span><i></i><span>Phone</span></div></section>
    <section class="cafe-related container" aria-label="Related restaurant POS features"><a href="/features/restaurant-menu-management/">{copy.menuLinkLabel}<Mark /></a><a href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a><a href="/#qr-ordering">Table QR ordering<Mark /></a></section>
    <section class="cafe-faq container" aria-labelledby="cafe-faq-title"><div class="cafe-faq-intro"><p class="cafe-kicker">{copy.faqKicker}</p><h2 id="cafe-faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div><div class="cafe-faq-list">{cafeLists.faqs.map(({question,answer})=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <section class="cafe-cta"><div class="container cafe-cta-inner"><div><p class="cafe-kicker">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p></div><a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a></div></section>
  </main><SiteFooter />
</SiteLayout>
<style>
.cafe-page{overflow:hidden}.cafe-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.cafe-breadcrumb a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.cafe-breadcrumb [aria-current=page]{color:var(--ink)}.cafe-kicker{display:flex;align-items:center;gap:10px;color:#963b18;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.cafe-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}
.cafe-hero{display:grid;grid-template-columns:minmax(300px,.78fr) minmax(0,1.22fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:66px 78px}.cafe-hero h1{max-width:620px;font-size:clamp(49px,5.3vw,72px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.cafe-lede{max-width:570px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.cafe-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.cafe-actions .button{gap:20px}.cafe-screen{min-width:0;padding:17px 18px 14px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.cafe-screen figcaption,.cafe-report-screen figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 16px;color:#4f554c;font-size:11px}.cafe-screen figcaption span:first-child,.cafe-report-screen figcaption span:first-child{font-weight:700;color:var(--ink)}.cafe-bezel{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.cafe-bezel picture,.cafe-bezel img{display:block;width:100%;height:auto}.cafe-bezel img{border-radius:4px}.cafe-stand{width:28%;height:24px;margin:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}.cafe-screen>p,.cafe-report-screen>p{padding-top:12px;color:#62665d;font-size:13px}
.cafe-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 86px;border-top:1px solid var(--line)}.cafe-overview h2,.cafe-section-head h2,.cafe-drink h2,.cafe-handoff h2,.cafe-reports h2,.cafe-platform h2,.cafe-faq h2,.cafe-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.cafe-copy p,.cafe-reports-inner>div>p:not(.cafe-kicker),.cafe-platform>div>p:last-child{color:#51574e;font-size:15px;line-height:1.8}.cafe-copy p+p{margin-top:13px}.cafe-services,.cafe-workflow{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.cafe-section-head{max-width:760px}.cafe-services .cafe-kicker,.cafe-workflow .cafe-kicker{color:#ffb17d}.cafe-section-head>p:last-child{max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:15px}.cafe-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;margin-top:38px;border-top:1px solid #60665b;border-left:1px solid #60665b}.cafe-service-grid li{min-height:210px;padding:23px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.cafe-service-grid li>span,.cafe-setup-grid li>span,.cafe-workflow-list li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.08em}.cafe-service-grid h3{font-size:22px;margin-top:28px}.cafe-service-grid p,.cafe-setup-grid p,.cafe-workflow-list p{max-width:350px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}.cafe-drinks{display:grid;grid-template-columns:minmax(0,.83fr) minmax(0,1.17fr);gap:clamp(38px,7vw,92px);padding-block:86px}.cafe-drink-heading>p:last-child{color:#51574e;font-size:15px;line-height:1.8;margin-top:17px}.cafe-setup-grid{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:4px;border-top:1px solid var(--line)}.cafe-setup-grid li{min-height:185px;padding:20px 20px 18px 0;border-right:1px solid var(--line)}.cafe-setup-grid li+li{padding-left:20px}.cafe-setup-grid li:last-child{border-right:0}.cafe-setup-grid li>span{color:#963b18}.cafe-setup-grid h3{font-size:19px;line-height:1.3;margin-top:18px}.cafe-setup-grid p{color:#51574e;font-size:13px;margin-top:9px}.cafe-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:39px;border-top:1px solid #60665b}.cafe-workflow-list li{min-height:195px;padding:21px 20px 0 0;border-right:1px solid #60665b}.cafe-workflow-list li+li{padding-left:21px}.cafe-workflow-list li:last-child{border-right:0}.cafe-workflow-list h3{font-size:20px;line-height:1.25;margin-top:25px}.cafe-handoff{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:86px}.cafe-handoff h2{max-width:600px}.cafe-handoff .cafe-copy .text-link{display:flex;width:max-content;margin-top:17px}.cafe-reports{padding-block:72px;background:#e8ecdf}.cafe-reports-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.48fr);gap:clamp(38px,7vw,90px);align-items:center}.cafe-reports h2{max-width:620px}.cafe-reports-inner>div>p:not(.cafe-kicker){max-width:720px;margin-top:18px;color:#42493f}.cafe-reports-inner .text-link{display:inline-flex;margin-top:20px;color:#783516;font-weight:700}.cafe-report-screen{max-width:330px;justify-self:center;padding:15px;border:1px solid #d5d9cc;border-radius:16px;background:#f7f8f2}.cafe-report-screen figcaption{font-size:10px;margin-bottom:13px}.cafe-phone-bezel{max-width:210px;margin-inline:auto;padding:6px;border:3px solid #252a24;border-radius:27px;background:#20231f}.cafe-phone-bezel img{display:block;width:100%;height:auto;border-radius:19px}.cafe-platform{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:36px;align-items:center;padding-block:82px}.cafe-platform h2{max-width:620px}.cafe-platform>div>p:last-child{max-width:700px;margin-top:16px}.cafe-platform-list{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:13px;font-weight:700}.cafe-platform-list i{width:4px;height:4px;border-radius:50%;background:#963b18}.cafe-related{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding-block:26px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.cafe-related a{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#85310e;font-size:13px;font-weight:700;text-decoration:none}.cafe-faq{display:grid;grid-template-columns:minmax(230px,.72fr) minmax(0,1.28fr);gap:clamp(36px,7vw,88px);padding-block:82px}.cafe-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:15px}.cafe-faq-list details{border-top:1px solid var(--line)}.cafe-faq-list details:last-child{border-bottom:1px solid var(--line)}.cafe-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:64px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.cafe-faq-list summary::-webkit-details-marker{display:none}.cafe-faq-list summary span{font-size:24px;font-weight:400;color:#963b18;flex:none;transition:transform .18s}.cafe-faq-list details[open] summary span{transform:rotate(45deg)}.cafe-faq-list details>p{padding:0 35px 19px 0;color:#51574e;font-size:13px;line-height:1.8}.cafe-cta{padding-block:62px;background:#f0caa8}.cafe-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.cafe-cta .cafe-kicker{color:#783516}.cafe-cta h2{max-width:700px}.cafe-cta-inner>div>p:last-child{max-width:570px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.cafe-cta .button{flex:none}
@media(max-width:1050px){.cafe-service-grid{grid-template-columns:1fr}.cafe-service-grid li{min-height:0}.cafe-service-grid h3{margin-top:16px}.cafe-setup-grid{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:15px}.cafe-setup-grid li:nth-child(2){border-right:0}.cafe-setup-grid li:nth-child(3){padding-left:0}.cafe-setup-grid li{min-height:0}.cafe-workflow-list{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:25px}.cafe-workflow-list li:nth-child(2){border-right:0}.cafe-workflow-list li:nth-child(3){padding-left:0}.cafe-workflow-list li{min-height:165px}}
@media(max-width:950px){.cafe-hero{grid-template-columns:1fr;padding-block:56px 66px}.cafe-hero-copy{max-width:750px}.cafe-screen{max-width:850px;width:100%;margin-inline:auto}.cafe-overview,.cafe-drinks,.cafe-handoff{grid-template-columns:1fr;gap:30px}.cafe-overview{padding-block:60px}.cafe-drinks,.cafe-handoff{padding-block:65px}.cafe-reports-inner{grid-template-columns:minmax(0,1fr) minmax(220px,.5fr);gap:32px}.cafe-platform{grid-template-columns:1fr;gap:25px}}
@media(max-width:700px){.cafe-breadcrumb{padding-top:14px;font-size:10px;gap:7px}.cafe-hero{padding-block:43px 54px;gap:26px}.cafe-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.cafe-lede{font-size:14px;margin-top:16px}.cafe-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.cafe-actions .button{width:100%;justify-content:space-between}.cafe-screen{padding:13px 11px 12px;border-radius:13px}.cafe-screen figcaption,.cafe-report-screen figcaption{font-size:9px;gap:8px;margin-bottom:11px}.cafe-bezel{max-width:380px;margin-inline:auto;padding:6px;border-width:2px;border-radius:22px}.cafe-bezel img{border-radius:14px}.cafe-stand{display:none}.cafe-screen>p,.cafe-report-screen>p{font-size:12px}.cafe-overview{padding-block:52px 59px;gap:22px}.cafe-overview h2,.cafe-section-head h2,.cafe-drink h2,.cafe-handoff h2,.cafe-reports h2,.cafe-platform h2,.cafe-faq h2,.cafe-cta h2{font-size:clamp(35px,9vw,46px)}.cafe-copy p,.cafe-drink-heading>p:last-child,.cafe-reports-inner>div>p:not(.cafe-kicker),.cafe-platform>div>p:last-child{font-size:14px}.cafe-services,.cafe-workflow{padding-block:59px 64px}.cafe-section-head>p:last-child{font-size:14px}.cafe-service-grid{margin-top:27px}.cafe-service-grid li{padding:18px}.cafe-service-grid h3{font-size:19px;margin-top:13px}.cafe-service-grid p,.cafe-setup-grid p,.cafe-workflow-list p{font-size:13px}.cafe-drinks,.cafe-handoff{padding-block:59px;gap:24px}.cafe-setup-grid{grid-template-columns:1fr;margin-top:0;row-gap:0}.cafe-setup-grid li,.cafe-setup-grid li+li{padding:17px 0;border-right:0;border-bottom:1px solid var(--line)}.cafe-setup-grid li:last-child{border-bottom:0}.cafe-setup-grid h3{font-size:18px;margin-top:10px}.cafe-workflow-list{grid-template-columns:1fr;margin-top:28px;row-gap:0}.cafe-workflow-list li,.cafe-workflow-list li+li{min-height:0;padding:17px 0;border-right:0;border-bottom:1px solid #60665b}.cafe-workflow-list li:last-child{border-bottom:0}.cafe-workflow-list h3{font-size:19px;margin-top:10px}.cafe-reports{padding-block:59px}.cafe-reports-inner{grid-template-columns:1fr;gap:30px}.cafe-report-screen{max-width:310px;width:100%;margin-top:9px}.cafe-platform{padding-block:62px;gap:23px}.cafe-platform-list{gap:8px;font-size:12px}.cafe-related{grid-template-columns:1fr;gap:0;padding-block:10px}.cafe-related a{padding:14px 0;border-bottom:1px solid var(--line)}.cafe-related a:last-child{border-bottom:0}.cafe-faq{grid-template-columns:1fr;gap:21px;padding-block:59px}.cafe-faq-list summary{min-height:61px;font-size:13px}.cafe-faq-list details>p{font-size:12px}.cafe-cta{padding-block:50px}.cafe-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.cafe-cta-inner>div>p:last-child{font-size:13px}.cafe-cta .button{width:100%;justify-content:space-between}}
@media(prefers-reduced-motion:reduce){.cafe-faq-list summary span{transition:none}.cafe-faq-list details[open] summary span{transform:none}}
</style>
