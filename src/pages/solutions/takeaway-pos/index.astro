---
import { getEntry } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const entry = await getEntry('pages', 'takeaway-pos');
if (!entry) throw new Error('CMS content entry "takeaway-pos" is missing.');
const { seo, copy, takeawayLists, imageAlt } = entry.data;
if (!takeawayLists?.serviceTypes.length || !takeawayLists.packagingSetup.length || !takeawayLists.workflowSteps.length || !takeawayLists.faqs.length || !imageAlt?.takeawayPosMenu || !imageAlt?.takeawayPosReports) {
  throw new Error('Takeaway POS page content is incomplete.');
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication', operatingSystem: 'Web' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
      { '@type': 'ListItem', position: 2, name: 'Takeaway POS', item: seo.canonical }
    ]
  }
};
---

<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="takeaway-page">
    <nav class="takeaway-breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">{copy.breadcrumbLabel}</span>
    </nav>

    <section class="takeaway-hero container" aria-labelledby="takeaway-title">
      <div class="takeaway-hero-copy">
        <p class="takeaway-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="takeaway-title">{copy.heroTitle}</h1>
        <p class="takeaway-lede">{copy.heroDescription}</p>
        <div class="takeaway-actions">
          <a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a>
          <a class="text-link" href="#takeaway-workflow">{copy.workflowCta}<Mark name="down" /></a>
        </div>
      </div>
      <figure class="takeaway-screen">
        <figcaption><span>{copy.menuScreenLabel}</span><span>{copy.menuScreenDataLabel}</span></figcaption>
        <div class="takeaway-monitor">
          <div class="takeaway-bezel">
            <picture>
              <source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-with-photos-mobile.webp" width="872" height="1804"/>
              <source media="(max-width: 1100px)" srcset="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656"/>
              <img src="/pos-images/restabee-restaurant-pos-menu-with-photos-desktop.webp" width="1548" height="1016" alt={imageAlt.takeawayPosMenu} fetchpriority="high" decoding="async"/>
            </picture>
          </div>
          <div class="takeaway-stand" aria-hidden="true"></div>
        </div>
        <p>{copy.menuScreenCaption}</p>
      </figure>
    </section>

    <section class="takeaway-overview container" aria-labelledby="takeaway-overview-title">
      <div>
        <p class="takeaway-kicker">{copy.overviewKicker}</p>
        <h2 id="takeaway-overview-title">{copy.overviewTitle}</h2>
      </div>
      <div class="takeaway-copy">
        <p>{copy.overviewParagraphOne}</p>
        <p>{copy.overviewParagraphTwo}</p>
        <p>{copy.overviewParagraphThree}</p>
      </div>
    </section>

    <section class="takeaway-services" aria-labelledby="takeaway-service-title">
      <div class="container">
        <header class="takeaway-section-head">
          <p class="takeaway-kicker">{copy.serviceKicker}</p>
          <h2 id="takeaway-service-title">{copy.serviceTitle}</h2>
          <p>{copy.serviceDescription}</p>
        </header>
        <ul class="takeaway-service-grid" aria-label={copy.serviceListLabel}>
          {takeawayLists.serviceTypes.map((item, index) => (
            <li><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="takeaway-packaging container" aria-labelledby="takeaway-packaging-title">
      <div class="takeaway-packaging-heading">
        <p class="takeaway-kicker">{copy.packagingKicker}</p>
        <h2 id="takeaway-packaging-title">{copy.packagingTitle}</h2>
        <p>{copy.packagingDescription}</p>
      </div>
      <div class="takeaway-packaging-copy">
        <p>{copy.packagingParagraphOne}</p>
        <p>{copy.packagingParagraphTwo}</p>
        <p>{copy.packagingParagraphThree}</p>
      </div>
      <ul class="takeaway-setup-grid" aria-label={copy.packagingListLabel}>
        {takeawayLists.packagingSetup.map((item, index) => (
          <li><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></li>
        ))}
      </ul>
    </section>

    <section class="takeaway-workflow" id="takeaway-workflow" aria-labelledby="takeaway-workflow-title">
      <div class="container">
        <header class="takeaway-section-head">
          <p class="takeaway-kicker">{copy.workflowKicker}</p>
          <h2 id="takeaway-workflow-title">{copy.workflowTitle}</h2>
          <p>{copy.workflowDescription}</p>
        </header>
        <ol class="takeaway-workflow-list" aria-label={copy.workflowListLabel}>
          {takeawayLists.workflowSteps.map(step => (
            <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="takeaway-handoff container" aria-labelledby="takeaway-handoff-title">
      <div class="takeaway-handoff-heading">
        <p class="takeaway-kicker">{copy.handoffKicker}</p>
        <h2 id="takeaway-handoff-title">{copy.handoffTitle}</h2>
      </div>
      <div class="takeaway-copy">
        <p>{copy.handoffParagraphOne}</p>
        <p>{copy.handoffParagraphTwo}</p>
        <p>{copy.handoffParagraphThree}</p>
        <a class="text-link" href="/features/kitchen-display-system/">{copy.kdsLinkLabel}<Mark /></a>
        <a class="text-link" href="/features/restaurant-menu-management/">{copy.menuLinkLabel}<Mark /></a>
        <a class="text-link" href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a>
      </div>
    </section>

    <section class="takeaway-reports">
      <div class="container takeaway-reports-inner">
        <div>
          <p class="takeaway-kicker">{copy.reportKicker}</p>
          <h2>{copy.reportTitle}</h2>
          <p>{copy.reportDescription}</p>
          <a class="text-link" href="/features/restaurant-sales-reports/">{copy.reportLinkLabel}<Mark /></a>
        </div>
        <figure class="takeaway-report-screen">
          <figcaption><span>{copy.reportScreenLabel}</span><span>{copy.reportScreenDataLabel}</span></figcaption>
          <div class="takeaway-phone-bezel">
            <img src="/pos-images/restabee-pos-reports-mobile.webp" width="800" height="1656" alt={imageAlt.takeawayPosReports} loading="lazy" decoding="async"/>
          </div>
          <p>{copy.reportScreenCaption}</p>
        </figure>
      </div>
    </section>

    <section class="takeaway-platform container" aria-labelledby="takeaway-platform-title">
      <div>
        <p class="takeaway-kicker">{copy.platformKicker}</p>
        <h2 id="takeaway-platform-title">{copy.platformTitle}</h2>
        <p>{copy.platformDescription}</p>
      </div>
      <div class="takeaway-platform-list" aria-label="Supported platforms">
        <span>Desktop</span><i></i><span>Tablet</span><i></i><span>Phone</span>
      </div>
    </section>

    <section class="takeaway-related container" aria-label="Related restaurant POS features">
      <a href="/features/restaurant-order-management/">{copy.orderLinkLabel}<Mark /></a>
      <a href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a>
      <a href="/features/kot-management/">Kitchen order tickets<Mark /></a>
    </section>

    <section class="takeaway-faq container" aria-labelledby="takeaway-faq-title">
      <div class="takeaway-faq-intro">
        <p class="takeaway-kicker">{copy.faqKicker}</p>
        <h2 id="takeaway-faq-title">{copy.faqTitle}</h2>
        <p>{copy.faqDescription}</p>
      </div>
      <div class="takeaway-faq-list">
        {takeawayLists.faqs.map(({ question, answer }) => (
          <details>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="takeaway-cta">
      <div class="container takeaway-cta-inner">
        <div>
          <p class="takeaway-kicker">{copy.ctaKicker}</p>
          <h2>{copy.ctaTitle}</h2>
          <p>{copy.ctaDescription}</p>
        </div>
        <a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
.takeaway-page{overflow:hidden}.takeaway-breadcrumb{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.takeaway-breadcrumb a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.takeaway-breadcrumb [aria-current=page]{color:var(--ink)}.takeaway-kicker{display:flex;align-items:center;gap:10px;color:#963b18;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.takeaway-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}
.takeaway-hero{display:grid;grid-template-columns:minmax(300px,.78fr) minmax(0,1.22fr);gap:clamp(38px,6vw,82px);align-items:center;padding-block:66px 78px}.takeaway-hero h1{max-width:620px;font-size:clamp(49px,5.3vw,72px);line-height:1.04;letter-spacing:-.045em;margin-top:20px}.takeaway-lede{max-width:570px;margin-top:20px;color:#51574e;font-size:16px;line-height:1.8}.takeaway-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:27px}.takeaway-actions .button{gap:20px}.takeaway-screen{min-width:0;padding:17px 18px 14px;border:1px solid #dedacd;border-radius:16px;background:#f1eee5;box-shadow:0 22px 46px -36px #252a2480}.takeaway-screen figcaption,.takeaway-report-screen figcaption{display:flex;justify-content:space-between;gap:14px;margin:0 0 16px;color:#4f554c;font-size:11px}.takeaway-screen figcaption span:first-child,.takeaway-report-screen figcaption span:first-child{font-weight:700;color:var(--ink)}.takeaway-bezel{overflow:hidden;border:8px solid #252a24;border-radius:14px;background:#20231f;box-shadow:0 14px 26px -20px #252a2480}.takeaway-bezel picture,.takeaway-bezel img{display:block;width:100%;height:auto}.takeaway-bezel img{border-radius:4px}.takeaway-stand{width:28%;height:24px;margin:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}.takeaway-screen>p,.takeaway-report-screen>p{padding-top:12px;color:#62665d;font-size:13px}
.takeaway-overview{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);gap:clamp(40px,7vw,96px);padding-block:74px 86px;border-top:1px solid var(--line)}.takeaway-overview h2,.takeaway-section-head h2,.takeaway-packaging h2,.takeaway-handoff h2,.takeaway-reports h2,.takeaway-platform h2,.takeaway-faq h2,.takeaway-cta h2{font-size:clamp(38px,4.7vw,60px);line-height:1.07;letter-spacing:-.04em;margin-top:17px}.takeaway-copy p,.takeaway-reports-inner>div>p:not(.takeaway-kicker),.takeaway-platform>div>p:last-child{color:#51574e;font-size:15px;line-height:1.8}.takeaway-copy p+p{margin-top:13px}.takeaway-services,.takeaway-workflow{padding-block:82px 88px;background:#252b24;color:#f6f5ef}.takeaway-section-head{max-width:760px}.takeaway-services .takeaway-kicker,.takeaway-workflow .takeaway-kicker{color:#ffb17d}.takeaway-section-head>p:last-child{max-width:700px;color:#d0d4ca;font-size:15px;line-height:1.8;margin-top:15px}.takeaway-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;margin-top:38px;border-top:1px solid #60665b;border-left:1px solid #60665b}.takeaway-service-grid li{min-height:210px;padding:23px;border-right:1px solid #60665b;border-bottom:1px solid #60665b}.takeaway-service-grid li>span,.takeaway-setup-grid li>span,.takeaway-workflow-list li>span{color:#ffb17d;font-size:11px;font-weight:700;letter-spacing:.08em}.takeaway-service-grid h3{font-size:22px;margin-top:28px}.takeaway-service-grid p,.takeaway-setup-grid p,.takeaway-workflow-list p{max-width:350px;color:#d0d4ca;font-size:13px;line-height:1.75;margin-top:10px}.takeaway-packaging{display:grid;grid-template-columns:minmax(0,.83fr) minmax(0,1.17fr);gap:clamp(38px,7vw,92px);padding-block:86px}.takeaway-packaging-heading>p:last-child{color:#51574e;font-size:15px;line-height:1.8;margin-top:17px}.takeaway-setup-grid{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:4px;border-top:1px solid var(--line)}.takeaway-setup-grid li{min-height:185px;padding:20px 20px 18px 0;border-right:1px solid var(--line)}.takeaway-setup-grid li+li{padding-left:20px}.takeaway-setup-grid li:last-child{border-right:0}.takeaway-setup-grid li>span{color:#963b18}.takeaway-setup-grid h3{font-size:19px;line-height:1.3;margin-top:18px}.takeaway-setup-grid p{color:#51574e;font-size:13px;margin-top:9px}.takeaway-workflow-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin-top:39px;border-top:1px solid #60665b}.takeaway-workflow-list li{min-height:195px;padding:21px 20px 0 0;border-right:1px solid #60665b}.takeaway-workflow-list li+li{padding-left:21px}.takeaway-workflow-list li:last-child{border-right:0}.takeaway-workflow-list h3{font-size:20px;line-height:1.25;margin-top:25px}.takeaway-handoff{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(40px,7vw,95px);padding-block:86px}.takeaway-handoff h2{max-width:600px}.takeaway-handoff .takeaway-copy .text-link{display:flex;width:max-content;margin-top:17px}.takeaway-reports{padding-block:72px;background:#e8ecdf}.takeaway-reports-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.48fr);gap:clamp(38px,7vw,90px);align-items:center}.takeaway-reports h2{max-width:620px}.takeaway-reports-inner>div>p:not(.takeaway-kicker){max-width:720px;margin-top:18px;color:#42493f}.takeaway-reports-inner .text-link{display:inline-flex;margin-top:20px;color:#783516;font-weight:700}.takeaway-report-screen{max-width:330px;justify-self:center;padding:15px;border:1px solid #d5d9cc;border-radius:16px;background:#f7f8f2}.takeaway-report-screen figcaption{font-size:10px;margin-bottom:13px}.takeaway-phone-bezel{max-width:210px;margin-inline:auto;padding:6px;border:3px solid #252a24;border-radius:27px;background:#20231f}.takeaway-phone-bezel img{display:block;width:100%;height:auto;border-radius:19px}.takeaway-platform{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:36px;align-items:center;padding-block:82px}.takeaway-platform h2{max-width:620px}.takeaway-platform>div>p:last-child{max-width:700px;margin-top:16px}.takeaway-platform-list{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:13px;font-weight:700}.takeaway-platform-list i{width:4px;height:4px;border-radius:50%;background:#963b18}.takeaway-related{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding-block:26px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.takeaway-related a{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#85310e;font-size:13px;font-weight:700;text-decoration:none}.takeaway-faq{display:grid;grid-template-columns:minmax(230px,.72fr) minmax(0,1.28fr);gap:clamp(36px,7vw,88px);padding-block:82px}.takeaway-faq-intro>p:last-child{color:#51574e;font-size:14px;line-height:1.75;margin-top:15px}.takeaway-faq-list details{border-top:1px solid var(--line)}.takeaway-faq-list details:last-child{border-bottom:1px solid var(--line)}.takeaway-faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:64px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.takeaway-faq-list summary::-webkit-details-marker{display:none}.takeaway-faq-list summary span{font-size:24px;font-weight:400;color:#963b18;flex:none;transition:transform .18s}.takeaway-faq-list details[open] summary span{transform:rotate(45deg)}.takeaway-faq-list details>p{padding:0 35px 19px 0;color:#51574e;font-size:13px;line-height:1.8}.takeaway-cta{padding-block:62px;background:#f0caa8}.takeaway-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.takeaway-cta .takeaway-kicker{color:#783516}.takeaway-cta h2{max-width:700px}.takeaway-cta-inner>div>p:last-child{max-width:570px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.takeaway-cta .button{flex:none}
@media(max-width:1050px){.takeaway-service-grid{grid-template-columns:1fr}.takeaway-service-grid li{min-height:0}.takeaway-service-grid h3{margin-top:16px}.takeaway-setup-grid{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:15px}.takeaway-setup-grid li:nth-child(2){border-right:0}.takeaway-setup-grid li:nth-child(3){padding-left:0}.takeaway-setup-grid li{min-height:0}.takeaway-workflow-list{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:25px}.takeaway-workflow-list li:nth-child(2){border-right:0}.takeaway-workflow-list li:nth-child(3){padding-left:0}.takeaway-workflow-list li{min-height:165px}}
@media(max-width:950px){.takeaway-hero{grid-template-columns:1fr;padding-block:56px 66px}.takeaway-hero-copy{max-width:750px}.takeaway-screen{max-width:850px;width:100%;margin-inline:auto}.takeaway-overview,.takeaway-packaging,.takeaway-handoff{grid-template-columns:1fr;gap:30px}.takeaway-overview{padding-block:60px}.takeaway-packaging,.takeaway-handoff{padding-block:65px}.takeaway-reports-inner{grid-template-columns:minmax(0,1fr) minmax(220px,.5fr);gap:32px}.takeaway-platform{grid-template-columns:1fr;gap:25px}}
@media(max-width:700px){.takeaway-breadcrumb{padding-top:14px;font-size:10px;gap:7px}.takeaway-hero{padding-block:43px 54px;gap:26px}.takeaway-hero h1{font-size:clamp(42px,11vw,58px);margin-top:17px}.takeaway-lede{font-size:14px;margin-top:16px}.takeaway-actions{display:grid;grid-template-columns:1fr;gap:13px;margin-top:22px}.takeaway-actions .button{width:100%;justify-content:space-between}.takeaway-screen{padding:13px 11px 12px;border-radius:13px}.takeaway-screen figcaption,.takeaway-report-screen figcaption{font-size:9px;gap:8px;margin-bottom:11px}.takeaway-bezel{max-width:380px;margin-inline:auto;padding:6px;border-width:2px;border-radius:22px}.takeaway-bezel img{border-radius:14px}.takeaway-stand{display:none}.takeaway-screen>p,.takeaway-report-screen>p{font-size:12px}.takeaway-overview{padding-block:52px 59px;gap:22px}.takeaway-overview h2,.takeaway-section-head h2,.takeaway-packaging h2,.takeaway-handoff h2,.takeaway-reports h2,.takeaway-platform h2,.takeaway-faq h2,.takeaway-cta h2{font-size:clamp(35px,9vw,46px)}.takeaway-copy p,.takeaway-packaging-heading>p:last-child,.takeaway-reports-inner>div>p:not(.takeaway-kicker),.takeaway-platform>div>p:last-child{font-size:14px}.takeaway-services,.takeaway-workflow{padding-block:59px 64px}.takeaway-section-head>p:last-child{font-size:14px}.takeaway-service-grid{margin-top:27px}.takeaway-service-grid li{padding:18px}.takeaway-service-grid h3{font-size:19px;margin-top:13px}.takeaway-service-grid p,.takeaway-setup-grid p,.takeaway-workflow-list p{font-size:13px}.takeaway-packaging,.takeaway-handoff{padding-block:59px;gap:24px}.takeaway-setup-grid{grid-template-columns:1fr;margin-top:0;row-gap:0}.takeaway-setup-grid li,.takeaway-setup-grid li+li{padding:17px 0;border-right:0;border-bottom:1px solid var(--line)}.takeaway-setup-grid li:last-child{border-bottom:0}.takeaway-setup-grid h3{font-size:18px;margin-top:10px}.takeaway-workflow-list{grid-template-columns:1fr;margin-top:28px;row-gap:0}.takeaway-workflow-list li,.takeaway-workflow-list li+li{min-height:0;padding:17px 0;border-right:0;border-bottom:1px solid #60665b}.takeaway-workflow-list li:last-child{border-bottom:0}.takeaway-workflow-list h3{font-size:19px;margin-top:10px}.takeaway-reports{padding-block:59px}.takeaway-reports-inner{grid-template-columns:1fr;gap:30px}.takeaway-report-screen{max-width:310px;width:100%;margin-top:9px}.takeaway-platform{padding-block:62px;gap:23px}.takeaway-platform-list{gap:8px;font-size:12px}.takeaway-related{grid-template-columns:1fr;gap:0;padding-block:10px}.takeaway-related a{padding:14px 0;border-bottom:1px solid var(--line)}.takeaway-related a:last-child{border-bottom:0}.takeaway-faq{grid-template-columns:1fr;gap:21px;padding-block:59px}.takeaway-faq-list summary{min-height:61px;font-size:13px}.takeaway-faq-list details>p{font-size:12px}.takeaway-cta{padding-block:50px}.takeaway-cta-inner{display:grid;grid-template-columns:1fr;gap:22px}.takeaway-cta-inner>div>p:last-child{font-size:13px}.takeaway-cta .button{width:100%;justify-content:space-between}}
@media(prefers-reduced-motion:reduce){.takeaway-faq-list summary span{transition:none}.takeaway-faq-list details[open] summary span{transform:none}}
</style>
