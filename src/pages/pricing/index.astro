---
import { getEntry } from 'astro:content';
import Mark from '../../components/Mark.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const pageEntry = await getEntry('pages', 'pricing');
if (!pageEntry) throw new Error('CMS content entry "pricing" is missing.');
const { seo, copy, plans, pricing, pricingLists, faqs, imageAlt } = pageEntry.data;
if (!pricing || !pricingLists || !plans?.length) throw new Error('Pricing content is incomplete.');
const formatInr = (value: number) => new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(value);
const annualPlan = plans.find((plan) => plan.months === 12);
if (!annualPlan) throw new Error('Pricing content needs a 12-month single-outlet term.');
const outletTotals = pricing.exampleOutlets.map((outlets) => ({ outlets, total: formatInr(outlets * Number(pricing.multiOutletAnnualPerOutlet.replaceAll(',', ''))) }));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  url: seo.canonical,
  description: seo.description,
  isPartOf: { '@type': 'WebSite', name: 'RestaBee', url: 'https://restabee.com/' },
  about: { '@type': 'SoftwareApplication', name: 'RestaBee', applicationCategory: 'BusinessApplication' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Restaurant POS', item: 'https://restabee.com/' },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: seo.canonical },
  ] },
};
---
<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} schema={schema}>
  <SiteHeader />
  <main id="main" class="pricing-page">
    <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href="/">Restaurant POS</a><span aria-hidden="true">/</span><span aria-current="page">Pricing</span></nav>

    <section class="price-hero container" aria-labelledby="pricing-title">
      <div class="price-hero-copy">
        <p class="price-kicker"><span aria-hidden="true"></span>{copy.heroKicker}</p>
        <h1 id="pricing-title">{copy.heroTitle}</h1>
        <p class="price-lede">{copy.heroDescription}</p>
        <div class="price-hero-actions"><a class="button button-orange" href="/#demo">{copy.heroCta}<Mark /></a><a class="text-link" href="#plans">{copy.heroCompareCta}<Mark name="down" /></a></div>
      </div>
      <aside class="price-overview" aria-label={copy.overviewAriaLabel}>
        <p class="price-overview-label">{copy.overviewTitle}</p>
        <div class="price-overview-row"><span>{copy.singleOutletLabel}</span><strong>{copy.singleOutletTerms}</strong></div>
        <div class="price-overview-row"><span>{copy.multipleOutletsLabel}</span><strong>{copy.multipleOutletsTerms}</strong></div>
        <p>{copy.releasedFeaturesNote}</p>
      </aside>
    </section>

    <section class="plans-section" id="plans" aria-labelledby="plans-title">
      <div class="container">
        <header class="pricing-section-heading">
          <p class="price-kicker">Restaurant POS subscription</p>
          <h2 id="plans-title">{copy.pricingTitle}</h2>
          <p>{copy.pricingDescription}</p>
        </header>
        <div class="plan-grid">
          <article class="plan-card single-plan" aria-labelledby="single-plan-title">
            <div class="plan-card-head"><div><p class="plan-eyebrow">{copy.singleOutletEyebrow}</p><h3 id="single-plan-title">{copy.singleOutletTitle}</h3><p>{copy.singleOutletSubtitle}</p></div><span class="plan-mark" aria-hidden="true">01</span></div>
            <div class="annual-anchor"><span>{copy.annualTermLabel}</span><strong>₹{annualPlan.price}</strong><small>{copy.singleOutletTotalLabel}</small></div>
            <h4 class="term-heading">{copy.pricingTermsTitle}</h4>
            <div class="term-list" role="list" aria-label={copy.singleOutletTerms}>
              {plans.map((plan) => <div class="term-row" role="listitem"><div><strong>{plan.months} {copy.monthsUnit}</strong>{plan.months === 12 && <span class="value-label">{copy.bestValueLabel}</span>}</div><div class="term-price"><strong>₹{plan.price}</strong><span>₹{formatInr(Math.round(Number(plan.price.replaceAll(',', '')) / plan.months))} {copy.perMonthUnit}</span></div></div>)}
            </div>
            <a class="button button-dark plan-cta" href="/#demo">{copy.singleOutletCta}<Mark /></a>
          </article>

          <article class="plan-card multi-plan" aria-labelledby="multi-plan-title">
            <div class="plan-card-head"><div><p class="plan-eyebrow">{copy.multiOutletEyebrow}</p><h3 id="multi-plan-title">{copy.multiOutletTitle}</h3><p>{copy.multiOutletSubtitle}</p></div><span class="plan-mark" aria-hidden="true">02</span></div>
            <div class="multi-price"><strong>₹{pricing.multiOutletAnnualPerOutlet}</strong><span>{copy.perOutletYearUnit}</span></div>
            <p class="multi-plan-copy">{copy.multiOutletDescription}</p>
            <p class="outlet-minimum">{copy.minimumOutletsTemplate.replace('{count}', String(pricing.minimumOutlets))}</p>
            <h4 class="term-heading">{copy.outletExamplesTitle}</h4>
            <div class="outlet-totals" role="list" aria-label={copy.annualTotalsAriaLabel}>
              {outletTotals.map(({ outlets, total }) => <div class="outlet-total" role="listitem"><span>{outlets} {copy.outletsUnit}</span><strong>₹{total}<small> {copy.perYearUnit}</small></strong></div>)}
            </div>
            <a class="button button-dark plan-cta" href="/#demo">{copy.multiOutletCta}<Mark /></a>
          </article>
        </div>
        <p class="pricing-note">{copy.pricingNote}</p>
      </div>
    </section>

    <section class="included-section container" aria-labelledby="included-title">
      <header class="pricing-section-heading included-heading">
        <p class="price-kicker">{copy.includedFeaturesKicker}</p>
        <h2 id="included-title">{copy.includedFeaturesTitle}</h2>
        <p>{copy.includedFeaturesDescription}</p>
      </header>
      <ul class="included-grid">
        {pricingLists.includedFeatures.map((feature) => <li><span class="included-check" aria-hidden="true"><Mark name="check" /></span><span>{feature}</span></li>)}
      </ul>
      <p class="included-link"><a class="text-link" href="/features/restaurant-billing-software/">{copy.billingLinkLabel}<Mark /></a></p>
    </section>

    <section class="pricing-workspace" aria-labelledby="pricing-workspace-title">
      <div class="container pricing-workspace-layout">
        <div class="pricing-workspace-copy"><p class="price-kicker">{copy.screenshotKicker}</p><h2 id="pricing-workspace-title">{copy.screenshotTitle}</h2><p>{copy.screenshotDescription}</p></div>
        <figure class="pricing-device">
          <figcaption><span>{copy.screenshotLabel}</span><span>{copy.screenshotCaption}</span></figcaption>
          <div class="pricing-device-shell">
            <div class="pricing-device-bezel"><picture><source media="(max-width: 700px)" srcset="/pos-images/restabee-restaurant-pos-menu-mobile.webp" width="800" height="1656"/><source media="(max-width: 1100px)" srcset="/pos-images/restabee-restaurant-pos-menu-tablet.webp" width="2522" height="1656"/><img src="/pos-images/restabee-restaurant-pos-menu-desktop.webp" width="2910" height="1656" alt={imageAlt?.posMenu ?? 'Restaurant POS menu with item categories and order panel; sample restaurant data.'} loading="lazy" decoding="async"/></picture></div>
            <div class="pricing-device-stand" aria-hidden="true"><span></span></div>
          </div>
        </figure>
      </div>
    </section>

    <section class="price-details" aria-labelledby="price-details-title">
      <div class="container price-details-grid">
        <div>
          <p class="price-kicker">{copy.priceDetailsKicker}</p>
          <h2 id="price-details-title">{copy.priceDetailsTitle}</h2>
          <p class="price-details-lede">{copy.priceDetailsDescription}</p>
        </div>
        <div class="price-boundaries">
          {pricingLists.boundaries?.map((item) => <div class="boundary-card"><span class="boundary-number">{item.number}</span><div><h3>{item.title}</h3>{item.kind === 'list' ? <ul>{pricingLists.separatelyQuoted.map((quoted) => <li>{quoted}</li>)}</ul> : <p>{item.description.replace('{count}', String(pricing.minimumOutlets))}</p>}</div></div>)}
        </div>
      </div>
    </section>

    <section class="pricing-faq container" aria-labelledby="pricing-faq-title">
      <div class="faq-intro"><p class="price-kicker">{copy.faqKicker}</p><h2 id="pricing-faq-title">{copy.faqTitle}</h2><p>{copy.faqDescription}</p></div>
      <div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="pricing-cta" aria-labelledby="pricing-cta-title">
      <div class="container pricing-cta-inner">
        <div><p class="price-kicker">{copy.ctaKicker}</p><h2 id="pricing-cta-title">{copy.ctaTitle}</h2><p>{copy.ctaDescription}</p><div class="pricing-content-links"><a class="text-link" href="/features/restaurant-billing-software/">{copy.ctaBillingLinkLabel}<Mark /></a><a class="text-link" href="/blog/restaurant-pos-buying-checklist/">{copy.ctaBuyingGuideLinkLabel}<Mark /></a><a class="text-link" href="/blog/restaurant-pos-cost-india/">{copy.ctaPosCostGuideLinkLabel}<Mark /></a></div></div>
        <a class="button button-orange" href="/#demo">{copy.demoCta}<Mark /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
<style>
  .pricing-page{overflow:hidden}.breadcrumbs{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:12px;color:var(--muted)}.breadcrumbs a{text-decoration:underline;text-decoration-color:#afb3a8;text-underline-offset:3px}.breadcrumbs [aria-current="page"]{color:var(--ink)}
  .price-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:clamp(42px,8vw,118px);align-items:center;padding-block:76px 88px}.price-kicker{display:flex;align-items:center;gap:10px;color:var(--orange-ink);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.price-kicker>span{width:8px;height:8px;border-radius:50%;background:var(--orange)}.price-hero h1{max-width:760px;font-size:clamp(52px,6.2vw,82px);margin-top:24px}.price-lede{max-width:680px;margin-top:23px;color:#4e544b;font-size:17px;line-height:1.75}.price-hero-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin-top:30px}.price-hero-actions .button{gap:22px}.price-overview{padding:27px 29px;background:#e8ebdf;border:1px solid #d8ddce;border-radius:14px}.price-overview-label{font-size:11px;color:#50594b;text-transform:uppercase;letter-spacing:.09em;font-weight:700}.price-overview-row{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;padding:17px 0;border-bottom:1px solid #c4cbbb;font-size:13px}.price-overview-row strong{text-align:right;font-size:13px;max-width:180px}.price-overview>p:last-child{font-size:13px;line-height:1.65;color:#465044;margin-top:17px}
  .plans-section{background:#efeee7;padding-block:78px 71px}.plans-section .price-kicker{color:#b54114}.pricing-section-heading{max-width:720px;margin:0 auto 38px;text-align:center}.pricing-section-heading h2{font-size:clamp(38px,4.5vw,58px);margin-top:16px}.pricing-section-heading>p:last-child{max-width:630px;margin:16px auto 0;color:#4f554c;font-size:15px;line-height:1.75}.plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:1120px;margin-inline:auto;align-items:stretch}.plan-card{padding:30px 32px;border:1px solid #d9d9cf;border-radius:15px;background:#fffefa;box-shadow:0 16px 30px -30px #242820}.multi-plan{background:#e2e7da;border-color:#d2d9c8}.plan-card-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.plan-eyebrow{font-size:11px;color:#555d50;letter-spacing:.06em;text-transform:uppercase}.plan-card h3{font-size:29px;margin-top:5px}.plan-card-head>div>p:last-child{font-size:13px;color:#555d50;margin-top:7px}.plan-mark{font:600 13px/1 var(--display);color:#a43e15;background:#ffebda;padding:9px 10px;border-radius:7px}.annual-anchor{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-top:26px;padding:19px 0 22px;border-bottom:1px solid #dedfd5}.annual-anchor>span{width:100%;font-size:11px;color:#555d50}.annual-anchor>strong,.multi-price>strong{font:600 50px/1 var(--display);letter-spacing:-.045em;font-variant-numeric:tabular-nums}.annual-anchor>small{font-size:12px;color:#555d50}.term-heading{font:650 14px/1.4 var(--body);letter-spacing:0;margin-top:20px}.term-list{margin-top:10px}.term-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 0;border-top:1px solid #e2e2da;font-size:13px}.term-row>div:first-child{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.term-row>div:first-child>strong{font-size:13px}.value-label{background:#fbe8d6;color:#713414;padding:4px 7px;border-radius:4px;font-size:10px;font-weight:650}.term-price{text-align:right;display:grid;gap:3px}.term-price>strong{font-size:15px;font-variant-numeric:tabular-nums}.term-price>span{color:#555d50;font-size:11px}.plan-cta{display:flex;justify-content:space-between;width:100%;margin-top:25px}.multi-price{display:flex;align-items:baseline;gap:12px;margin-top:34px}.multi-price>span{font-size:13px;color:#4e584a}.multi-plan-copy{max-width:420px;font-size:14px;line-height:1.7;color:#465044;margin-top:12px}.outlet-minimum{font-size:12px;font-weight:650;color:#3f4c3c;margin-top:17px}.multi-plan .term-heading{margin-top:24px}.outlet-totals{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:13px}.outlet-total{display:flex;align-items:center;justify-content:space-between;gap:9px;background:#f7f8f3;border:1px solid #d8ddce;border-radius:8px;padding:12px 13px;font-size:12px}.outlet-total strong{font-size:13px;white-space:nowrap;font-variant-numeric:tabular-nums}.outlet-total small{font-size:10px;font-weight:500;color:#586151}
  .pricing-note{max-width:960px;margin:22px auto 0;text-align:center;color:#4f554c;font-size:12px;line-height:1.75}.included-section{padding-block:94px 88px}.included-heading{margin-bottom:37px}.included-grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.included-grid li{display:flex;align-items:flex-start;gap:12px;min-height:92px;padding:20px 18px;background:#fff;border:1px solid var(--line);border-radius:10px;font-size:14px;line-height:1.5;color:#343a32}.included-check{width:22px;height:22px;display:grid;place-items:center;flex:none;background:#e3ecdf;color:#285b34;border-radius:50%}.included-check .icon{width:14px;height:14px}.included-link{display:flex;justify-content:center;margin-top:22px}
  .pricing-workspace{background:#f0efe8;padding-block:81px}.pricing-workspace .price-kicker{color:#b54114}.pricing-workspace-layout{display:grid;grid-template-columns:minmax(250px,.65fr) minmax(0,1.35fr);gap:clamp(34px,6vw,82px);align-items:center}.pricing-workspace-copy h2{font-size:clamp(38px,4.4vw,58px);margin-top:18px}.pricing-workspace-copy>p:last-child{max-width:400px;color:#4f554c;font-size:15px;line-height:1.8;margin-top:17px}.pricing-device{min-width:0;background:#fffefa;border:1px solid #dedfd5;border-radius:14px;padding:17px 17px 14px;box-shadow:0 18px 36px -30px #242820}.pricing-device figcaption{display:flex;justify-content:space-between;gap:16px;margin:0 0 12px;font-size:11px;color:#4f554c}.pricing-device figcaption span:first-child{font-weight:700;color:var(--ink)}.pricing-device-bezel{overflow:hidden;padding:8px;border:1px solid #777c70;border-radius:13px;background:#20231f;box-shadow:0 12px 22px -16px #24282080}.pricing-device-bezel picture,.pricing-device-bezel img{display:block;width:100%;height:auto}.pricing-device-bezel img{border-radius:4px}.pricing-device-stand{height:23px;width:30%;margin-inline:auto;background:linear-gradient(#c7c8c0,#8a8d84);clip-path:polygon(35% 0,65% 0,76% 82%,100% 82%,100% 100%,0 100%,0 82%,24% 82%)}.pricing-device-stand span{display:block;width:170%;height:5px;margin:18px 0 0 -35%;background:#7c8076;border-radius:5px}
  .price-details{background:#252b24;color:#f6f5ef;padding-block:83px 91px}.price-details-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(40px,8vw,110px);align-items:start}.price-details .price-kicker{color:#ffb17d}.pricing-cta .price-kicker{color:#783516}.price-details h2{font-size:clamp(39px,4.7vw,61px);margin-top:17px}.price-details-lede{max-width:460px;margin-top:19px;color:#d0d4ca;font-size:15px;line-height:1.8}.price-boundaries{border-top:1px solid #62675d}.boundary-card{display:grid;grid-template-columns:37px 1fr;gap:18px;padding:23px 0;border-bottom:1px solid #62675d}.boundary-number{font-size:11px;color:#ffb17d;font-weight:700}.boundary-card h3{font-size:20px}.boundary-card p,.boundary-card li{font-size:13px;line-height:1.75;color:#d0d4ca}.boundary-card p{margin-top:8px}.boundary-card ul{padding-left:18px;margin:8px 0 0;display:flex;flex-wrap:wrap;gap:2px 24px}
  .pricing-faq{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:clamp(36px,7vw,90px);padding-block:91px}.faq-intro h2{font-size:clamp(39px,4.5vw,58px);margin-top:18px}.faq-intro>p:last-child{font-size:14px;line-height:1.7;color:#51574e;margin-top:16px}.faq-list details{border-top:1px solid var(--line)}.faq-list details:last-child{border-bottom:1px solid var(--line)}.faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:67px;cursor:pointer;list-style:none;font-size:14px;line-height:1.5;font-weight:650}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary span{font-size:24px;font-weight:400;color:var(--orange-ink);flex:none}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list details>p{padding:0 36px 20px 0;color:#51574e;font-size:13px;line-height:1.8}
  .pricing-cta{background:#f0caa8;padding-block:62px}.pricing-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.pricing-cta h2{max-width:650px;font-size:clamp(39px,4.7vw,59px);margin-top:16px}.pricing-cta-inner>div>p:not(.price-kicker){max-width:520px;color:#493e35;font-size:14px;line-height:1.75;margin-top:14px}.pricing-content-links{display:flex;flex-wrap:wrap;gap:4px 20px;margin-top:12px}.pricing-content-links .text-link{margin-top:0}.pricing-cta .button{flex:none}
  @media(prefers-reduced-motion:reduce){.faq-list summary span{transition:none}.faq-list details[open] summary span{transform:none}}
  @media(max-width:1100px){.pricing-device-stand{display:none}.pricing-workspace-layout{grid-template-columns:minmax(230px,.7fr) minmax(0,1.3fr)}}
  @media(max-width:950px){.price-hero{grid-template-columns:minmax(0,1fr) minmax(250px,.8fr);gap:35px;padding-block:62px 70px}.plan-card{padding:27px 25px}.included-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pricing-faq{gap:40px}}
  @media(max-width:700px){.breadcrumbs{padding-top:15px;font-size:11px}.price-hero{grid-template-columns:1fr;gap:29px;padding-block:48px 59px}.price-hero h1{font-size:clamp(45px,11.8vw,65px);margin-top:19px}.price-lede{font-size:15px;margin-top:18px}.price-hero-actions{gap:14px;margin-top:23px}.price-hero-actions .button{width:100%;justify-content:space-between}.price-overview{padding:21px 20px}.price-overview-row{font-size:12px}.price-overview-row strong{font-size:12px}.plans-section{padding-block:59px 52px}.pricing-section-heading{text-align:left;margin-bottom:25px}.pricing-section-heading h2{font-size:clamp(35px,8.8vw,46px)}.pricing-section-heading>p:last-child{font-size:14px;margin:12px 0 0}.plan-grid{grid-template-columns:1fr;gap:13px}.plan-card{padding:23px 20px;border-radius:12px}.plan-card h3{font-size:26px}.annual-anchor{margin-top:21px}.annual-anchor>strong,.multi-price>strong{font-size:46px}.term-row{font-size:12px}.outlet-totals{gap:8px}.outlet-total{display:grid;gap:4px;padding:11px}.outlet-total strong{font-size:12px}.pricing-note{text-align:left;font-size:11px;margin-top:18px}.included-section{padding-block:63px 59px}.included-heading{margin-bottom:24px}.included-grid{grid-template-columns:1fr;gap:9px}.included-grid li{min-height:0;padding:16px;font-size:13px}.included-link{justify-content:flex-start;margin-top:15px}.pricing-workspace{padding-block:60px}.pricing-workspace-layout{grid-template-columns:1fr;gap:25px}.pricing-workspace-copy h2{font-size:clamp(37px,9vw,48px)}.pricing-device{padding:15px 13px 12px}.pricing-device figcaption{font-size:9px;gap:8px}.pricing-device-bezel{max-width:290px;margin-inline:auto;padding:7px;border-radius:25px;border-width:2px}.pricing-device-bezel img{border-radius:18px}.price-details{padding-block:60px}.price-details-grid{grid-template-columns:1fr;gap:29px}.price-details h2{font-size:clamp(37px,9vw,48px)}.price-details-lede{font-size:14px;margin-top:15px}.boundary-card{padding:18px 0;grid-template-columns:30px 1fr;gap:12px}.boundary-card h3{font-size:18px}.pricing-faq{grid-template-columns:1fr;gap:22px;padding-block:61px}.faq-intro h2{font-size:clamp(37px,9vw,48px);margin-top:15px}.faq-list summary{min-height:62px;font-size:13px}.faq-list details>p{font-size:12px}.pricing-cta{padding-block:51px}.pricing-cta-inner{display:grid;grid-template-columns:1fr;gap:23px}.pricing-cta h2{font-size:clamp(38px,9vw,49px)}.pricing-cta .button{width:100%;justify-content:space-between}}
</style>
