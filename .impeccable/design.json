  "narrative": {
    "northStar": "The Open Kitchen",
    "overview": "An open-kitchen editorial identity places restaurant work beside clear, expressive typography. Warm paper, green-tinted ink and orange connect hospitality imagery with practical order details. The supplied logo anchors the identity; generated restaurant scenes remain explicitly illustrative.\n\nThe system changes density with the material: generous space for the narrative, compact rows for an order or collection example. Dark operational passages belong to the brand palette; they do not define a separate dark-mode theme.",
    "keyCharacteristics": [
      "Locally hosted expressive display type and quiet body type.",
      "Warm hospitality imagery beside labelled operational examples.",
      "Tonal surfaces, restrained paper shadows and clear interactive selection."
    ],
    "rules": [
      {
        "name": "The Material Contrast Rule",
        "body": "Keep each operational example's text, surface and divider colors together; reversing only its background breaks its material hierarchy.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use display type for hierarchy and body type for instructions, labels and controls. Do not introduce a third display face.",
        "section": "typography"
      },
      {
        "name": "The Paper Depth Rule",
        "body": "Reserve illustrative paper shadows for paper objects and the navigation shadow for its overlay; do not apply them indiscriminately to content sections.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the supplied logo and recognizable orange accent.",
      "Do label generated scenes and sample interfaces as illustrative.",
      "Do keep visible focus, keyboard selection and reduced-motion behavior.",
      "Do keep real amounts and commercial qualifiers together."
    ],
    "donts": [
      "Don't turn illustrative outlets, orders or scenes into customer proof.",
      "Don't substitute decorative dashboard controls for meaningful interactions.",
      "Don't imply an email draft has delivered an enquiry.",
      "Don't treat the dark operational passage as a dark-mode implementation."
    ]
  }
